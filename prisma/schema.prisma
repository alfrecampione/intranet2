generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model User {
  user_id               String   @id @default(uuid())
  email                 String   @unique
  password              String
  display_name          String?
  confirmationCode      String?
  registrationCompleted Boolean  @default(false)
  createdAt             DateTime @default(now())

  personalInfo  PersonalInfo?
  contactInfo   ContactInfo?
  paymentMethod PaymentMethod?
  documents     Documents?
}

model PersonalInfo {
  id            Int      @id @default(autoincrement())
  userId        String   @unique
  contactType   String
  legalName     String
  preferredName String?
  legalSex      String
  dateOfBirth   DateTime
  ssn           String
  photoPath     String?
  businessName  String?
  companyEIN    String?

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
}

model ContactInfo {
  id                       Int     @id @default(autoincrement())
  userId                   String  @unique
  personalEmail            String
  isPersonalEmailVisible   Boolean @default(false)
  personalPhone            String?
  isPersonalPhoneVisible   Boolean @default(false)
  country                  String
  addressLine1             String
  addressLine2             String?
  city                     String
  state                    String
  zipCode                  String
  workEmail                String?
  workPhone                String?
  preferredContactMethod   String?
  sendMessagePersonalPhone Boolean @default(false)

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
}

model PaymentMethod {
  id              String @id @default(uuid())
  userId          String @unique
  bankAccountType String
  bankAccountNum  String
  bankRoutingNum  String
  accountNickname String

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
}

model Documents {
  id                  String  @id @default(uuid())
  userId              String  @unique
  directDepositForm   String?
  driverLicense       String?
  EINconfirmation     String?
  eANDo               String?
  proLicense          String?
  ffmCertification    String?
  gaLicense           String?
  gaCertification     String?
  sunbiz              String?
  corporationLicense  String?
  taxIdentificationW9 String

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
}

model NecesaryDocuments {
  id                  String  @id @default(uuid())
  email               String  @unique
  directDepositForm   Boolean @default(false)
  driverLicense       Boolean @default(false)
  EINconfirmation     Boolean @default(false)
  eANDo               Boolean @default(false)
  proLicense          Boolean @default(false)
  ffmCertification    Boolean @default(false)
  gaLicense           Boolean @default(false)
  gaCertification     Boolean @default(false)
  sunbiz              Boolean @default(false)
  corporationLicense  Boolean @default(false)
  taxIdentificationW9 Boolean @default(true)
}

model StatesANDCarriers {
  id        String   @id @default(uuid())
  state     String
  companies String[]
}

model NewUserAlerts {
  id         String   @id @default(uuid())
  email      String   @unique
  insertedAt DateTime @default(now())
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  States    String[]
  createdAt DateTime @default(now())
}
