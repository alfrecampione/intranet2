generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["health"]
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@schema("health")
}

model User {
  email                 String?             @unique
  password              String?
  confirmationCode      String?
  user_id               String              @id @default(uuid())
  createdAt             DateTime?           @default(now())
  registrationCompleted Boolean?            @default(false)
  display_name          String?
  isAgent               Boolean?            @default(true)
  isReleased            Boolean?            @default(false)
  Agency                Agency?
  contactInfo           ContactInfo?
  documents             Documents?
  paymentMethod         PaymentMethod?
  personalInfo          PersonalInfo?
  Recommendation        Recommendation?
  statesAndCarriers     StatesANDCarriers[]
  Note                  Note[]

  @@schema("health")
}

model PersonalInfo {
  id            String    @id @default(uuid())
  userId        String    @unique
  businessName  String?
  companyEIN    String?
  contactType   String?
  dateOfBirth   DateTime?
  legalName     String?
  legalSex      String?
  photoPath     String?
  preferredName String?
  ssn           String?
  agency        String?
  franchise     Boolean?
  npn           String?
  user          User      @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model ContactInfo {
  personalEmail String?
  personalPhone String?
  city          String?
  state         String?
  zipCode       String?
  id            String  @id @default(uuid())
  userId        String  @unique
  addressLine1  String?
  addressLine2  String?
  user          User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model PaymentMethod {
  id              String  @id @default(uuid())
  bankAccountType String?
  bankAccountNum  String?
  bankRoutingNum  String?
  accountNickname String?
  userId          String  @unique
  assignToGTI     Boolean @default(true)
  user            User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model Documents {
  id                  String  @id @default(uuid())
  directDepositForm   String?
  driverLicense       String?
  EINconfirmation     String?
  eANDo               String?
  proLicense          String?
  userId              String  @unique
  corporationLicense  String?
  ffmCertification    String?
  gaCertification     String?
  gaLicense           String?
  sunbiz              String?
  taxIdentificationW9 String?
  user                User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model NecesaryDocuments {
  id                  String  @id @default(uuid())
  email               String  @unique
  directDepositForm   Boolean @default(false)
  driverLicense       Boolean @default(false)
  EINconfirmation     Boolean @default(false)
  eANDo               Boolean @default(false)
  proLicense          Boolean @default(false)
  ffmCertification    Boolean @default(false)
  gaLicense           Boolean @default(false)
  gaCertification     Boolean @default(false)
  sunbiz              Boolean @default(false)
  corporationLicense  Boolean @default(false)
  taxIdentificationW9 Boolean @default(true)

  @@schema("health")
}

model StatesANDCarriers {
  id      String  @id @default(uuid())
  state   String?
  userId  String
  company String?
  status  String?
  user    User    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([userId, company, state])
  @@schema("health")
}

model Recommendation {
  id             String   @id @default(uuid())
  userId         String   @unique
  recommendation String?
  isDone         Boolean  @default(false)
  insertedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model NewUserAlerts {
  id           String   @id @default(uuid())
  email        String   @unique
  insertedAt   DateTime @default(now())
  display_name String

  @@schema("health")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  States    String[]
  createdAt DateTime @default(now())
  phone     String

  Commisions Commisions[]

  @@schema("health")
}

model Commisions {
  id        String   @id @default(uuid())
  companyId String
  state     String
  amount    Float
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, state])
  @@schema("health")
}

model Agency {
  id    String @id @default(uuid())
  owner String @unique
  name  String
  user  User   @relation(fields: [owner], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model Logs {
  id       String  @id @default(uuid())
  userId   String
  action   String
  table    String
  oldValue String?
  newValue String?

  createdAt DateTime @default(now())

  @@schema("health")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  text      String
  createdAt DateTime @default(now())
  createdBy String
  isPinned  Boolean  @default(false)

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@schema("health")
}

model Lead {
  id            String   @id @default(uuid())
  isAcepted     Boolean  @default(false)
  fullName      String
  email         String   @unique
  phone         String
  dateOfBirth   DateTime
  npn           String
  address       String
  city          String
  state         String
  zipCode       String
  companyStates String[]
  companyNames  String[]
  createdAt     DateTime @default(now())

  @@schema("health")
}
