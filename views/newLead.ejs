<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lead Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/libs/select2/select2.css" rel="stylesheet">
    <style>
        .form-label.required::after {
            content: " *";
            color: red;
        }

        .company-btn.selected {
            background-color: #0d6efd !important;
            color: #fff;
            border-color: #0d6efd !important;
        }

        .company-btn img {
            max-width: 40px;
            max-height: 40px;
        }
    </style>
</head>

<body class="bg-light">
    <div class="container py-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Lead Information</h4>
            </div>
            <div class="card-body">
                <form id="leadForm">
                    <!-- Full Name -->
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fullName" name="fullName" required
                            value="<%= (lead && lead.fullName) ? lead.fullName : '' %>">
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="email" name="email" required
                            value="<%= (lead && lead.email) ? lead.email : '' %>">
                    </div>

                    <!-- Phone -->
                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" id="phone" name="phone" required
                            value="<%= (lead && lead.phone) ? lead.phone : '' %>">
                    </div>

                    <!-- Date of Birth -->
                    <div class="mb-3">
                        <label for="dateOfBirth" class="form-label">Date of Birth</label>
                        <input type="date" class="form-control" id="dateOfBirth" name="dateOfBirth" required value="<%= (lead && lead.dateOfBirth) 
                ? (lead.dateOfBirth.toISOString 
                    ? lead.dateOfBirth.toISOString().substring(0,10) 
                    : lead.dateOfBirth.substring(0,10)) 
                : '' %>">
                    </div>

                    <!-- NPN -->
                    <div class="mb-3">
                        <label for="npn" class="form-label">NPN</label>
                        <input type="text" class="form-control" id="npn" name="npn" required
                            value="<%= (lead && lead.npn) ? lead.npn : '' %>">
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const npnInput = document.getElementById('npn');
                            if (!npnInput) return;
                            npnInput.addEventListener('input', () => {
                                let digits = npnInput.value.replace(/\D/g, '').slice(0, 8);
                                npnInput.value = digits;
                            });
                            npnInput.addEventListener('keypress', (e) => {
                                if (!/[0-9]/.test(e.key)) {
                                    e.preventDefault();
                                }
                            });
                        });
                    </script>

                    <!-- Address -->
                    <div class="mb-3">
                        <label for="address" class="form-label">Address <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="address" name="address" required
                            value="<%= (lead && lead.address) ? lead.address : '' %>">
                    </div>

                    <!-- City -->
                    <div class="mb-3">
                        <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="city" name="city" required
                            value="<%= (lead && lead.city) ? lead.city : '' %>">
                    </div>

                    <!-- State -->
                    <div class="mb-3">
                        <label for="state" class="form-label">State <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="state" name="state" required
                            value="<%= (lead && lead.state) ? lead.state : '' %>">
                    </div>

                    <!-- Zip Code -->
                    <div class="mb-3">
                        <label for="zipCode" class="form-label">Zip Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="zipCode" name="zipCode" required
                            value="<%= (lead && lead.zipCode) ? lead.zipCode : '' %>">
                    </div>

                    <!-- Licensed States -->
                    <div class="mb-3">
                        <label for="companyStates" class="form-label">Carrier States<span
                                class="text-danger">*</span></label>
                        <select class="form-select" id="companyStates" name="companyStates" multiple required
                            style="width: 100%">
                        </select>
                    </div>

                    <!-- Carrier Names -->
                    <div class="mb-3">
                        <label class="form-label">Carrier Names <span class="text-danger">*</span></label>
                        <div id="companyButtons" class="d-flex flex-wrap gap-2"></div>
                        <!-- Hidden input to hold selected companies -->
                        <input type="hidden" id="companyNames" name="companyNames" value="">
                    </div>

                    <% if (!isLoaded) { %>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                        <% } %>
                </form>
            </div>
        </div>
    </div>

    <script src="/vendor/libs/jquery/jquery.js"></script>
    <script src="/vendor/libs/select2/select2.js"></script>
    <script src="/vendor/js/bootstrap.js"></script>

    <script id="carriers-data" type="application/json">
        <%- JSON.stringify(companies) %>
    </script>

    <script id="lead-data" type="application/json">
        <%- JSON.stringify(lead) %>
    </script>

    <script>
        // Data passed from server
        const companies = JSON.parse(document.getElementById('carriers-data').textContent || '[]') || [];
        const lead = JSON.parse(document.getElementById('lead-data').textContent || '{}') || {};

        // Create company icon lookup map from companies data
        const companyIconMap = {};
        companies.forEach(company => {
            if (company.iconPath) {
                companyIconMap[company.name] = company.iconPath;
            }
        });

        // Populate square buttons instead of select
        const companyContainer = document.getElementById("companyButtons");
        const hiddenInput = document.getElementById("companyNames");
        const selectedCompanies = Array.isArray(lead.companyNames) ? lead.companyNames : [];

        function updateHiddenInput() {
            const selected = [...companyContainer.querySelectorAll(".company-btn.selected")]
                .map(btn => btn.dataset.name);
            hiddenInput.value = JSON.stringify(selected);
        }

        companies.forEach(company => {
            const key = company.name;
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "company-btn btn btn-outline-primary d-flex flex-column align-items-center justify-content-center";
            btn.style.width = "100px";
            btn.style.height = "100px";
            btn.style.borderRadius = "8px";

            // Add company logo if available
            if (companyIconMap[company.name]) {
                const img = document.createElement("img");
                img.src = companyIconMap[company.name];
                img.alt = company.name;
                img.style.maxWidth = "40px";
                img.style.maxHeight = "40px";
                img.className = "mb-2";
                btn.appendChild(img);
            }

            // Add company name label
            const span = document.createElement("span");
            span.textContent = company.name;
            span.style.fontSize = "0.75rem";
            span.style.textAlign = "center";

            btn.appendChild(span);

            btn.dataset.name = company.name;

            // Mark as selected if in lead
            if (selectedCompanies.includes(company.name)) {
                btn.classList.add("selected", "btn-primary");
                btn.classList.remove("btn-outline-primary");
            }

            btn.addEventListener("click", () => {
                btn.classList.toggle("selected");
                btn.classList.toggle("btn-primary");
                btn.classList.toggle("btn-outline-primary");
                updateHiddenInput();
            });

            companyContainer.appendChild(btn);
        });

        // Initialize hidden input
        updateHiddenInput();
    </script>

    <script>
        // US states array
        const US_STATES = [
            { name: "Alabama", abbr: "AL" }, { name: "Alaska", abbr: "AK" }, { name: "Arizona", abbr: "AZ" },
            { name: "Arkansas", abbr: "AR" }, { name: "California", abbr: "CA" }, { name: "Colorado", abbr: "CO" },
            { name: "Connecticut", abbr: "CT" }, { name: "Delaware", abbr: "DE" }, { name: "Florida", abbr: "FL" },
            { name: "Georgia", abbr: "GA" }, { name: "Hawaii", abbr: "HI" }, { name: "Idaho", abbr: "ID" },
            { name: "Illinois", abbr: "IL" }, { name: "Indiana", abbr: "IN" }, { name: "Iowa", abbr: "IA" },
            { name: "Kansas", abbr: "KS" }, { name: "Kentucky", abbr: "KY" }, { name: "Louisiana", abbr: "LA" },
            { name: "Maine", abbr: "ME" }, { name: "Maryland", abbr: "MD" }, { name: "Massachusetts", abbr: "MA" },
            { name: "Michigan", abbr: "MI" }, { name: "Minnesota", abbr: "MN" }, { name: "Mississippi", abbr: "MS" },
            { name: "Missouri", abbr: "MO" }, { name: "Montana", abbr: "MT" }, { name: "Nebraska", abbr: "NE" },
            { name: "Nevada", abbr: "NV" }, { name: "New Hampshire", abbr: "NH" }, { name: "New Jersey", abbr: "NJ" },
            { name: "New Mexico", abbr: "NM" }, { name: "New York", abbr: "NY" }, { name: "North Carolina", abbr: "NC" },
            { name: "North Dakota", abbr: "ND" }, { name: "Ohio", abbr: "OH" }, { name: "Oklahoma", abbr: "OK" },
            { name: "Oregon", abbr: "OR" }, { name: "Pennsylvania", abbr: "PA" }, { name: "Rhode Island", abbr: "RI" },
            { name: "South Carolina", abbr: "SC" }, { name: "South Dakota", abbr: "SD" }, { name: "Tennessee", abbr: "TN" },
            { name: "Texas", abbr: "TX" }, { name: "Utah", abbr: "UT" }, { name: "Vermont", abbr: "VT" },
            { name: "Virginia", abbr: "VA" }, { name: "Washington", abbr: "WA" }, { name: "West Virginia", abbr: "WV" },
            { name: "Wisconsin", abbr: "WI" }, { name: "Wyoming", abbr: "WY" }
        ];

        // Populate states select
        const stateSelect = document.getElementById('companyStates');
        const selectedStates = Array.isArray(lead.companyStates) ? lead.companyStates : [];
        US_STATES.forEach(state => {
            const option = document.createElement('option');
            option.value = state.abbr;
            option.textContent = state.name;
            if (selectedStates.includes(state.abbr)) {
                option.selected = true;
            }
            stateSelect.appendChild(option);
        });
        $(stateSelect).select2({
            placeholder: "Select licensed states",
            width: '100%'
        });
    </script>


    <script>
        document.getElementById('leadForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = {
                fullName: document.getElementById('fullName').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                dateOfBirth: document.getElementById('dateOfBirth').value,
                npn: document.getElementById('npn').value,
                address: document.getElementById('address').value,
                city: document.getElementById('city').value,
                state: document.getElementById('state').value,
                zipCode: document.getElementById('zipCode').value,
                companyStates: Array.from(document.getElementById('companyStates').selectedOptions).map(opt => opt.value),
                companyNames: JSON.parse(document.getElementById('companyNames').value || '[]')
            };

            try {
                const response = await fetch('/users/lead-center', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                if (!response.ok) throw new Error('Failed to submit');

                const result = await response.json();
                // Replace form with success message
                const form = document.getElementById('leadForm');
                const parent = form.parentElement;
                form.remove();
                const msg = document.createElement('div');
                msg.className = 'alert alert-success text-center mt-4';
                msg.innerHTML = `
            <h4 class="mb-3">Lead added successfully!</h4>
            <p class="mb-0">You can close this page now.</p>
        `;
                parent.appendChild(msg);
            } catch (error) {
                console.error(error);
                alert('Error adding lead.');
            }
        });
    </script>

    <script>
        // Initialize Select2 for companies
        $(document).ready(function () {
            $('#companyNames').select2({
                width: '100%'
            });
        });
    </script>
</body>

</html>