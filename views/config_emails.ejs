        <script>
            function renderTable(users, page, pageSize, searchTerm = "") {
                const table = document.querySelector(".datatables-basic");
                const tbody = table.querySelector("tbody");
                tbody.innerHTML = "";

                const filtered = users.filter(u =>
                    (u.email || "").toLowerCase().includes(searchTerm.toLowerCase())
                );

                const start = (page - 1) * pageSize;
                const end = start + pageSize;
                const pageUsers = filtered.slice(start, end);

                if (pageUsers.length === 0) {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `<td colspan="3" class="dataTables_empty text-center">No emails found.</td>`;
                    tbody.appendChild(tr);
                } else {
                    pageUsers.forEach((user) => {
                        const tr = document.createElement("tr");

                        const tdEmail = document.createElement("td");
                        tdEmail.textContent = user.email || "";
                        tr.appendChild(tdEmail);

                        const tdCreated = document.createElement("td");
                        tdCreated.textContent = user.insertedAt
                            ? new Date(user.insertedAt).toLocaleDateString()
                            : "";
                        tr.appendChild(tdCreated);

                        const tdAction = document.createElement("td");
                        tdAction.innerHTML = `<button class="btn btn-danger btn-sm delete-email-btn" data-email="${user.email}">Delete</button>`;
                        tr.appendChild(tdAction);

                        tbody.appendChild(tr);
                    });
                }

                const info = document.getElementById("DataTables_Table_0_info");
                const showingStart = filtered.length === 0 ? 0 : start + 1;
                const showingEnd = Math.min(end, filtered.length);
                info.textContent = `Showing ${showingStart} to ${showingEnd} of ${filtered.length} entries`;

                renderPagination(filtered.length, page, pageSize);
            }


            function renderPagination(total, page, pageSize) {
                const ul = document.querySelector("#DataTables_Table_0_paginate ul.pagination");
                ul.innerHTML = "";

                const totalPages = Math.ceil(total / pageSize);

                // Prev
                const prevLi = document.createElement("li");
                prevLi.className = `paginate_button page-item previous${page === 1 ? " disabled" : ""}`;
                prevLi.innerHTML = `<a class="page-link" href="#" tabindex="-1"><i class="ti ti-chevron-left ti-sm"></i></a>`;
                prevLi.onclick = (e) => {
                    e.preventDefault();
                    if (page > 1) setPage(page - 1);
                };
                ul.appendChild(prevLi);

                // Números de página (máximo 5)
                let startPage = Math.max(1, page - 2);
                let endPage = Math.min(totalPages, startPage + 4);
                if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement("li");
                    li.className = `paginate_button page-item${i === page ? " active" : ""}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.onclick = (e) => {
                        e.preventDefault();
                        setPage(i);
                    };
                    ul.appendChild(li);
                }

                // Next
                const nextLi = document.createElement("li");
                nextLi.className = `paginate_button page-item next${page === totalPages || totalPages === 0 ? " disabled" : ""}`;
                nextLi.innerHTML = `<a class="page-link" href="#"><i class="ti ti-chevron-right ti-sm"></i></a>`;
                nextLi.onclick = (e) => {
                    e.preventDefault();
                    if (page < totalPages) setPage(page + 1);
                };
                ul.appendChild(nextLi);
            }

            // Estado global de paginado y búsqueda
            let users = [];
            let currentPage = 1;
            let pageSize = 7;
            let searchTerm = "";

            function setPage(page) {
                currentPage = page;
                renderTable(users, currentPage, pageSize, searchTerm);
            }

            function setPageSize(size) {
                pageSize = size;
                currentPage = 1;
                renderTable(users, currentPage, pageSize, searchTerm);
            }

            function setSearch(term) {
                searchTerm = term;
                currentPage = 1;
                renderTable(users, currentPage, pageSize, searchTerm);
            }

            document.addEventListener("DOMContentLoaded", () => {
                users = JSON.parse(document.getElementById("users-data").textContent);

                // Inicializar tabla
                renderTable(users, currentPage, pageSize);

                // Selector de cantidad
                document.querySelector('select[name="DataTables_Table_0_length"]').addEventListener("change", function () {
                    setPageSize(Number(this.value));
                });

                // Barra de búsqueda
                document.querySelector('#DataTables_Table_0_filter input[type="search"]').addEventListener("input", function () {
                    setSearch(this.value);
                });
            });
        </script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.getElementById("addEmailBtn").addEventListener("click", async function () {
                    const select = document.getElementById("emailDropdown");
                    const email = select.value;

                    if (!email) {
                        alert("Please select an email.");
                        return;
                    }

                    try {
                        const response = await fetch(`${url}/users/config_emails`, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ email })
                        });

                        if (!response.ok) {
                            throw new Error("Error adding email");
                        }

                        // Opcional: cerrar el offcanvas y recargar la página o actualizar la tabla
                        location.reload();
                    } catch (err) {
                        alert("Error adding email: " + err.message);
                    }
                });

                document.querySelectorAll(".delete-email-btn").forEach(function (btn) {
                    btn.addEventListener("click", async function () {
                        const email = this.getAttribute("data-email");
                        if (!email) return;

                        if (!confirm("Are you sure you want to delete this email?")) return;

                        try {
                            const response = await fetch(`${url}/users/config_emails`, {
                                method: "DELETE",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ email })
                            });

                            if (!response.ok) {
                                throw new Error("Error deleting email");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error deleting email: " + err.message);
                        }
                    });
                });
            });
        </script>
</body>

</html>