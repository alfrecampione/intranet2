                        <div class="card-title mb-0">
                          <h5 class="m-0 me-2">Carriers This Month</h5>
                          <small class="text-muted">New Business</small>
                        </div>
                        <div>
                          <h6 class="pt-2">
                            <b>
                              <%= cm_nb_prem %>
                                /
                                <%= cm_nb_pol %>
                            </b>
                          </h6>
                        </div>
                      </div>
                      <div class="card-body">
                        <ul class="p-0 m-0">
                          <% dashboard_company.forEach(element=> { %>
                            <li class="d-flex align-items-center mb-4">
                              <div class="avatar flex-shrink-0 me-3">
                                <% if(element.avatar) {%>
                                  <img src="/img/avatars/comp/<%=element.avatar%>" alt class="h-auto rounded-circle" />
                                  <%}else{%>
                                    <%-element.output%>
                                      <%}%>
                              </div>
                              <div class="d-flex w-100 align-items-center justify-content-between gap-2">
                                <div class="me-2">
                                  <div class="d-flex align-items-center">
                                    <h6 class="mb-0 me-1">
                                      <%= element.premium %> / <%= element.policies %>
                                    </h6>
                                  </div>
                                  <small class="text-muted">
                                    <%= element.company %>
                                  </small>
                                </div>
                                <div class="user-progress">
                                  <% if(element.percent){ if(element.percent>= 0)
                                    {%>
                                    <p class="text-success fw-medium mb-0 d-flex justify-content-center gap-1">
                                      <i class="ti ti-chevron-up"></i>
                                      <%= element.percent %>%
                                    </p>
                                    <%} else { element.percent=element.percent*(-1)%>
                                      <p class="text-danger fw-medium mb-0 d-flex justify-content-center gap-1">
                                        <i class="ti ti-chevron-down"></i>
                                        <%= element.percent %>%
                                      </p>
                                      <% }} else { %>
                                        <p class="text-warning fw-medium mb-0 d-flex justify-content-center gap-1">
                                          <i class="ti"></i>
                                          NRLM
                                        </p>
                                        <% } %>
                                </div>
                              </div>
                            </li>
                            <% }) %>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <!--/ Sales By Companies -->
                </div>
              </div>
              <!-- / Content -->

              <!-- Franchises Best Seller Modal-->
              <div class="modal fade" id="firstCsr" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-simple modal-enable-otp modal-dialog-centered">
                  <div class="modal-content p-3 p-md-5">
                    <div class="modal-body">
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      <div class="text-center mb-4">
                        <h3 class="mb-3">Top 5 Carriers</h3>
                        <p class="text-muted">
                          <%=franchises_best_last_week.csr%>'s Sales
                        </p>
                      </div>
                      <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <ul class="p-0 m-0">
                          <% franchises_best_last_week.carriers.forEach(element=>
                            {%>
                            <li class="d-flex align-items-center mb-4">
                              <div class="avatar flex-shrink-0 me-3">
                                <img src="/img/avatars/comp/<%=element.id_company%>.png" alt="Carrier"
