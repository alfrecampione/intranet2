<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      <%- include('partials/sidebar', { user: user, activePage: activePage }) %>
        <!-- / Menu -->
        <!-- Layout container -->
        <div class="layout-page">
          <!-- Navbar -->
          <%- include('partials/navbar', {user: user}) %>
            <!-- / Navbar -->
            <!-- Content wrapper -->
            <div class="content-wrapper">
              <!-- Content -->

              <div class="container-xxl flex-grow-1 container-p-y">
                <div class="row">
                  <!-- Policies/Premium Corporate/Company -->
                  <div class="row mt-4 mb-3">
                    <!-- Agency Today -->
                    <div class="col-sm-6 col-lg-3 mb-2">
                      <p class="mb-0 text-primary">
                        <%=agency%> - Today
                      </p>
                      <div class="card card-border-shadow-primary mb-0">
                        <div class="card-body pt-1">
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-user-dollar ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ld_nb_prem %> / <%= ld_nb_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-repeat ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0 mt-0">
                              <%= ld_rn_prem %> / <%= ld_rn_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-writing ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ld_rw_prem %> / <%= ld_rw_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-moneybag ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ld_tot_prem %> / <%= ld_tot_pol %>
                            </h5>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!--/ Agency Today -->

                    <!-- Company Today -->
                    <div class="col-sm-6 col-lg-3 mb-2">
                      <p class="mb-0 text-primary">Company - Today</p>
                      <div class="card card-border-shadow-primary">
                        <div class="card-body pt-1">
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-user-dollar ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ct_nb_prem %> / <%= ct_nb_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-repeat ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0 mt-0">
                              <%= ct_rn_prem %> / <%= ct_rn_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-writing ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ct_rw_prem %> / <%= ct_rw_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-moneybag ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= ct_tot_prem %> / <%= ct_tot_pol %>
                            </h5>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!--/ Company Today -->

                    <!-- Agency this month -->
                    <div class="col-sm-6 col-lg-3 mb-2">
                      <p class="mb-0 text-primary">
                        <%=agency%> - This Month
                      </p>
                      <div class="card card-border-shadow-primary">
                        <div class="card-body pt-1">
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-user-dollar ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= lm_nb_prem %> / <%= lm_nb_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-repeat ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0 mt-0">
                              <%= lm_rn_prem %> / <%= lm_rn_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-writing ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= lm_rw_prem %> / <%= lm_rw_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-moneybag ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= lm_tot_prem %> / <%= lm_tot_pol %>
                            </h5>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!--/ Agency this month -->

                    <!-- Company this month -->
                    <div class="col-sm-6 col-lg-3 mb-2">
                      <p class="mb-0 text-primary">Company - This Month</p>
                      <div class="card card-border-shadow-primary">
                        <div class="card-body pt-1">
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-user-dollar ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= cm_nb_prem %> / <%= cm_nb_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-repeat ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0 mt-0">
                              <%= cm_rn_prem %> / <%= cm_rn_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-writing ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= cm_rw_prem %> / <%= cm_rw_pol %>
                            </h5>
                          </div>
                          <div class="d-flex align-items-center">
                            <div class="avatar me-2">
                              <span class="avatar-initial rounded bg-label-primary"><i
                                  class="ti ti-moneybag ti-sm"></i></span>
                            </div>
                            <h5 class="ms-1 mb-0">
                              <%= cm_tot_prem %> / <%= cm_tot_pol %>
                            </h5>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!--/ Company this month -->
                  </div>
                  <!--/ Policies/Premium Corporate/Company -->

                  <!-- View sales First -->
                  <div class="col-xl-4 mb-4 col-lg-5 col-12">
                    <div class="card">
                      <div class="d-flex align-items-end row">
                        <div class="col-7">
                          <div class="card-body text-nowrap">
                            <h5 class="card-title mb-0">
                              Congratulations <%= franchises_best_last_week.name%>! 🎉
                            </h5>
                            <p class="mb-0">
                              <%= franchises_best_last_week.location%>
                            </p>
                            <p class="mb-2">1st Place P&C Sales Last Week</p>
                            <h4 class="text-primary mb-1">
                              <%= franchises_best_last_week.premium %> / <%= franchises_best_last_week.policies %>
                            </h4>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                              data-bs-target="#firstCsr">
                              By Carriers
                            </button>
                          </div>
                        </div>
                        <div class="col-5 text-center text-sm-left">
                          <div class="card-body pb-0 px-0 px-md-4">
                            <img src="/img/illustrations/users/<%=franchises_best_last_week.id_user%>.png" height="140"
                              alt="First CSR" />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- View sales -->

                  <!-- View sales Second-->
                  <div class="col-xl-4 mb-4 col-lg-5 col-12">
                    <div class="card">
                      <div class="d-flex align-items-end row">
                        <div class="col-7">
                          <div class="card-body text-nowrap">
                            <h5 class="card-title mb-0">
                              Congratulations <%= franchises_second_last_week.name%>! 🎉
                            </h5>
                            <p class="mb-0">
                              <%= franchises_second_last_week.location%>
                            </p>
                            <p class="mb-2">2nd Place P&C Sales Last Week</p>
                            <h4 class="text-primary mb-1">
                              <%= franchises_second_last_week.premium %> / <%= franchises_second_last_week.policies %>
                            </h4>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                              data-bs-target="#secondCsr">
                              By Carriers
                            </button>
                          </div>
                        </div>
                        <div class="col-5 text-center text-sm-left">
                          <div class="card-body pb-0 px-0 px-md-4">
                            <img src="/img/illustrations/users/<%=franchises_second_last_week.id_user%>.png"
                              height="140" alt="Second CSR" />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- View sales -->

                  <!-- View sales Third -->
                  <div class="col-xl-4 mb-4 col-lg-5 col-12">
                    <div class="card">
                      <div class="d-flex align-items-end row">
                        <div class="col-7">
                          <div class="card-body text-nowrap">
                            <h5 class="card-title mb-0">
                              Congratulations <%= franchises_third_last_week.name%>! 🎉
                            </h5>
                            <p class="mb-0">
                              <%= franchises_third_last_week.location%>
                            </p>
                            <p class="mb-2">3rd Place P&C Sales Last Week</p>
                            <h4 class="text-primary mb-1">
                              <%= franchises_third_last_week.premium %> / <%= franchises_third_last_week.policies %>
                            </h4>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                              data-bs-target="#thirdCsr">
                              By Carriers
                            </button>
                          </div>
                        </div>
                        <div class="col-5 text-center text-sm-left">
                          <div class="card-body pb-0 px-0 px-md-4">
                            <img src="/img/illustrations/users/<%=franchises_third_last_week.id_user%>.png" height="140"
                              alt="Third CSR" />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- View sales -->

                  <!-- Agencies Dayly -->
                  <div class="col-xl-4 col-md-6 mb-4">
                    <div class="card h-100">
                      <div class="card-header d-flex justify-content-between">
                        <div class="card-title mb-0">
                          <h5 class="m-0 me-2">Agencies Today</h5>
                          <small class="text-muted">New Business</small>
                        </div>
                        <div>
                          <h6 class="pt-2">
                            <b>
                              <%= ct_nb_prem %>
                                /
                                <%= ct_nb_pol %>
                            </b>
                          </h6>
                        </div>
                      </div>
                      <div class="card-body">
                        <ul class="p-0 m-0">
                          <% agencies_today.forEach(element=> { %>
                            <li class="d-flex align-items-center mb-4">
                              <div class="avatar flex-shrink-0 me-3">
                                <img src="/img/avatars/agencies/<%=element.idl%>.png" alt
                                  class="h-auto rounded-circle" />
                              </div>
                              <div class="d-flex w-100 align-items-center justify-content-between gap-2">
                                <div class="me-2">
                                  <div class="d-flex align-items-center">
                                    <h6 class="mb-0 me-1">
                                      <%= element.location %>
                                    </h6>
                                  </div>
                                </div>
                                <div>
                                  <h6 class="mb-0 me-1">
                                    <%= element.premium %> / <%= element.policies %>
                                  </h6>
                                </div>
                              </div>
                            </li>
                            <% }) %>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <!--/Agencies Dayly-->

                  <!-- Sales By Agencies -->
                  <div class="col-xl-4 col-md-6 mb-4">
                    <div class="card h-100">
                      <div class="card-header d-flex justify-content-between">
                        <div class="card-title mb-0">
                          <h5 class="m-0 me-2">Agencies This Month</h5>
                          <small class="text-muted">New Business</small>
                        </div>
                        <div>
                          <h6 class="pt-2">
                            <b>
                              <%= cm_nb_prem %>
                                /
                                <%= cm_nb_pol %>
                            </b>
                          </h6>
                        </div>
                      </div>
                      <div class="card-body">
                        <ul class="p-0 m-0">
                          <% dashboard_location.forEach(element=> { %>
                            <li class="d-flex align-items-center mb-4">
                              <div class="avatar flex-shrink-0 me-3">
                                <% if(element.avatar) {%>
                                  <img src="/img/avatars/agencies/<%=element.avatar%>" alt
                                    class="h-auto rounded-circle" />
                                  <%}else{%>
                                    <%-element.output%>
                                      <%}%>
                              </div>
                              <div class="d-flex w-100 align-items-center justify-content-between gap-2">
                                <div class="me-2">
                                  <div class="d-flex align-items-center">
                                    <h6 class="mb-0 me-1">
                                      <%= element.premium %> / <%= element.policies %>
                                    </h6>
                                  </div>
                                  <small class="text-muted">
                                    <%= element.location %>
                                  </small>
                                </div>
                                <div class="user-progress">
                                  <% if(element.percent){ if(element.percent>= 0)
                                    {%>
                                    <p class="text-success fw-medium mb-0 d-flex justify-content-center gap-1">
                                      <i class="ti ti-chevron-up"></i>
                                      <%= element.percent %>%
                                    </p>
                                    <%} else { element.percent=element.percent*(-1)%>
                                      <p class="text-danger fw-medium mb-0 d-flex justify-content-center gap-1">
                                        <i class="ti ti-chevron-down"></i>
                                        <%= element.percent %>%
                                      </p>
                                      <% }} else { %>
                                        <p class="text-warning fw-medium mb-0 d-flex justify-content-center gap-1">
                                          <i class="ti"></i>
                                          NRLM
                                        </p>
                                        <% } %>
                                </div>
                              </div>
                            </li>
                            <% }) %>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <!--/ Sales By Agencies -->

                  <!-- Sales By Companies -->
