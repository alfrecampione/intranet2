  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const fileInputs = document.querySelectorAll("input[type='file']");

      function updateStatusVisual(input) {
        const parent = input.closest(".d-flex");
        const fileUploaded = input.files.length > 0;
        const hasExistingLink = parent.querySelector("a[href]:not([href=''])");

        if (fileUploaded || hasExistingLink) {
          parent.classList.add("border-success");
          parent.classList.remove("border-danger");
          if (!parent.querySelector(".check-icon")) {
            const check = document.createElement("i");
            check.className = "ti ti-check text-success ms-2 check-icon";
            parent.querySelector("span").appendChild(check);
          }
        } else {
          parent.classList.remove("border-success");
          parent.classList.add("border-danger");
          const check = parent.querySelector(".check-icon");
          if (check) check.remove();
        }
      }

      fileInputs.forEach(input => {
        updateStatusVisual(input);
        input.addEventListener("change", function () {
          updateStatusVisual(this);
        });
      });
    });
  </script>
