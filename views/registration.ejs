  <script>
    function showToast(headerText, bodyText) {
      const toast = document.querySelector('.toast-ex1');
      toast.querySelector('.toast-header small').textContent = headerText;
      toast.querySelector('.toast-body').textContent = bodyText;
      const bsToast = new bootstrap.Toast(toast);
      bsToast.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
      const contactType = document.getElementById("contactType");
      const businessNameGroup = document.getElementById("businessNameGroup");
      const einGroup = document.getElementById("einGroup");
      const businessName = document.getElementById("businessName");
      const ein = document.getElementById("ein");
      const prefFirstName = document.getElementById("preferredFirstName");

      function toggleBusinessFields() {
        if (contactType.value === "business") {
          businessNameGroup.style.display = "";
          einGroup.style.display = "";
          businessName.required = true;
          ein.required = true;
          prefFirstName.style.display = "none";
        } else {
          businessNameGroup.style.display = "none";
          einGroup.style.display = "none";
          businessName.required = false;
          ein.required = false;
          businessName.classList.remove("is-invalid");
          ein.classList.remove("is-invalid");
        }
      }

      contactType.addEventListener("change", toggleBusinessFields);
      toggleBusinessFields();
      document.querySelector(".btn-next").addEventListener("click", function (e) {
        if (contactType.value === "business") {
          let valid = true;
          if (!businessName.value.trim()) {
            businessName.classList.add("is-invalid");
            valid = false;
          } else {
            businessName.classList.remove("is-invalid");
          }
          if (!ein.value.trim()) {
            ein.classList.add("is-invalid");
            valid = false;
          } else {
            ein.classList.remove("is-invalid");
          }
          if (!valid) {
            e.preventDefault();
            showToast("Error", "Business Name and EIN are required for Business type.");
          }
        }
      });
    });
  </script>


  <!-- Push the info -->
  <script>
    // Variable global para almacenar el userId (deberías obtenerlo de tu sistema de autenticación)
    const currentUserId = "<%= userId %>";
    const isEdit = "<%= isEdit %>";

    const uploadFile = async (file) => {
      if (file) {
        try {
          const formData = new FormData();
          formData.append("file", file);

          const uploadResponse = await fetch(`${url}/upload`, {
            method: "POST",
            body: formData,
          });

          if (uploadResponse.ok) {
            const { path } = await uploadResponse.json();
            return path;
          }
        } catch (error) {
          console.error("Error uploading file:", error);
        }
      }
      return null;
    };


    async function savePersonalInfo() {
      const contactType = document.getElementById("contactType")?.value || "";
      const legalName = document.getElementById("legalName")?.value || "";
      const preferredFirstName = document.getElementById("preferredFirstName")?.value || "";
      const dateOfBirth = document.getElementById("dateOfBirth")?.value || "";
      const ssn = document.getElementById("ssn")?.value || "";
      const photoInput = document.getElementById("profilePhotoInput");

      const businessName = document.getElementById("businessName")?.value || "";
      const companyEIN = document.getElementById("ein")?.value || "";

      const photoFile = photoInput?.files[0] || null;
      const existingPhotoURL = photoInput?.dataset.existingUrl || "";

      const isMale = document.getElementById("legalSexMale")?.checked;
      const legalSex = isMale ? "male" : "female";

      let uploadedPhoto = existingPhotoURL;

      if (photoFile) {
        uploadedPhoto = await uploadFile(photoFile);
      }

      const personalInfo = {
        contactType: contactType,
        legalName: legalName,
        preferredName: preferredFirstName,
        dateOfBirth: dateOfBirth,
        ssn: ssn,
        legalSex: legalSex,
        userId: currentUserId,
        photoPath: uploadedPhoto,
        businessName: businessName || null,
        companyEIN: companyEIN || null
      };

      const response = await fetch(`${url}/steps/personal-info`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(personalInfo)
      });

      if (!response.ok) throw new Error("Error uploading personal info");
      return await response.json();
    }

    async function saveContactInfo() {
      const personalEmail = document.getElementById("personalEmail")?.value || "";
      const personalPhone = document.getElementById("personalPhone")?.value || "";
      const country = document.getElementById("country")?.value || "";
      const addressLine1 = document.getElementById("addressLine1")?.value || "";
      const addressLine2 = document.getElementById("addressLine2")?.value || "";
      const city = document.getElementById("city")?.value || "";
      const state = document.getElementById("state")?.value || "";
      const zipCode = document.getElementById("zipCode")?.value || "";
      const workEmail = document.getElementById("workEmail")?.value || "";
      const workPhone = document.getElementById("workPhone")?.value || "";
      const preferredContact = document.getElementById("preferredContact")?.value || "";

      const contactInfo = {
        personalEmail: personalEmail,
        personalPhone: personalPhone,
        country: country,
        addressLine1: addressLine1,
        addressLine2: addressLine2 || null,
        city: city,
        state: state,
        zipCode: zipCode,
        workEmail: workEmail || null,
        workPhone: workPhone || null,
        preferredContactMethod: preferredContact || null,
        userId: currentUserId
      };
      const contactInfoJSON = JSON.stringify(contactInfo)

      const response = await fetch(`${url}/steps/contact-info`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: contactInfoJSON
      });

      if (!response.ok) throw new Error("Error uploading contact info");
      return await response.json();
    }

    async function savePaymentMethods() {
      const bankAccounts = [];
      const accountEntries = document.querySelectorAll("#bankAccountsContainer .bank-account-entry");

      accountEntries.forEach((entry) => {
        if (entry.style.display === "none") return;

        const bankAccountType = entry.querySelector('input[type="radio"][name$="[bankAccountType]"]:checked')?.value || "";

        const bankAccountNum = entry.querySelector('input[name$="[accountNumber]"]')?.value || "";

        const confirmAccountNum = entry.querySelector('input[name$="[confirmAccountNumber]"]')?.value || "";

        const bankRoutingNum = entry.querySelector('input[name$="[routingNumber]"]')?.value || "";

        const accountNickname = entry.querySelector('input[name$="[accountNickname]"]')?.value || "";

        if (bankAccountType || bankAccountNum || bankRoutingNum) {
          bankAccounts.push({
            bankAccountType,
            bankAccountNum,
            bankRoutingNum,
            accountNickname,
            userId: currentUserId
          });
        }
      });

      if (bankAccounts.length === 0) return [];

      const bankAccountsJSON = JSON.stringify(bankAccounts)

      const response = await fetch(`${url}/steps/payment-method`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: bankAccountsJSON
      });

      if (!response.ok) throw new Error("Error guardando métodos de pago");
      return await response.json();
    }

    async function saveDocuments() {
      const fileIds = {
        directDepositForm: "directDepositUpload",
        driverLicense: "driversLicenseUpload",
        EINconfirmation: "einConfirmationUpload",
        eANDo: "eoUpload",
        proLicense: "professionalLicenseUpload",
        taxIdentificationW9: "taxIdentificationW9Upload",
        ffmCertification: "ffmCertificationUpload",
        gaLicense: "gaLicenseUpload",
        gaCertification: "gaCertificationUpload",
        sunbiz: "sunbizUpload",
        corporationLicense: "corporationLicenseUpload"
      };

      const payload = { userId: currentUserId };

      const validInputs = [];
      for (const [key, inputId] of Object.entries(fileIds)) {
        const input = document.getElementById(inputId);
        if (input !== null) {
          validInputs.push({ key, input });
        }
      }

      for (const { input } of validInputs) {
        const parent = input.closest(".d-flex");
        if (parent && parent.classList.contains("border-danger")) {
          throw new Error("Please upload all required documents before submitting.");
        }
      }

      for (const { key, input } of validInputs) {
        const file = input?.files?.[0];
        const parent = input.closest(".d-flex");
        const existingLink = parent.querySelector("a[href]:not([href=''])");
        payload[key] = file ? await uploadFile(file) : existingLink?.getAttribute("href") || null;
      }

      const overlay = document.getElementById("email-overlay");
      overlay.style.display = "flex";

      const response = await fetch(`${url}/steps/documents`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      overlay.style.display = "none";

      if (!response.ok) throw new Error("Error uploading documents");
      return await response.json();
    }


    document.querySelector(".btn-submit").addEventListener("click", async function (e) {
      e.preventDefault();
      try {

        if (currentUserId === null) throw new Error("Se requiere ID de usuario");

        await savePersonalInfo();
        await saveContactInfo();
        await savePaymentMethods()
        await saveDocuments();

        if (isEdit == "false")
          window.location.href = `${url}/users/dashboard`;
        else
          window.location.href = `${url}/users/agents`;

      } catch (error) {
        showToast("Error", error.message || "An unexpected error occurred. Please try again later.");
      }
    });
  </script>

