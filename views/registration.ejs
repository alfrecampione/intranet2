<!doctype html>

<html lang="en" class="light-style layout-wide customizer-hide" dir="ltr" data-theme="theme-default"
  data-assets-path="/" data-template="vertical-menu-template" data-style="light">

<head>
  <script>
    const url = `${window.location.protocol}//${window.location.host}`;
  </script>
  <meta charset="utf-8" />
  <meta name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

  <title>Registration | GoldenHealth</title>

  <meta name="description" content="" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/img/favicon/favicon.ico" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&ampdisplay=swap"
    rel="stylesheet" />

  <!-- Icons -->
  <link rel="stylesheet" href="/vendor/fonts/fontawesome.css" />
  <link rel="stylesheet" href="/vendor/fonts/tabler-icons.css" />
  <link rel="stylesheet" href="/vendor/fonts/flag-icons.css" />

  <!-- Core CSS -->

  <link rel="stylesheet" href="/vendor/css/rtl/core.css" class="template-customizer-core-css" />
  <link rel="stylesheet" href="/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" />

  <link rel="stylesheet" href="/css/demo.css" />

  <!-- Vendors CSS -->
  <link rel="stylesheet" href="/vendor/libs/node-waves/node-waves.css" />

  <link rel="stylesheet" href="/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="/vendor/libs/typeahead-js/typeahead.css" />
  <!-- Vendor -->
  <link rel="stylesheet" href="/vendor/libs/bs-stepper/bs-stepper.css" />
  <link rel="stylesheet" href="/vendor/libs/bootstrap-select/bootstrap-select.css" />
  <link rel="stylesheet" href="/vendor/libs/@form-validation/form-validation.css" />

  <!-- Page CSS -->

  <!-- Page -->
  <link rel="stylesheet" href="/vendor/css/pages/page-auth.css" />

  <!--? !!!!!!!!!!!!!!!!!!Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->
  <script src="/js/config.js"></script>


  <style>
    .bs-stepper-content .content {
      min-height: 600px;
      box-sizing: border-box;
    }

    .bs-stepper-content .content.active {
      display: block;
    }

    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #ff3e1d !important;
    }
  </style>
  <style>
    .invalid-feedback {
      display: none;
      width: 100%;
      margin-top: 0.25rem;
      font-size: 0.875em;
      color: #ff3e1d;
    }

    .is-invalid~.invalid-feedback {
      display: block;
    }
  </style>

  <style>
    .content {
      position: relative;
    }

    .content .sticky-bottom {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      width: 100%;
    }
  </style>
</head>

<body>
  <!-- Content -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include('partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="layout-page">
          <%- include('partials/navbar', {user: user}) %>
            <div class="content-wrapper">
              <!-- Multi Steps Registration -->
              <div class="container-xxl flex-grow-1 container-p-y">
                <form id="multiStepsForm" class="w-100" onsubmit="return false">
                  <div id="multiStepsValidation" class="bs-stepper border-none shadow-none mt-5">
                    <div class="bs-stepper-header d-flex flex-wrap gap-2 w-100">

                      <!-- Paso : Personal Info -->
                      <div class="step" data-target="#accountDetailsValidation">
                        <button type="button" class="step-trigger">
                          <span class="bs-stepper-circle"><i class="ti ti-file-analytics ti-md"></i></span>
                          <span class="bs-stepper-label"><span class="bs-stepper-title">Personal Info</span></span>
                        </button>
                      </div>
                      <div class="line"><i class="ti ti-chevron-right"></i></div>

                      <!-- Paso : Contact Info -->
                      <div class="step" data-target="#contactInfoValidation">
                        <button type="button" class="step-trigger">
                          <span class="bs-stepper-circle"><i class="ti ti-user ti-md"></i></span>
                          <span class="bs-stepper-label"><span class="bs-stepper-title">Contact Info</span></span>
                        </button>
                      </div>
                      <div class="line"><i class="ti ti-chevron-right"></i></div>

                      <!-- Paso : Commisions -->
                      <div class="step" data-target="#commisionValidation">
                        <button type="button" class="step-trigger">
                          <span class="bs-stepper-circle"><i class="ti ti-cash ti-md"></i></span>
                          <span class="bs-stepper-label"><span class="bs-stepper-title">Commision</span></span>
                        </button>
                      </div>
                      <div class="line"><i class="ti ti-chevron-right"></i></div>

                      <!-- Paso : Documents -->
                      <div class="step" data-target="#documentsValidation">
                        <button type="button" class="step-trigger">
                          <span class="bs-stepper-circle"><i class="ti ti-file-text ti-md"></i></span>
                          <span class="bs-stepper-label"><span class="bs-stepper-title">Documents</span></span>
                        </button>
                      </div>
                      <div class="line"><i class="ti ti-chevron-right"></i></div>

                      <!-- Paso : States & Carriers -->
                      <div class="step" data-target="#statesCarriersValidation">
                        <button type="button" class="step-trigger">
                          <span class="bs-stepper-circle"><i class="ti ti-building ti-md"></i></span>
                          <span class="bs-stepper-label"><span class="bs-stepper-title">States & Carriers</span></span>
                        </button>
                      </div>
                    </div>
                    <div class="bs-stepper-content">
                      <!-- Contenido 1 -->
                      <div id="accountDetailsValidation" class="content active">
                        <div class="content-header mb-6">
                          <h4 class="mb-0">Personal Info</h4>
                          <p class="mb-0">Enter Your Personal Information</p>
                        </div>
                        <div class="row g-3">
                          <!-- Contact type (Required) -->
                          <div class="col-sm-6">
                            <label class="form-label" for="contactType">
                              Contact Type <span class="text-danger">*</span>
                            </label>
                            <select id="contactType" name="contactType" class="form-select" required>
                              <option value="" disabled <%=!personalInfo?.contactType ? 'selected' : '' %>>Select
                                type... </option>
                              <option value="individual" <%=personalInfo?.contactType==='individual' ? 'selected' : ''
                                %>
                                >Individual</option>
                              <option value="business" <%=personalInfo?.contactType==='business' ? 'selected' : '' %>
                                >Business</option>
                            </select>
                          </div>

                          <!-- Legal Name (Required) -->
                          <div class="col-sm-6">
                            <label class="form-label" for="legalName">
                              Legal Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="legalName" id="legalName" class="form-control"
                              placeholder="John Doe" value="<%= personalInfo?.legalName || '' %>" required />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- Business Name (Required if business) -->
                          <div class="col-sm-6" id="businessNameGroup" style="display:none;">
                            <label class="form-label" for="businessName">
                              Business Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="businessName" id="businessName" class="form-control"
                              placeholder="Business LLC" value="<%= personalInfo?.businessName || '' %>" required />
                          </div>

                          <!-- EIN de la Compañía (Required if business) -->
                          <div class="col-sm-6" id="einGroup" style="display:none;">
                            <label class="form-label" for="ein">
                              EIN<span class="text-danger">*</span>
                            </label>
                            <input type="text" name="ein" id="ein" class="form-control" placeholder="XX-XXXXXXX"
                              value="<%= personalInfo?.companyEIN || '' %>" required>
                          </div>
                          <script>
                            document.addEventListener('DOMContentLoaded', function () {
                              const einInput = document.getElementById('ein');

                              einInput.addEventListener('input', function (e) {
                                let value = einInput.value.replace(/\D/g, '').slice(0, 9); // Solo dígitos, máx 9

                                if (value.length > 2) {
                                  value = value.slice(0, 2) + '-' + value.slice(2);
                                }

                                einInput.value = value;
                              });
                            });
                          </script>
                          <!-- Preferred First Name -->
                          <div class="col-sm-6" id="preferredFirstNameGroup">
                            <label class="form-label" for="preferredFirstName">Preferred First Name</label>
                            <input type="text" name="preferredFirstName" id="preferredFirstName" class="form-control"
                              placeholder="John" value="<%= personalInfo?.preferredName || '' %>" />
                          </div>

                          <!-- Legal Sex (Required) -->
                          <div class="col-sm-6">
                            <label class="form-label">Legal Sex <span class="text-danger">*</span></label>
                            <div class="mt-2">
                              <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="legalSex" id="legalSexMale"
                                  value="male" required <%=personalInfo?.legalSex==='male' ? 'checked' : '' %> />
                                <label class="form-check-label" for="legalSexMale">Male</label>
                              </div>
                              <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="legalSex" id="legalSexFemale"
                                  value="female" required <%=personalInfo?.legalSex==='female' ? 'checked' : '' %> />
                                <label class="form-check-label" for="legalSexFemale">Female</label>
                              </div>
                            </div>
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- Date of Birth (Required) -->
                          <div class="col-sm-6">
                            <label class="form-label" for="dateOfBirth">
                              Date of Birth <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" placeholder="YYYY-MM-DD" id="dateOfBirth"
                              name="dateOfBirth" required
                              value="<%= personalInfo?.dateOfBirth ? personalInfo.dateOfBirth.toISOString().substring(0, 10) : '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- SSN y NPN (Required) -->
                          <div class="row g-3">
                            <!-- SSN -->
                            <div class="col-sm-6">
                              <label class="form-label" for="ssn">
                                SSN <span class="text-danger">*</span>
                              </label>
                              <input type="text" name="ssn" id="ssn" class="form-control" placeholder="XXX-XX-XXXX"
                                aria-label="Social Security Number" required value="<%= personalInfo?.ssn || '' %>" />
                            </div>

                            <!-- NPN -->
                            <div class="col-sm-6">
                              <label class="form-label" for="npn">
                                NPN <span class="text-danger">*</span>
                              </label>
                              <input type="text" name="npn" id="npn" class="form-control" placeholder="XXXXXXXX"
                                aria-label="NPN" required pattern="\d{8}" maxlength="8"
                                value="<%= personalInfo?.npn || '' %>" />
                            </div>
                          </div>
                          <script>
                            const ssnInput = document.getElementById("ssn");
                            ssnInput.maxLength = 11;

                            function formatSSN(val) {
                              let digits = (val || '').replace(/\D/g, '').slice(0, 9);
                              if (digits.length > 5) {
                                return `${digits.slice(0, 3)}-${digits.slice(3, 5)}-${digits.slice(5)}`;
                              } else if (digits.length > 3) {
                                return `${digits.slice(0, 3)}-${digits.slice(3)}`;
                              }
                              return digits;
                            }

                            ssnInput.value = formatSSN(ssnInput.value);

                            ssnInput.addEventListener('input', function () {
                              this.value = formatSSN(this.value);
                            });

                            document.querySelector("form").addEventListener("submit", function (e) {
                              const ssnInput = document.getElementById("ssn");
                              if (!/^\d{3}-\d{2}-\d{4}$/.test(ssnInput.value)) {
                                ssnInput.classList.add("is-invalid");
                                e.preventDefault();
                                return;
                              }
                              ssnInput.value = ssnInput.value.replace(/\D/g, "");
                            });

                            document.getElementById("npn").addEventListener("input", function (e) {
                              let value = e.target.value.replace(/\D/g, "");
                              e.target.value = value.slice(0, 8);
                            });
                            document.querySelector("form").addEventListener("submit", function (e) {
                              const npnInput = document.getElementById("npn");
                              if (!/^\d{8}$/.test(npnInput.value)) {
                                npnInput.classList.add("is-invalid");
                                e.preventDefault();
                              }
                            });
                          </script>

                          <div class="col-sm-6" id="UnderSelect">
                            <div id="companySelectGroup" style="margin-top: 1rem;">
                              <label class="form-label" for="companySelect">Select an agency</label>
                              <select id="agencySelect" name="company" class="form-select" required>
                                <option value="">Select an agency...</option>
                              </select>
                            </div>
                          </div>

                          <!-- 7. Photo -->
                          <div class="col-md-12" style="padding-bottom: 5%;">
                            <label class="form-label" for="profilePhotoInput">Profile Photo</label>
                            <div class="d-flex align-items-center border rounded p-3 mb-3">
                              <% if (personalInfo?.photoPath) { %>
                                <div class="me-3">
                                  <img id="profilePhotoPreview" alt="Profile Photo"
                                    style="max-height: 150px; max-width: 150px; object-fit: cover; border-radius: 8px;" />
                                </div>
                                <% } %>
                                  <div>
                                    <input class="form-control" type="file" id="profilePhotoInput" name="profilePhoto"
                                      accept="image/*" />
                                    <div class="form-text">Upload your profile picture (optional). Max size 2MB.</div>
                                  </div>
                            </div>
                            <% if (personalInfo?.photoPath) { %>
                              <script>
                                const origin = window.location.origin;
                                const photoPath = "<%= personalInfo.photoPath %>";
                                document.getElementById("profilePhotoPreview").src = `${origin}/${photoPath}`;
                                document.getElementById("profilePhotoInput").dataset.existingUrl = photoPath;
                              </script>
                              <% } %>
                          </div>
                        </div>
                        <div class="col-12 d-flex justify-content-between mt-4 sticky-bottom">
                          <button class="btn btn-label-secondary btn-prev" disabled>Previous</button>
                          <button type="button" class="btn btn-primary btn-next">Next</button>
                        </div>
                      </div>

                      <!-- Contenido -->
                      <div id="contactInfoValidation" class="content">
                        <div class="content-header mb-6">
                          <h4 class="mb-0">Contact Info</h4>
                          <p class="mb-0">Enter Your Contact Information</p>
                        </div>
                        <div class="row g-6">
                          <!-- 1. Personal Email (Required) -->
                          <div class="col-sm-6">
                            <label class="form-label" for="personalEmail">Personal Email <span
                                class="text-danger">*</span></label>
                            <input type="email" id="personalEmail" name="personalEmail" class="form-control"
                              placeholder="john.doe@email.com" required
                              value="<%= contactInfo?.personalEmail || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- 2. Personal Phone -->
                          <div class="col-sm-6">
                            <label class="form-label" for="personalPhone">Personal Phone</label>
                            <input type="tel" id="personalPhone" name="personalPhone" class="form-control"
                              placeholder="202 555 0111" maxlength="14" required
                              value="<%= contactInfo?.personalPhone || '' %>" />
                          </div>

                          <script>
                            const phoneInput = document.getElementById("personalPhone");

                            // Format phone for display (on input and on load)
                            function formatPhoneDisplay(val) {
                              let value = (val || '').replace(/\D/g, "");
                              if (value.length > 10) value = value.slice(0, 10);
                              let formatted = value;
                              if (value.length > 6) {
                                formatted = `(${value.slice(0, 3)}) ${value.slice(3, 6)}-${value.slice(6)}`;
                              } else if (value.length > 3) {
                                formatted = `(${value.slice(0, 3)}) ${value.slice(3)}`;
                              } else if (value.length > 0) {
                                formatted = `(${value}`;
                              }
                              return formatted;
                            }

                            // On load, format the value if present
                            phoneInput.value = formatPhoneDisplay(phoneInput.value);

                            phoneInput.addEventListener("input", function (e) {
                              e.target.value = formatPhoneDisplay(e.target.value);
                            });

                            // On form submit, strip formatting so only digits are sent
                            document.getElementById('multiStepsForm').addEventListener('submit', function (e) {
                              phoneInput.value = phoneInput.value.replace(/\D/g, "");
                            });
                          </script>

                          <!-- 4. Address Line 1 (Required) -->
                          <div class="col-md-12">
                            <label class="form-label" for="addressLine1">Address Line 1 <span
                                class="text-danger">*</span></label>
                            <input type="text" id="addressLine1" name="addressLine1" class="form-control"
                              placeholder="1234 Main St" required value="<%= contactInfo?.addressLine1 || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- 5. Address Line 2 -->
                          <div class="col-md-12">
                            <label class="form-label" for="addressLine2">Address Line 2</label>
                            <input type="text" id="addressLine2" name="addressLine2" class="form-control"
                              placeholder="Apartment, studio, or floor"
                              value="<%= contactInfo?.addressLine2 || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- 6. City (Required) -->
                          <div class="col-sm-4">
                            <label class="form-label" for="city">City <span class="text-danger">*</span></label>
                            <input type="text" id="city" name="city" class="form-control" placeholder="e.g. New York"
                              required value="<%= contactInfo?.city || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- 7. State (Required) -->
                          <div class="col-sm-4">
                            <label class="form-label" for="multiStepsState">State <span
                                class="text-danger">*</span></label>
                            <input type="text" id="state" name="state" class="form-control"
                              placeholder="e.g. California" required value="<%= contactInfo?.state || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>

                          <!-- 8. ZIP Code (Required) -->
                          <div class="col-sm-4">
                            <label class="form-label" for="zipCode">ZIP Code <span class="text-danger">*</span></label>
                            <input type="number" id="zipCode" name="zipCode" class="form-control" placeholder="10001"
                              maxlength="5" minlength="5" required value="<%= contactInfo?.zipCode || '' %>" />
                            <div class="invalid-feedback"></div>
                          </div>
                        </div>
                        <div class="col-12 d-flex justify-content-between mt-4 sticky-bottom">
                          <button type="button" class="btn btn-label-secondary btn-prev">Previous</button>
                          <button type="button" class="btn btn-primary btn-next">Next</button>
                        </div>
                      </div>
                      <!-- Contenido -->
                      <div id="commisionValidation" class="content">
                        <div class="content-header mb-6">
                          <h4 class="mb-0">Would you like to assign your commissions to GoldenTrust?</h4>
                          <div class="mt-2">
                            <div class="form-check form-check-inline">
                              <input class="form-check-input" type="radio" name="assignToGoldenTrust" value="yes"
                                required <%=(paymentMethod && paymentMethod.assignToGTI===true) || !paymentMethod
                                ? 'checked' : '' %>
                              />
                              <label class="form-check-label">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                              <input class="form-check-input" type="radio" name="assignToGoldenTrust" value="no"
                                required <%=paymentMethod && paymentMethod.assignToGTI===false ? 'checked' : '' %> />
                              <label class="form-check-label">No</label>
                            </div>
                          </div>
                        </div>
                        <!-- Payment Method Section -->
                        <div class="row g-6">
                          <!-- Single Bank Account Form -->
                          <div class="card bank-account-entry mb-4 mt-4">
                            <div class="card-header d-flex justify-content-between align-items-center">
                              <h6 class="mb-0">Bank Account</h6>
                            </div>
                            <div class="card-body">
                              <div class="row g-6">
                                <div class="col-12">
                                  <label class="form-label">Bank Account Type</label>
                                  <div>
                                    <div class="form-check form-check-inline">
                                      <input class="form-check-input" type="radio" id="bankAccountTypeCheking"
                                        value="checking" <%=paymentMethod && paymentMethod.bankAccountType==='checking'
                                        ? 'checked' : '' %>
                                      required />
                                      <label class="form-check-label">Checking</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                      <input class="form-check-input" type="radio" id="bankAccountTypeSavings"
                                        value="savings" <%=paymentMethod && paymentMethod.bankAccountType==='savings'
                                        ? 'checked' : '' %>
                                      required />
                                      <label class="form-check-label">Savings</label>
                                    </div>
                                    <div class="form-text">Select an option.</div>
                                  </div>
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label">Bank Account Number <span
                                      class="text-danger">*</span></label>
                                  <input type="number" id="accountNumber" class="form-control" autocomplete="off"
                                    required value="<%= paymentMethod ? paymentMethod.bankAccountNum : '' %>" />
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label">Confirm Account Number <span
                                      class="text-danger">*</span></label>
                                  <input type="number" id="confirmAccountNumber" class="form-control" autocomplete="off"
                                    required value="<%= paymentMethod ? paymentMethod.bankAccountNum : '' %>" />
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label">Bank Routing Number <span
                                      class="text-danger">*</span></label>
                                  <input type="number" id="routingNumber" class="form-control" required
                                    value="<%= paymentMethod ? paymentMethod.bankRoutingNum : '' %>" />
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label">Account Nickname <span class="text-danger">*</span></label>
                                  <input type="text" id="accountNickname" class="form-control"
                                    placeholder="e.g., My Primary Checking" required
                                    value="<%= paymentMethod ? paymentMethod.accountNickname : '' %>" />
                                </div>
                              </div>
                            </div>
                          </div>
                          <!-- End Single Bank Account Form -->
                        </div>
                        <div class="col-12 d-flex justify-content-between mt-4 sticky-bottom">
                          <button type="button" class="btn btn-label-secondary btn-prev">Previous</button>
                          <button type="button" class="btn btn-primary btn-next">Next</button>
                        </div>
                      </div>
                      <!-- Contenido -->
                      <div id="documentsValidation" class="content">
                        <div class="content-header mb-6">
                          <h4 class="mb-0">Documents</h4>
                          <p class="mb-0">Please upload the required documents to complete your profile.</p>
                        </div>
                        <div class="row g-4">
                          <% const docs=documents || {}; const requiredDocs=necessaryDocuments || {}; const docFields=[
                            { key: "directDepositForm" , label: "Direct Deposit Form" , inputId: "directDepositUpload"
                            }, { key: "driverLicense" , label: "Driver's License" , inputId: "driversLicenseUpload" }, {
                            key: "EINconfirmation" , label: "EIN Confirmation Letter" , inputId: "einConfirmationUpload"
                            }, { key: "eANDo" , label: "E&O" , inputId: "eoUpload" }, { key: "proLicense" ,
                            label: "Professional License" , inputId: "professionalLicenseUpload" }, {
                            key: "socialSecurityCard" , label: "Social Security Card" , inputId: "ssnCardUpload" }, {
                            key: "ffmCertification" , label: "FFM Certification" , inputId: "ffmCertificationUpload" },
                            { key: "gaLicense" , label: "GA License" , inputId: "gaLicenseUpload" }, {
                            key: "gaCertification" , label: "GA Certification" , inputId: "gaCertificationUpload" }, {
                            key: "sunbiz" , label: "Sunbiz" , inputId: "sunbizUpload" }, { key: "corporationLicense" ,
                            label: "Corporation License" , inputId: "corporationLicenseUpload" },
