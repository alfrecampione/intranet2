    const uploadFile = async (file) => {
      if (file) {
        try {
          const formData = new FormData();
          formData.append("file", file);

          const uploadResponse = await fetch(`/upload`, {
            method: "POST",
            body: formData,
          });

          if (uploadResponse.ok) {
            const { path } = await uploadResponse.json();
            return path;
          }
        } catch (error) {
          throw new Error("Error uploading file: " + error.message);
        }
      }
      return null;
    };


    async function savePersonalInfo() {
      const contactType = document.getElementById("contactType")?.value || "";
      const legalName = document.getElementById("legalName")?.value || "";
      const preferredFirstName = document.getElementById("preferredFirstName")?.value || "";
      const dateOfBirth = document.getElementById("dateOfBirth")?.value || "";
      const ssn = document.getElementById("ssn")?.value || "";
      const npn = document.getElementById("npn")?.value || "";
      const photoInput = document.getElementById("profilePhotoInput");

      const businessName = document.getElementById("businessName")?.value || "";
      const companyEIN = document.getElementById("ein")?.value || "";

      const photoFile = photoInput?.files[0] || null;
      const existingPhotoURL = photoInput?.dataset.existingUrl || "";

      const isMale = document.getElementById("legalSexMale")?.checked;
      const legalSex = isMale ? "male" : "female";

      const agencySelect = document.getElementById("agencySelect");
      let agency = null;
      let franchise = null;

      if (agencySelect && agencySelect.value) {
        const selectedOption = agencySelect.options[agencySelect.selectedIndex];
        const isAgency = selectedOption.dataset.isAgency === "true";

        if (isAgency) {
          agency = selectedOption.value;
        } else {
          franchise = selectedOption.value;
        }
      }

      let uploadedPhoto = existingPhotoURL;
      if (photoFile) {
        uploadedPhoto = await uploadFile(photoFile);
      }

      const personalInfo = {
        contactType: contactType || null,
        legalName: legalName || null,
        preferredName: preferredFirstName || null,
        dateOfBirth: dateOfBirth || null,
        ssn: ssn || null,
        npn: npn || null,
        legalSex: legalSex || null,
        userId: currentUserId,
        photoPath: uploadedPhoto || null,
        businessName: businessName || null,
        companyEIN: companyEIN || null,
        agency: agency,
        franchise: franchise
      };

      const response = await fetch(`${url}/steps/personal-info`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(personalInfo)
      });

      if (!response.ok) throw new Error("Error uploading personal info");
      return await response.json();
    }

    async function saveContactInfo() {
      const personalEmail = document.getElementById("personalEmail")?.value || "";
      const personalPhone = document.getElementById("personalPhone")?.value || "";
      const addressLine1 = document.getElementById("addressLine1")?.value || "";
      const addressLine2 = document.getElementById("addressLine2")?.value || "";
      const city = document.getElementById("city")?.value || "";
      const state = document.getElementById("state")?.value || "";
      const zipCode = document.getElementById("zipCode")?.value || "";

      const contactInfo = {
        personalEmail: personalEmail,
        personalPhone: personalPhone,
        addressLine1: addressLine1,
        addressLine2: addressLine2 || null,
        city: city,
        state: state,
        zipCode: zipCode,
        userId: currentUserId
      };
      const contactInfoJSON = JSON.stringify(contactInfo)

      user_email = personalEmail;

      const response = await fetch(`${url}/steps/contact-info`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: contactInfoJSON
      });

      if (!response.ok) throw new Error("Error uploading contact info");
      return await response.json();
    }

    async function savePaymentMethod() {
      const entry = document.querySelector('.bank-account-entry');

      const assignToGTI = document.querySelector('input[name="assignToGoldenTrust"]:checked');
      if (!assignToGTI) {
        throw new Error("Please select if you want to assign your commissions to GoldenTrust.");
      }

      let bankAccount;

      if (assignToGTI.value !== "yes") {
        bankAccount = {
          assignToGTI: false,
          bankAccountType: null,
          bankAccountNum: null,
          bankRoutingNum: null,
          accountNickname: null,
          userId: currentUserId
        };
      } else {
        const bankAccountTypeRadio = document.querySelector('input[id="bankAccountTypeCheking"]:checked')
          ? "checking"
          : document.querySelector('input[id="bankAccountTypeSavings"]:checked')
            ? "savings"
            : null;

        const bankAccountNum = document.getElementById("accountNumber")?.value || "";
        const confirmAccountNum = document.getElementById("confirmAccountNumber")?.value || "";
        const bankRoutingNum = document.getElementById("routingNumber")?.value || "";
        const accountNickname = document.getElementById("accountNickname")?.value || "";

        if (!bankAccountTypeRadio || !bankAccountNum || !confirmAccountNum || !bankRoutingNum || !accountNickname) {
          throw new Error("Please fill in all required fields.");
        }

        if (bankAccountNum !== confirmAccountNum) {
          throw new Error("Account number and confirmation do not match.");
        }

        bankAccount = {
          assignToGTI: true,
          bankAccountType: bankAccountTypeRadio,
          bankAccountNum,
          bankRoutingNum,
          accountNickname,
          userId: currentUserId
        };
      }

      const response = await fetch(`${url}/steps/payment-method`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(bankAccount)
      });

      if (!response.ok) throw new Error("Error saving payment method");
      return await response.json();
    }

    async function saveDocuments() {
      const fileIds = {
        directDepositForm: "directDepositUpload",
        driverLicense: "driversLicenseUpload",
        EINconfirmation: "einConfirmationUpload",
        eANDo: "eoUpload",
        proLicense: "professionalLicenseUpload",
        taxIdentificationW9: "taxIdentificationW9Upload",
        ffmCertification: "ffmCertificationUpload",
        gaLicense: "gaLicenseUpload",
        gaCertification: "gaCertificationUpload",
        sunbiz: "sunbizUpload",
        corporationLicense: "corporationLicenseUpload"
      };

      const payload = { userId: currentUserId };

      const validInputs = [];
      for (const [key, inputId] of Object.entries(fileIds)) {
        const input = document.getElementById(inputId);
        if (input !== null) {
          validInputs.push({ key, input });
        }
      }

      for (const { input } of validInputs) {
        const parent = input.closest(".d-flex");
        if (parent && parent.classList.contains("border-danger")) {
          throw new Error("Please upload all required documents before submitting.");
        }
      }

      for (const { key, input } of validInputs) {
        const file = input?.files?.[0];
        const parent = input.closest(".d-flex");
        const existingLink = parent.querySelector("a[href]:not([href=''])");
        payload[key] = file ? await uploadFile(file) : existingLink?.getAttribute("href") || null;
      }

      const response = await fetch(`${url}/steps/documents`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (!response.ok) throw new Error("Error uploading documents");
      return await response.json();
    }

    let recommendation = "";

    async function saveStatesCarriers() {
      const carriers = [];
      const cards = document.querySelectorAll(".carrier-card");
      recommendation = document.getElementById("carrier-recommendation")?.value || "";
      const isDone = document.getElementById("recommendation-done")?.checked || false;

      cards.forEach(card => {
        const stateSelect = card.querySelector(".state-dropdown");
        const companySelect = card.querySelector(".company-select");

        const state = stateSelect?.value;
        const selectedCompanies = Array.from(companySelect?.selectedOptions || []).map(opt => opt.value);

        if (!state || selectedCompanies.length === 0) return;

        selectedCompanies.forEach(company => {
          let carrier = carriers.find(c => c.name === company);
          if (!carrier) {
            carrier = { name: company, states: [] };
            carriers.push(carrier);
          }
          if (!carrier.states.includes(state)) {
            carrier.states.push(state);
          }
        });
      });

      if (carriers.length === 0) throw new Error("Please select at least one company for one state.");

      const response = await fetch(`${url}/steps/states-carriers`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: currentUserId, carriers, recommendation, isDone })
      });

      if (!response.ok) throw new Error("Error saving states and carriers");
      return await response.json();
    }


    document.querySelector(".btn-submit").addEventListener("click", async function (e) {
      e.preventDefault();
      const submitBtn = this;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Sending...`;

      try {
        if (currentUserId === null) throw new Error("Se requiere ID de usuario");

        await savePersonalInfo();
        await saveContactInfo();
        await savePaymentMethod();
        await saveDocuments();
        await saveStatesCarriers();

        if (isEdit == "false") {
          const response = await fetch(`${url}/email/config`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: user_email, recommendation: recommendation })
          });
          if (!response.ok) throw new Error("Error sending the email");
          window.location.href = `${url}/users/dashboard`;
        } else {
          window.location.href = `${url}/users/agents`;
        }
      } catch (error) {
        showToast("Error", error.message || "An unexpected error occurred. Please try again later.");
        submitBtn.disabled = false;
        submitBtn.innerHTML = `Review & Submit`;
      }
    });
  </script>

</body>

</html>