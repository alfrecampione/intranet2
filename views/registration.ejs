  <script>
    (function () {
      const companies = JSON.parse(document.getElementById('companies-data').textContent);
      const userSelections = JSON.parse(document.getElementById('companiesbyUser-data').textContent);

      const US_STATES = [
        { name: "Alabama", abbr: "AL" }, { name: "Alaska", abbr: "AK" }, { name: "Arizona", abbr: "AZ" },
        { name: "Arkansas", abbr: "AR" }, { name: "California", abbr: "CA" }, { name: "Colorado", abbr: "CO" },
        { name: "Connecticut", abbr: "CT" }, { name: "Delaware", abbr: "DE" }, { name: "Florida", abbr: "FL" },
        { name: "Georgia", abbr: "GA" }, { name: "Hawaii", abbr: "HI" }, { name: "Idaho", abbr: "ID" },
        { name: "Illinois", abbr: "IL" }, { name: "Indiana", abbr: "IN" }, { name: "Iowa", abbr: "IA" },
        { name: "Kansas", abbr: "KS" }, { name: "Kentucky", abbr: "KY" }, { name: "Louisiana", abbr: "LA" },
        { name: "Maine", abbr: "ME" }, { name: "Maryland", abbr: "MD" }, { name: "Massachusetts", abbr: "MA" },
        { name: "Michigan", abbr: "MI" }, { name: "Minnesota", abbr: "MN" }, { name: "Mississippi", abbr: "MS" },
        { name: "Missouri", abbr: "MO" }, { name: "Montana", abbr: "MT" }, { name: "Nebraska", abbr: "NE" },
        { name: "Nevada", abbr: "NV" }, { name: "New Hampshire", abbr: "NH" }, { name: "New Jersey", abbr: "NJ" },
        { name: "New Mexico", abbr: "NM" }, { name: "New York", abbr: "NY" }, { name: "North Carolina", abbr: "NC" },
        { name: "North Dakota", abbr: "ND" }, { name: "Ohio", abbr: "OH" }, { name: "Oklahoma", abbr: "OK" },
        { name: "Oregon", abbr: "OR" }, { name: "Pennsylvania", abbr: "PA" }, { name: "Rhode Island", abbr: "RI" },
        { name: "South Carolina", abbr: "SC" }, { name: "South Dakota", abbr: "SD" }, { name: "Tennessee", abbr: "TN" },
        { name: "Texas", abbr: "TX" }, { name: "Utah", abbr: "UT" }, { name: "Vermont", abbr: "VT" },
        { name: "Virginia", abbr: "VA" }, { name: "Washington", abbr: "WA" }, { name: "West Virginia", abbr: "WV" },
        { name: "Wisconsin", abbr: "WI" }, { name: "Wyoming", abbr: "WY" }
      ];

      const selectedStates = new Set();

      // Only states with at least one company
      const statesWithCompanies = US_STATES.filter(state =>
        companies.some(c => Array.isArray(c.States) && c.States.includes(state.abbr))
      );

      function getCompaniesByState(abbr) {
        return companies
          .filter(c => Array.isArray(c.States) && c.States.includes(abbr))
          .map(c => c.name);
      }

      function updateAllStateDropdowns() {
        const allDropdowns = document.querySelectorAll('.state-dropdown');
        allDropdowns.forEach(dropdown => {
          const current = dropdown.value;
          dropdown.innerHTML = `<option value="">-- Select a state --</option>` + statesWithCompanies
            .filter(state => !selectedStates.has(state.abbr) || state.abbr === current)
            .map(state =>
              `<option value="${state.abbr}"${state.abbr === current ? ' selected' : ''}>${state.name}</option>`
            ).join('');
        });
      }

      function createCard(selectedState = '', selectedCompanies = []) {
        const container = document.getElementById('carriers-list');

        const card = document.createElement('div');
        card.className = 'card mb-2 carrier-card';
        card.style.display = 'inline-block';
        card.style.width = '45%';
        card.style.minWidth = '300px';
        card.style.marginRight = '1%';
        card.style.verticalAlign = 'top';

        const cardBody = document.createElement('div');
        cardBody.className = 'card-body';

        const cardId = `card-${Date.now()}`;
        const stateSelectId = `state-select-${cardId}`;
        const companySelectId = `company-select-${cardId}`;

        const stateOptions = statesWithCompanies
          .filter(state => !selectedStates.has(state.abbr) || state.abbr === selectedState)
          .map(state =>
            `<option value="${state.abbr}"${state.abbr === selectedState ? ' selected' : ''}>${state.name}</option>`
          ).join('');

        const initialCompanies = selectedState ? getCompaniesByState(selectedState) : [];
        const companyOptions = initialCompanies.map(name =>
          `<option value="${name}"${selectedCompanies.includes(name) ? ' selected' : ''}>${name}</option>`
        ).join('');

        cardBody.innerHTML = `
  <div class="d-flex align-items-center gap-2">
    <select class="form-select state-dropdown" id="${stateSelectId}" data-company-select="${companySelectId}">
      <option value="">-- Select a state --</option>
      ${stateOptions}
    </select>
    <select class="form-select company-select select2" id="${companySelectId}" multiple>
      ${companyOptions}
    </select>
    <button type="button" class="btn btn-sm btn-outline-danger remove-card ms-1" title="Remove">
      <i class="ti ti-trash"></i>
    </button>
  </div>
`;

        card.appendChild(cardBody);
        container.appendChild(card);

        $(`#${companySelectId}`).select2({
          placeholder: "Select a carrier",
          dropdownParent: $('#statesCarriersValidation'),
          width: 'resolve',
        });

        const stateDropdown = document.getElementById(stateSelectId);
        const companySelect = document.getElementById(companySelectId);

        stateDropdown.addEventListener('change', function () {
          const newState = this.value;

          selectedStates.forEach(st => {
            if (st === selectedState) selectedStates.delete(st);
          });

          selectedState = newState;
          if (newState) selectedStates.add(newState);

          const newCompanies = getCompaniesByState(newState);
          companySelect.innerHTML = newCompanies.map(name =>
            `<option value="${name}">${name}</option>`
          ).join('');
          $(`#${companySelectId}`).val(null).trigger('change');

          updateAllStateDropdowns();
        });

        card.querySelector('.remove-card').addEventListener('click', function () {
          if (selectedState) selectedStates.delete(selectedState);
          card.remove();
          updateAllStateDropdowns();
        });

        if (selectedState) selectedStates.add(selectedState);
        updateAllStateDropdowns();
      }

      function renderUI() {
        document.getElementById('add-state-btn').addEventListener('click', () => {
          if (selectedStates.size >= statesWithCompanies.length) {
            alert('All states with available companies have been added.');
            return;
          }
          createCard();
        });

        // Load pre-existing selections
        const groupedSelections = userSelections.reduce((acc, sel) => {
          if (!sel.state || !sel.company) return acc;

          const state = sel.state;
          const companyList = Array.isArray(sel.company) ? sel.company : [sel.company];

          if (!acc[state]) {
            acc[state] = new Set();
          }

          companyList.forEach(company => acc[state].add(company));
          return acc;
        }, {});

        Object.entries(groupedSelections).forEach(([state, companiesSet]) => {
          const companies = Array.from(companiesSet);
          createCard(state, companies);
        });
      }

      document.addEventListener('DOMContentLoaded', renderUI);
    })();
  </script>
  <!--/ States & Carriers -->



  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const fileInputs = document.querySelectorAll("input[type='file']");

      function updateStatusVisual(input) {
        const parent = input.closest(".d-flex");
        if (!parent) return;

        const fileUploaded = input.files.length > 0;

        // Special case for profile photo
        if (input.id === "profilePhotoInput") {
          const hasExistingPhoto = !!input.dataset.existingUrl;
          parent.classList.remove("border-success", "border-danger");
          if (fileUploaded || hasExistingPhoto) {
            parent.classList.add("border-success");
          } else {
            parent.classList.remove("border-success", "border-danger");
          }
          return;
        }

        // For documents
        const link = parent.querySelector("a[href]");
        const hasExistingFile = link && link.getAttribute("href").trim() !== "";

        parent.classList.remove("border-success", "border-danger");

        if (fileUploaded || hasExistingFile) {
          parent.classList.add("border-success");
        } else {
          parent.classList.add("border-danger");
        }
      }

      fileInputs.forEach(input => {
        updateStatusVisual(input);
        input.addEventListener("change", function () {
          updateStatusVisual(this);
        });
      });
    });
  </script>

  <!-- Push the info -->
  <script>
    const currentUserId = "<%= userId %>";
    const isEdit = "<%= isEdit %>";
    let user_email;

    if (isEdit == "false") {
      document.addEventListener('DOMContentLoaded', () => {
        const stepButtons = document.querySelectorAll('.step-trigger');
        stepButtons.forEach(btn => {
          btn.setAttribute('disabled', 'disabled');
        });
      });
