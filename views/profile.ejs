                { name: "Virginia", abbr: "VA" }, { name: "Washington", abbr: "WA" }, { name: "West Virginia", abbr: "WV" },
                { name: "Wisconsin", abbr: "WI" }, { name: "Wyoming", abbr: "WY" }
            ];

            const statesWithCompanies = US_STATES.filter(state =>
                companies.some(c => Array.isArray(c.States) && c.States.includes(state.abbr))
            );

            function getCompaniesByState(abbr) {
                return companies
                    .filter(c => Array.isArray(c.States) && c.States.includes(abbr))
                    .map(c => c.name);
            }

            // Populate state dropdown in modal
            const modalStateSelect = document.getElementById("modalStateSelect");
            statesWithCompanies.forEach(state => {
                const option = document.createElement("option");
                option.value = state.abbr;
                option.textContent = state.name;
                modalStateSelect.appendChild(option);
            });

            // Populate status dropdown in modal
            const modalStatusSelect = document.getElementById("modalStatusSelect");
            allStatusOptions.forEach(status => {
                const option = document.createElement("option");
                option.value = status;
                option.textContent = status;
                modalStatusSelect.appendChild(option);
            });

            // When state changes in modal, update carriers dropdown
            modalStateSelect.addEventListener("change", () => {
                const selectedState = modalStateSelect.value;
                const modalCompanySelect = document.getElementById("modalCompanySelect");
                modalCompanySelect.innerHTML = '<option value="">-- Select a carrier --</option>';

                if (!selectedState) return;

                const carriersForState = getCompaniesByState(selectedState);
                carriersForState.forEach(carrierName => {
                    const option = document.createElement("option");
                    option.value = carrierName;
                    option.textContent = carrierName;
                    modalCompanySelect.appendChild(option);
                });
            });

            const releaseAgentBtn = document.getElementById("release");
