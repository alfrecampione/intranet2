            // Show modal on add carrier button click
            const addCarrierBtn = document.getElementById("add-carrier");
            addCarrierBtn.addEventListener("click", () => {
                document.getElementById("addCarrierForm").reset();
                modalCompanySelect.innerHTML = '<option value="">-- Select a carrier --</option>';

                new bootstrap.Modal(document.getElementById('addCarrierModal')).show();
            });

            // Save new carrier from modal
            document.getElementById("saveCarrierBtn").addEventListener("click", async () => {
                const state = modalStateSelect.value;
                const company = document.getElementById("modalCompanySelect").value;
                const status = modalStatusSelect.value;

                if (!state || !company || !status) {
                    alert("Please select state, carrier, and status.");
                    return;
                }

                // Check if carrier entry already exists
                const exists = carriersData.some(c => c.state === state && c.company === company);
                if (exists) {
                    alert("This carrier already exists in the list.");
                    return;
                }

                // Add new carrier
                await addCarrier(state, company, status);
            });
        });
