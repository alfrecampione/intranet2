    <script>
        // Show persistent toasts for pinned notes
        document.addEventListener("DOMContentLoaded", () => {
            const pinnedNotes = JSON.parse(document.getElementById('notes-data').textContent || '[]');
            const container = document.getElementById('pinned-notes-toasts');
            pinnedNotes.forEach(note => {
                const toast = document.createElement('div');
                toast.className = 'toast show border-warning shadow-sm';
                toast.style.minWidth = '320px';
                toast.setAttribute('role', 'alert');
                toast.setAttribute('aria-live', 'assertive');
                toast.setAttribute('aria-atomic', 'true');
                toast.innerHTML = `
                    <div class="toast-header bg-warning bg-opacity-25">
                        <i class="ti ti-pin me-2 text-warning"></i>
                        <strong class="me-auto text-dark">Pinned Note</strong>
                        <small class="text-muted">${note.createdBy ?? ''}</small>
                        <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body text-dark">${note.text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>
                `;
                toast.querySelector('.btn-close').addEventListener('click', () => {
                    toast.remove();
                });
                container.appendChild(toast);
            });
        });
    </script>

