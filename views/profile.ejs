    <!-- Timeline-->
    <script id="activity-data" type="application/json">
      <%- JSON.stringify(activity) %>
    </script>

    <script>
        function renderTimeLine(timelineItems) {
            const ul = document.querySelector('#user-activity-timeline');
            if (!ul) return;

            ul.innerHTML = '';

            timelineItems.forEach(item => {
                const li = document.createElement('li');
                li.className = 'timeline-item timeline-item-transparent';

                const point = document.createElement('span');
                point.className = `timeline-point timeline-point-${item.variant || 'primary'}`;
                li.appendChild(point);

                const event = document.createElement('div');
                event.className = 'timeline-event';
                li.appendChild(event);

                const header = document.createElement('div');
                header.className = 'timeline-header mb-3';

                const h6 = document.createElement('h6');
                h6.className = 'mb-0';
                h6.textContent = item.title || '';

                const small = document.createElement('small');
                small.className = 'text-muted';
                small.textContent = item.timeAgo || '';

                header.appendChild(h6);
                header.appendChild(small);
                event.appendChild(header);

                if (item.description) {
                    const pre = document.createElement('pre'); // preserves \n
                    pre.className = 'mb-2';
                    pre.style.whiteSpace = 'pre-wrap';
                    pre.textContent = typeof item.description === 'string'
                        ? item.description
                        : JSON.stringify(item.description, null, 2);
                    event.appendChild(pre);
                }

                ul.appendChild(li);
            });
        }

        const activityData = JSON.parse(document.getElementById("activity-data").textContent);
        renderTimeLine(activityData);
    </script>
    <!-- /Timeline-->
