    <script>
        async function addCarrier(state, company, status) {
            try {
                const response = await fetch("/users/profile/add-carrier", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        userId: profile.user_id,
                        company,
                        state,
                        status,
                    }),
                });

                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addCarrierModal')).hide();
                    carriersData.push({ state, company, status });
                    renderCarrierTable(carriersData);
                    showToast("Success", "Carrier added successfully.");
                } else {
                    showToast("Error", "Failed to add carrier: " + result.message);
                }
            } catch (error) {
                alert("Error adding carrier: " + error.message);
            }
        }

        async function releaseAgent() {
            try {
                const response = await fetch(`/users/profile/release-agent/${profile.user_id}`, {
                    method: "DELETE",
                    headers: {
                        "Content-Type": "application/json",
                    },
                });
            } catch (error) {
                showToast("Error", "Failed to release agent: " + error.message);
            }
        }

