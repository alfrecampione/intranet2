    <!-- Carrier Status JS -->
    <script id="carriers-data" type="application/json">
      <%- JSON.stringify(carriers) %>
    </script>

    <script>
        const statusOptions = [
            "Request Received from Agent",
            "Pending Submission",
            "Submitted to Carrier",
            "Carrier In Review",
            "Carrier Sent Contract to Agent",
            "Ready to Sell"
        ];

        function renderCarrierTable(carriers) {
            const table = document.querySelector(".datatables-basic");
            const tbody = table.querySelector("tbody");
            tbody.innerHTML = "";

            if (carriers.length === 0) {
                const tr = document.createElement("tr");
                tr.innerHTML = `<td valign="top" colspan="4" class="dataTables_empty">No carriers found.</td>`;
                tbody.appendChild(tr);
                return;
            }

            const grouped = carriers.reduce((acc, carrier) => {
                const key = carrier.state;
                if (!acc[key]) acc[key] = [];
                acc[key].push(carrier);
                return acc;
            }, {});

            let rowIndex = 1;

            Object.entries(grouped).forEach(([stateName, carriersInState]) => {
                carriersInState.forEach((carrier, i) => {
                    const tr = document.createElement("tr");

                    if (i === 0) {
                        const tdIndex = document.createElement("td");
                        tdIndex.textContent = rowIndex++;
                        tdIndex.rowSpan = carriersInState.length;
                        tr.appendChild(tdIndex);

                        const tdState = document.createElement("td");
                        tdState.textContent = stateName;
                        tdState.rowSpan = carriersInState.length;
                        tr.appendChild(tdState);
                    }

                    const tdName = document.createElement("td");
                    tdName.textContent = carrier.company;
                    tr.appendChild(tdName);

                    const tdStatusProgress = document.createElement("td");

                    const idx = statusOptions.indexOf(carrier.status);
                    const currentStep = (idx === -1 ? 0 : idx + 1);
                    const totalSteps = statusOptions.length;
                    const percent = (currentStep / totalSteps) * 100;

                    tdStatusProgress.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1" style="height: 8px;">
                        <div class="progress-bar ${percent === 100 ? 'bg-success' : ''}"
                             role="progressbar"
                             style="width: ${percent}%;"
                             aria-valuenow="${percent}"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                      </div>
                      <small class="text-nowrap">${currentStep}/${totalSteps}</small>
                    </div>
                    <small class="text-muted">${carrier.status || 'Unknown status'}</small>
                  `;

                    tr.appendChild(tdStatusProgress);
                    tbody.appendChild(tr);
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const carriers = JSON.parse(document.getElementById("carriers-data").textContent);
            renderCarrierTable(carriers);
        });
    </script>

