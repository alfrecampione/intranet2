    <script>
        const normalStatusOptions = [
            "Request Received from Agent",
            "Pending Submission",
            "Submitted to Carrier",
            "Carrier In Review",
            "Carrier Sent Contract to Agent",
            "Ready to Sell"
        ];

        const specialStatusOptions = [
            "Rejected by Carrier",
            "Withdrawn by Agent",
            "Need Release",
            "Release"
        ];

        const allStatusOptions = [...normalStatusOptions, ...specialStatusOptions];
        const user = JSON.parse(document.getElementById("user").textContent);
        const profile = JSON.parse(document.getElementById("profile").textContent);

        let isEditing = false;
        let carriersData = [];

        function createStatusSelect(currentStatus) {
            const select = document.createElement("select");
            select.className = "form-select form-select-sm";

            allStatusOptions.forEach((status) => {
                const option = document.createElement("option");
                option.value = status;
                option.textContent = status;
                if (status === currentStatus) option.selected = true;
                select.appendChild(option);
            });

            return select;
        }

        function renderCarrierTable(carriers) {
            const table = document.querySelector(".datatables-basic");
            const tbody = table.querySelector("tbody");
            tbody.innerHTML = "";

            if (carriers.length === 0) {
                const tr = document.createElement("tr");
                tr.innerHTML = `<td valign="top" colspan="5" class="dataTables_empty">No carriers found.</td>`;
                tbody.appendChild(tr);
                return;
            }

            const grouped = carriers.reduce((acc, carrier) => {
                const key = carrier.state;
                if (!acc[key]) acc[key] = [];
                acc[key].push(carrier);
                return acc;
            }, {});

            let rowIndex = 1;

            Object.entries(grouped).forEach(([stateName, carriersInState]) => {
                carriersInState.forEach((carrier, i) => {
                    const tr = document.createElement("tr");

                    if (i === 0) {
                        const tdIndex = document.createElement("td");
                        tdIndex.textContent = rowIndex++;
                        tdIndex.rowSpan = carriersInState.length;
                        tr.appendChild(tdIndex);

                        const tdState = document.createElement("td");
                        tdState.textContent = stateName;
                        tdState.rowSpan = carriersInState.length;
                        tr.appendChild(tdState);
                    }

                    const tdName = document.createElement("td");
                    tdName.textContent = carrier.company;
                    tr.appendChild(tdName);

                    const tdStatusProgress = document.createElement("td");
                    tdStatusProgress.dataset.company = carrier.company;
                    tdStatusProgress.dataset.state = carrier.state;

                    if (isEditing) {
                        const wrapper = document.createElement("div");
                        wrapper.className = "d-flex align-items-center";

                        const select = createStatusSelect(carrier.status);
                        select.addEventListener("change", (e) => {
                            carrier.status = e.target.value;
                        });

                        wrapper.appendChild(select);

                        tdStatusProgress.appendChild(wrapper);
                    }
                    else {
                        const isNormal = normalStatusOptions.includes(carrier.status);
                        let percent = 0;
                        let progressBarClass = "";

                        if (isNormal) {
                            const idx = normalStatusOptions.indexOf(carrier.status);
                            const currentStep = idx === -1 ? 0 : idx + 1;
                            const totalSteps = normalStatusOptions.length;
                            percent = (currentStep / totalSteps) * 100;
                            progressBarClass = percent === 100 ? "bg-success" : "bg-primary";
                        } else if (specialStatusOptions.includes(carrier.status)) {
                            percent = 100;
                            progressBarClass = "bg-warning";
                        } else {
                            percent = 0;
                            progressBarClass = "bg-secondary";
                        }

                        tdStatusProgress.innerHTML = `
                <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height: 8px;">
                        <div class="progress-bar ${progressBarClass}"
                            role="progressbar"
                            style="width: ${percent}%;"
                            aria-valuenow="${percent}"
                            aria-valuemin="0"
                            aria-valuemax="100">
                        </div>
                    </div>
                    <small class="text-nowrap">${isNormal ? (normalStatusOptions.indexOf(carrier.status) + 1) + '/' + normalStatusOptions.length : ''}</small>
                </div>
                <small class="text-muted d-block mb-1">${carrier.status || 'Unknown status'}</small>
                `;
                    }

                    tr.appendChild(tdStatusProgress);
                    tbody.appendChild(tr);
                });
            });
        }

        async function saveCarrierUpdates(carriers) {
            const carriersToDelete = carriers.filter(({ company, state, status }) => {
                return !status || status === "Release";
            });

            const carriersToUpdate = carriers.filter(({ company, state, status }) => {
                return status && status !== "Release" && !carriersToDelete.some(c => c.company === company && c.state === state);
            });

            await Promise.all(carriersToDelete.map(async (carrier) => {
                try {
                    const res = await deleteCarrier(carrier.id);
                    if (!res.ok) {
                        alert("Failed to delete carrier: " + carrier.company);
                    }
                } catch (err) {
                    alert("Error deleting carrier: " + err.message);
                }
            }));

            const updates = carriersToUpdate.map(({ company, state, status }) => ({
                company,
                state,
                status,
            }));

            const response = await fetch("/users/carrrier_status", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    updates,
                    userId: profile.user_id,
                }),
            });

            const result = await response.json();
            if (!result.success) {
                alert("Error when updating status: " + result.message);
            }
            const filteredCarriers = carriers.filter(c =>
                !carriersToDelete.some(d => d.company === c.company && d.state === c.state)
            );

            return filteredCarriers;
        }

        async function deleteCarrier(id) {
            return await fetch(`/users/profile/carrier/${id}`, {
                method: "DELETE",
                headers: {
                    "Content-Type": "application/json",
                },
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            carriersData = JSON.parse(document.getElementById("carriers-data").textContent);
            renderCarrierTable(carriersData);

            const editButton = document.getElementById("edit-toggle");

            editButton.addEventListener("click", async () => {
                if (!isEditing) {
                    isEditing = true;
                    editButton.classList.remove("ti-edit", "text-danger");
                    editButton.classList.add("ti-device-floppy", "text-primary");
                    editButton.setAttribute("title", "Save changes");
                    renderCarrierTable(carriersData);
                } else {
                    isEditing = false;
                    editButton.classList.remove("ti-device-floppy", "text-primary");
                    editButton.classList.add("ti-edit", "text-danger");
                    editButton.setAttribute("title", "Edit Status");
                    carriersData = await saveCarrierUpdates(carriersData);
                    renderCarrierTable(carriersData);
                }
            });
        });
    </script>

