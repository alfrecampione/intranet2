    <script>
        const data = JSON.parse(document.getElementById('user-data').textContent);
        const list = document.getElementById('user-info-list');
        const agencies = JSON.parse(document.getElementById('agencies-data').textContent);

        function addSectionHeader(title, sectionKey) {
            const header = document.createElement('li');
            header.className = 'fw-bold mt-3 mb-2 d-flex align-items-center justify-content-between';

            const text = document.createElement('span');
            text.textContent = title;

            const editIcon = document.createElement('i');
            editIcon.className = 'ti ti-edit';
            editIcon.style.cursor = 'pointer';
            editIcon.title = 'Edit Section';

            let editing = false;

            editIcon.addEventListener('click', async () => {
                const sectionItems = list.querySelectorAll(`li[data-section="${sectionKey}"] span[data-value]`);

                if (!editing) {
                    for (const span of sectionItems) {
                        const li = span.closest('li');
                        const fieldName = li.dataset.field;
                        let currentValue;
                        const sensitiveSpan = span.querySelector?.('span[data-full]');
                        if (sensitiveSpan) {
                            currentValue = sensitiveSpan.dataset.full || '';
                        } else {
                            currentValue = span.textContent;
                        }

                        let input;

                        // Agency
                        if (fieldName === 'agency') {
                            input = document.createElement('select');
                            input.className = 'form-select form-select-sm';
                            input.dataset.original = currentValue;

                            const noneOption = document.createElement('option');
                            noneOption.value = '';
                            noneOption.textContent = 'None';
                            if (!currentValue || currentValue === 'None') noneOption.selected = true;
                            input.appendChild(noneOption);

                            agencies.forEach(a => {
                                const option = document.createElement('option');
                                option.value = a.id;
                                option.textContent = a.name;
                                if (personalInfo.agency == a.id) option.selected = true;
                                input.appendChild(option);
                            });
                        }

                        // State (contactInfo)
                        else if (fieldName === 'state' && sectionKey === 'contactInfo') {
                            input = document.createElement('select');
                            input.className = 'form-select form-select-sm';
                            input.dataset.original = currentValue;
                            const US_STATES = [
                                { name: "Alabama", abbr: "AL" }, { name: "Alaska", abbr: "AK" }, { name: "Arizona", abbr: "AZ" },
                                { name: "Arkansas", abbr: "AR" }, { name: "California", abbr: "CA" }, { name: "Colorado", abbr: "CO" },
                                { name: "Connecticut", abbr: "CT" }, { name: "Delaware", abbr: "DE" }, { name: "Florida", abbr: "FL" },
                                { name: "Georgia", abbr: "GA" }, { name: "Hawaii", abbr: "HI" }, { name: "Idaho", abbr: "ID" },
                                { name: "Illinois", abbr: "IL" }, { name: "Indiana", abbr: "IN" }, { name: "Iowa", abbr: "IA" },
                                { name: "Kansas", abbr: "KS" }, { name: "Kentucky", abbr: "KY" }, { name: "Louisiana", abbr: "LA" },
                                { name: "Maine", abbr: "ME" }, { name: "Maryland", abbr: "MD" }, { name: "Massachusetts", abbr: "MA" },
                                { name: "Michigan", abbr: "MI" }, { name: "Minnesota", abbr: "MN" }, { name: "Mississippi", abbr: "MS" },
                                { name: "Missouri", abbr: "MO" }, { name: "Montana", abbr: "MT" }, { name: "Nebraska", abbr: "NE" },
                                { name: "Nevada", abbr: "NV" }, { name: "New Hampshire", abbr: "NH" }, { name: "New Jersey", abbr: "NJ" },
                                { name: "New Mexico", abbr: "NM" }, { name: "New York", abbr: "NY" }, { name: "North Carolina", abbr: "NC" },
                                { name: "North Dakota", abbr: "ND" }, { name: "Ohio", abbr: "OH" }, { name: "Oklahoma", abbr: "OK" },
                                { name: "Oregon", abbr: "OR" }, { name: "Pennsylvania", abbr: "PA" }, { name: "Rhode Island", abbr: "RI" },
                                { name: "South Carolina", abbr: "SC" }, { name: "South Dakota", abbr: "SD" }, { name: "Tennessee", abbr: "TN" },
                                { name: "Texas", abbr: "TX" }, { name: "Utah", abbr: "UT" }, { name: "Vermont", abbr: "VT" },
                                { name: "Virginia", abbr: "VA" }, { name: "Washington", abbr: "WA" }, { name: "West Virginia", abbr: "WV" },
                                { name: "Wisconsin", abbr: "WI" }, { name: "Wyoming", abbr: "WY" }
                            ];
                            const noneOption = document.createElement('option');
                            noneOption.value = '';
                            noneOption.textContent = 'None';
                            if (!currentValue || currentValue === 'None') noneOption.selected = true;
                            input.appendChild(noneOption);
                            US_STATES.forEach(st => {
                                const option = document.createElement('option');
                                option.value = st.abbr;
                                option.textContent = st.name;
                                if (currentValue === st.abbr || currentValue === st.name) option.selected = true;
                                input.appendChild(option);
                            });
                        }

                        // Documents
                        else if (sectionKey === 'documents') {
                            input = document.createElement('input');
                            input.type = 'file';
                            input.className = 'form-control form-control-sm';
                            input.dataset.original = '';
                        }

                        // Sex
                        else if (fieldName === 'legalSex') {
                            input = document.createElement('select');
                            input.className = 'form-select form-select-sm';

                            ['Male', 'Female'].forEach(opt => {
                                const option = document.createElement('option');
                                option.value = opt.toLowerCase();
                                option.textContent = opt;
                                if (currentValue?.toLowerCase() === opt.toLowerCase()) {
                                    option.selected = true;
                                }
                                input.appendChild(option);
                            });

                            input.dataset.original = currentValue?.toLowerCase() || '';
                        }

                        // Contact Type
                        else if (fieldName === 'contactType') {
                            input = document.createElement('select');
                            input.className = 'form-select form-select-sm';

                            ['Individual', 'Business'].forEach(opt => {
                                const option = document.createElement('option');
                                option.value = opt.toLowerCase();
                                option.textContent = opt;
                                if (currentValue?.toLowerCase() === opt.toLowerCase()) {
                                    option.selected = true;
                                }
                                input.appendChild(option);
                            });

                            input.dataset.original = currentValue?.toLowerCase() || '';
                        }

                        // Payment Method: Account Type
                        else if (fieldName === 'bankAccountType' && sectionKey === 'paymentMethod') {
                            input = document.createElement('select');
                            input.className = 'form-select form-select-sm';
                            input.dataset.original = currentValue;

                            ['Savings', 'Checking'].forEach(opt => {
                                const option = document.createElement('option');
                                option.value = opt.toLowerCase();
                                option.textContent = opt;
                                if (currentValue?.toLowerCase() === opt.toLowerCase()) {
                                    option.selected = true;
                                }
                                input.appendChild(option);
                            });
                        }

                        // Payment Method: Account Number
                        else if (fieldName === 'bankAccountNum' && sectionKey === 'paymentMethod') {
                            input = document.createElement('input');
                            input.type = 'text';
                            input.inputMode = 'numeric';
                            input.pattern = '\\d*';
                            input.maxLength = 17;
                            input.value = currentValue === 'None' ? '' : currentValue;
                            input.required = true;
                            input.dataset.original = input.value;
                            input.className = 'form-control form-control-sm';
                            input.addEventListener('input', function () {
                                this.value = this.value.replace(/[^0-9]/g, '');
                            });
                        }

                        // Payment Method: Routing Number
                        else if (fieldName === 'bankRoutingNum' && sectionKey === 'paymentMethod') {
                            input = document.createElement('input');
                            input.type = 'text';
                            input.inputMode = 'numeric';
                            input.pattern = '\\d*';
                            input.maxLength = 9;
                            input.value = currentValue === 'None' ? '' : currentValue;
                            input.required = true;
                            input.dataset.original = input.value;
                            input.className = 'form-control form-control-sm';
                            input.addEventListener('input', function () {
                                this.value = this.value.replace(/[^0-9]/g, '');
                            });
                        }

                        // Default input
                        else {
                            input = document.createElement('input');
                            input.value = currentValue === 'None' ? '' : currentValue;
                            input.dataset.original = input.value;
                            input.className = 'form-control form-control-sm';

                            if (fieldName === 'npn') {
                                input.type = 'text';
                                input.inputMode = 'numeric';
                                input.pattern = '\\d*';
                                input.maxLength = 10;
                                input.addEventListener('input', function () {
                                    this.value = this.value.replace(/[^0-9]/g, '');
                                });
                            } else if (fieldName === 'dateOfBirth') {
                                input.type = 'date';
                                const dobRaw = personalInfo?.dateOfBirth ? personalInfo.dateOfBirth.split("T")[0] : '';
                                input.value = dobRaw;
                            } else if (fieldName === 'personalEmail') {
                                input.type = 'email';
                            } else if (fieldName === 'zipCode') {
                                input.type = 'text';
                                input.inputMode = 'numeric';
                                input.pattern = '\\d*';
                                input.maxLength = 10;
                                input.addEventListener('input', function () {
                                    this.value = this.value.replace(/[^0-9]/g, '');
                                });
                            } else if (fieldName === 'ssn') {
                                input.type = 'text';
                                input.inputMode = 'numeric';
                                input.pattern = '\\d*';
                                input.maxLength = 9;
                                input.addEventListener('input', function () {
                                    this.value = this.value.replace(/[^0-9]/g, '');
                                });
                            } else if (fieldName === 'companyEIN') {
                                input.type = 'text';
                                input.inputMode = 'numeric';
                                input.pattern = '\\d{9}';
                                input.maxLength = 9;
                                input.addEventListener('input', function () {
                                    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 9);
                                });
                            } else {
                                input.type = 'text';
                            }
                        }

                        span.replaceWith(input);
                    }

                    if (sectionKey === 'personalInfo') {
                        const contactTypeSelect = list.querySelector('li[data-field="contactType"] select');
                        const businessNameLi = list.querySelector('li[data-field="businessName"]');
                        const companyEinLi = list.querySelector('li[data-field="companyEIN"]');

                        function toggleBusinessFields() {
                            const isBusiness = contactTypeSelect.value.toLowerCase() === 'business';
                            if (businessNameLi) businessNameLi.classList.toggle('d-none', !isBusiness);
                            if (companyEinLi) companyEinLi.classList.toggle('d-none', !isBusiness);
                        }

                        if (contactTypeSelect) {
                            contactTypeSelect.addEventListener('change', toggleBusinessFields);
                            toggleBusinessFields();
                        }
                    }

                    editIcon.className = 'ti ti-device-floppy';
                    editing = true;

                } else {
                    const inputs = list.querySelectorAll(`li[data-section="${sectionKey}"] input, li[data-section="${sectionKey}"] select`);
                    const updatedValues = {};
                    let hasEmpty = false;

                    let contactTypeValue = null;
                    let businessNameInput = null;
                    let companyEinInput = null;

                    if (sectionKey === 'personalInfo') {
                        for (const input of inputs) {
                            const fieldName = input.closest('li').dataset.field;
                            if (fieldName === 'contactType') contactTypeValue = input.value;
                            if (fieldName === 'businessName') businessNameInput = input;
                            if (fieldName === 'companyEIN') companyEinInput = input;
                        }
                    }

                    for (const input of inputs) {
                        const fieldName = input.closest('li').dataset.field;
                        const originalValue = input.dataset.original;

                        if (
                            sectionKey === 'personalInfo' &&
                            contactTypeValue === 'individual' &&
                            (fieldName === 'businessName' || fieldName === 'companyEIN')
                        ) {
                            input.classList.remove('is-invalid');
                            continue;
                        }

                        const optionalFields = ['agency', 'businessName', 'companyEIN'];

                        if (
                            input.type !== 'file' &&
                            (!input.value || input.value.trim() === '') &&
                            !optionalFields.includes(fieldName)
                        ) {
                            hasEmpty = true;
                            input.classList.add('is-invalid');
                        } else {
                            input.classList.remove('is-invalid');
                        }

                        if (input.type === 'file' && input.files.length > 0) {
                            const formData = new FormData();
                            formData.append('file', input.files[0]);

                            const uploadRes = await fetch('/upload', {
                                method: 'POST',
                                body: formData
                            });

                            const uploadData = await uploadRes.json();
                            if (uploadData.path) {
                                updatedValues[fieldName] = uploadData.path;
                            } else {
                                showToast('Error', `Error uploading document: ${fieldName}`);
                            }
                        }
                        else {
                            const newValue = input.value || null;
                            if (newValue !== originalValue) {
                                updatedValues[fieldName] = newValue;
                            }
                        }

                        const span = document.createElement('span');
                        span.dataset.value = 'true';

                        // Mask sensitive fields (payment info + ssn)
                        if (
                            (sectionKey === 'paymentMethod' && (fieldName === 'bankAccountNum' || fieldName === 'bankRoutingNum')) ||
                            fieldName === 'ssn'
                        ) {
                            const hiddenValue = input.value ? '*'.repeat(input.value.length) : '****';
                            const visibleValue = input.value || 'None';

                            const sensitiveSpan = document.createElement('span');
                            sensitiveSpan.textContent = hiddenValue;
                            sensitiveSpan.dataset.visible = 'false';
                            sensitiveSpan.dataset.full = visibleValue;

                            const toggleIcon = document.createElement('i');
                            toggleIcon.className = 'ti ti-eye ms-2';
                            toggleIcon.style.cursor = 'pointer';
                            toggleIcon.setAttribute('aria-hidden', 'true');
                            toggleIcon.title = 'Show/Hide';

                            toggleIcon.addEventListener('click', () => {
                                const isVisible = sensitiveSpan.dataset.visible === 'true';
                                sensitiveSpan.textContent = isVisible ? hiddenValue : visibleValue;
                                sensitiveSpan.dataset.visible = (!isVisible).toString();
                                toggleIcon.className = isVisible ? 'ti ti-eye ms-2' : 'ti ti-eye-off ms-2';
                            });

                            span.appendChild(sensitiveSpan);
                            span.appendChild(toggleIcon);
                        } else {
                            span.textContent = input.type === 'file'
                                ? (input.files[0]?.name || 'None')
                                : (input.value || 'None');
                        }

                        input.replaceWith(span);
                    }

                    if (sectionKey === 'personalInfo' && contactTypeValue === 'individual') {
                        updatedValues['businessName'] = null;
                        updatedValues['companyEIN'] = null;
                        if (businessNameInput) businessNameInput.value = '';
                        if (companyEinInput) companyEinInput.value = '';
                    }

                    if (hasEmpty) {
                        alert('All required fields must be filled out.');
                        return;
                    }

                    if (Object.keys(updatedValues).length > 0) {
                        const response = await fetch("/users/profile/save-section", {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                userId: profile.user_id,
                                sectionKey: sectionKey,
                                values: updatedValues
                            })
                        });

                        const result = await response.json();
                        if (!result.success) {
                            showToast("Error", "Error saving data.");
                        } else {
                            showToast("Success", "Profile updated successfully.");
                            location.reload();
                        }
                    }

                    editIcon.className = 'ti ti-edit';
                    editing = false;
                }
            });

            header.appendChild(text);
            header.appendChild(editIcon);
            list.appendChild(header);
        }

        function addListItem(label, value, fieldName, isLink = false, isSensitive = false, sectionKey = '', hidden = false) {
            const li = document.createElement('li');
            li.className = 'mb-2' + (hidden ? ' d-none' : '');
            li.dataset.section = sectionKey;
            li.dataset.label = label;
            li.dataset.field = fieldName;

            const wrapper = document.createElement('div');
            wrapper.className = 'd-flex align-items-center';

            const labelSpan = document.createElement('span');
            labelSpan.className = 'h6 me-2 mb-0';
            labelSpan.textContent = `${label}:`;

            const contentSpan = document.createElement('span');
            contentSpan.className = 'mb-0';
            contentSpan.dataset.value = 'true';

            if (isLink && value) {
                const fullUrl = `${window.location.protocol}//${window.location.host}/${value}`;
                const link = document.createElement('a');
                link.href = fullUrl;
                link.textContent = 'View Document';
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                contentSpan.appendChild(link);
            } else if (isSensitive) {
                const hiddenValue = value ? '*'.repeat(value.length) : '****';
                const visibleValue = value || 'None';
                const sensitiveSpan = document.createElement('span');
                sensitiveSpan.textContent = hiddenValue;
                sensitiveSpan.dataset.visible = 'false';
                sensitiveSpan.dataset.full = visibleValue;

                const toggleIcon = document.createElement('i');
                toggleIcon.className = 'ti ti-eye ms-2';
                toggleIcon.style.cursor = 'pointer';
                toggleIcon.setAttribute('aria-hidden', 'true');
                toggleIcon.title = 'Show/Hide';

                toggleIcon.addEventListener('click', () => {
                    const isVisible = sensitiveSpan.dataset.visible === 'true';
                    sensitiveSpan.textContent = isVisible ? hiddenValue : visibleValue;
                    sensitiveSpan.dataset.visible = (!isVisible).toString();
                    toggleIcon.className = isVisible ? 'ti ti-eye ms-2' : 'ti ti-eye-off ms-2';
                });

                contentSpan.appendChild(sensitiveSpan);
                contentSpan.appendChild(toggleIcon);
            } else {
                contentSpan.textContent = value || 'None';
            }

            wrapper.appendChild(labelSpan);
            wrapper.appendChild(contentSpan);
            li.appendChild(wrapper);
            list.appendChild(li);
        }

        const { personalInfo, contactInfo, paymentMethod, documents, necesaryDocs } = data;

        // ... Personal Info ...
        let sectionKey = 'personalInfo';
        addSectionHeader('Personal Info', sectionKey);
        addListItem('Preferred Name', personalInfo.preferredName, 'preferredName', false, false, sectionKey);
        addListItem('Contact Type', personalInfo.contactType, 'contactType', false, false, sectionKey);
        const isBusiness = personalInfo?.contactType?.toLowerCase() === 'business';
        addListItem('Business Name', personalInfo.businessName, 'businessName', false, false, sectionKey, !isBusiness);
        addListItem('Company EIN', personalInfo.companyEIN, 'companyEIN', false, false, sectionKey, !isBusiness);
        const dobRaw = personalInfo.dateOfBirth ? personalInfo.dateOfBirth.split("T")[0] : null;
        addListItem('DoB', dobRaw, 'dateOfBirth', false, false, sectionKey);
        addListItem('Sex', personalInfo.legalSex, 'legalSex', false, false, sectionKey);
        addListItem('NPN', personalInfo.npn, 'npn', false, false, sectionKey);
        addListItem('SSN', personalInfo.ssn, 'ssn', false, true, sectionKey);
        addListItem('Agency',
            agencies?.find(a => a.id == personalInfo.agency)?.name || 'None',
            'agency',
            false, false, sectionKey
        );

        // Contact Info
        sectionKey = 'contactInfo';
        addSectionHeader('Contact Info', sectionKey);
        addListItem('Email', contactInfo.personalEmail, 'personalEmail', false, false, sectionKey);
        addListItem('State', contactInfo.state, 'state', false, false, sectionKey);
        addListItem('City', contactInfo.city, 'city', false, false, sectionKey);
        addListItem('Address', contactInfo.addressLine1, 'addressLine1', false, false, sectionKey);
        addListItem('Zip Code', contactInfo.zipCode, 'zipCode', false, false, sectionKey);

        // Payment Method
        sectionKey = 'paymentMethod';
        addSectionHeader('Payment Method', sectionKey);
        addListItem('Account Type', paymentMethod.bankAccountType, 'bankAccountType', false, false, sectionKey);
        addListItem('Account Number', paymentMethod.bankAccountNum, 'bankAccountNum', false, true, sectionKey);
        addListItem('Routing Number', paymentMethod.bankRoutingNum, 'bankRoutingNum', false, false, sectionKey);

        // Documents
        const documentFields = [
            { key: 'directDepositForm', label: 'Direct Deposit Form' },
            { key: 'driverLicense', label: 'Driver License' },
            { key: 'EINconfirmation', label: 'EIN Confirmation' },
            { key: 'eANDo', label: 'E&O' },
            { key: 'proLicense', label: 'Pro License' },
            { key: 'corporationLicense', label: 'Corporation License' },
            { key: 'ffmCertification', label: 'FFM Certification' },
            { key: 'gaCertification', label: 'GA Certification' },
            { key: 'gaLicense', label: 'GA License' },
            { key: 'sunbiz', label: 'Sunbiz' },
            { key: 'taxIdentificationW9', label: 'Tax ID (W9)' }
        ];

        sectionKey = 'documents';
        addSectionHeader('Documents', sectionKey);
        documentFields.forEach(({ key, label }) => {
            const isRequired = necesaryDocs?.[key];
            if (isRequired) {
                const filePath = documents?.[key];
                if (filePath) {
                    addListItem(label, filePath, key, true, false, sectionKey);
                } else {
                    addListItem(label, 'Missing', key, false, false, sectionKey);
                }
            }
        });
    </script>
    <!-- /User Data-->

    <!-- Timeline-->
    <script id="activity-data" type="application/json">
      <%- JSON.stringify(activity) %>
    </script>

    <script>
        function renderTimeLine(timelineItems) {
            const ul = document.querySelector('#user-activity-timeline');
            if (!ul) return;

            ul.innerHTML = '';

            timelineItems.forEach(item => {
                const li = document.createElement('li');
                li.className = 'timeline-item timeline-item-transparent';

                const point = document.createElement('span');
                point.className = `timeline-point timeline-point-${item.variant || 'primary'}`;
                li.appendChild(point);

                const event = document.createElement('div');
                event.className = 'timeline-event';
                li.appendChild(event);

                const header = document.createElement('div');
                header.className = 'timeline-header mb-3';

                const h6 = document.createElement('h6');
                h6.className = 'mb-0';
                h6.textContent = item.title || '';

                const small = document.createElement('small');
                small.className = 'text-muted';
                small.textContent = item.timeAgo || '';

                header.appendChild(h6);
                header.appendChild(small);
                event.appendChild(header);

                if (item.description) {
                    const pre = document.createElement('pre'); // preserves \n
                    pre.className = 'mb-2';
                    pre.style.whiteSpace = 'pre-wrap';
                    pre.textContent = typeof item.description === 'string'
                        ? item.description
                        : JSON.stringify(item.description, null, 2);
                    event.appendChild(pre);
                }

                ul.appendChild(li);
            });
        }

        const activityData = JSON.parse(document.getElementById("activity-data").textContent);
        renderTimeLine(activityData);
    </script>
    <!-- /Timeline-->
</body>

</html>