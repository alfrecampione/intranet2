        <script src="/vendor/libs/moment/moment.js"></script>
        <script src="/vendor/libs/flatpickr/flatpickr.js"></script>
        <!-- Form Validation -->
        <script src="/vendor/libs/@form-validation/popular.js"></script>
        <script src="/vendor/libs/@form-validation/bootstrap5.js"></script>
        <script src="/vendor/libs/@form-validation/auto-focus.js"></script>

        <!-- Main JS -->
        <script src="/js/main.js"></script>

        <script type="application/json" id="companies-data">
            <%- JSON.stringify(companies) %>
        </script>

        <script>
            $(document).ready(function () {
                $('#select2Primary').select2({
                    placeholder: "Select state(s)",
                    width: '100%',
                    dropdownParent: $('#add-new-record')
                });

                $('#companySelect').select2({
                    placeholder: "Select a carrier",
                    width: '100%',
                    dropdownParent: $('#add-new-record')
                });
            });
        </script>

        <script>
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(el => new bootstrap.Tooltip(el))
        </script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const searchInput = document.querySelector('#DataTables_Table_0_filter input[type="search"]');
                const table = document.getElementById("DataTables_Table_0");
                const rows = table.querySelectorAll("tbody tr");

                searchInput.addEventListener("input", function () {
                    const query = this.value.toLowerCase();

                    rows.forEach(row => {
                        const cells = Array.from(row.querySelectorAll("td"));
                        const text = cells.map(cell => cell.textContent.toLowerCase()).join(" ");
                        const matches = text.includes(query);
                        row.style.display = matches ? "" : "none";
                    });
                });
            });
        </script>

        <script>
            let editingCompany = null;

            document.addEventListener("DOMContentLoaded", function () {
                // Edit
                document.querySelectorAll(".edit-company-btn").forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        editingCompany = {
                            id: btn.getAttribute("data-company-id"),
                            name: btn.getAttribute("data-company")
                        };

                        // Disable company select when editing (can't change the company)
                        const companySelect = document.getElementById("companySelect");
                        const externalId = btn.getAttribute("data-external-id");

                        // Ensure the option exists and is selected for the current company
                        if (externalId) {
                            let option = companySelect.querySelector(`option[value="${externalId}"]`);
                            if (!option) {
                                option = document.createElement("option");
                                option.value = externalId;
                                option.textContent = editingCompany.name;
                                companySelect.appendChild(option);
                            }
                            option.selected = true;
                            if ($(companySelect).data('select2')) {
                                $(companySelect).trigger('change');
                            }
                        }
                        companySelect.disabled = true;

                        const states = JSON.parse(btn.getAttribute("data-states") || "[]");
                        const select = document.getElementById("select2Primary");
                        Array.from(select.options).forEach(opt => {
                            opt.selected = states.includes(opt.value);
                        });

                        if ($(select).data('select2')) {
                            $(select).trigger('change');
                        }
                        const submitBtn = document.getElementById("addCompanyBtn");
                        submitBtn.textContent = "Save";
                        submitBtn.classList.add("btn-warning");
                        submitBtn.classList.remove("btn-primary");

                        const offcanvas = document.getElementById("add-new-record");
                        if (offcanvas) {
                            const bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvas);
                            bsOffcanvas.show();
                        }
                    });
                });

                // Handler Add/Edit
                document.getElementById("addCompanyBtn").addEventListener("click", async function (e) {
                    e.preventDefault();

                    const companySelect = document.getElementById("companySelect");
                    const select = document.getElementById("select2Primary");
                    const states = Array.from(select.selectedOptions).map(option => option.value);

                    if (!states.length) {
                        alert("Please select at least one state.");
                        return;
                    }

                    // Edit
                    if (editingCompany) {
                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "PUT",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    companyId: editingCompany.id,
                                    states
                                })
                            });

                            if (!response.ok) {
                                throw new Error("Error updating company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error updating company: " + err.message);
                        }
                        return;
                    }
                    else {
                        // ADD
                        const entity_id = parseInt(companySelect.value);

                        if (!entity_id) {
                            alert("Please select a carrier.");
                            return;
                        }

                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ entity_id, states })
                            });

                            if (!response.ok) {
                                throw new Error("Error adding company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error adding company: " + err.message);
                        }
                    }
                });

                // Reset
                document.querySelectorAll('[data-bs-dismiss="offcanvas"]').forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        editingCompany = null;
                        const submitBtn = document.getElementById("addCompanyBtn");
                        submitBtn.textContent = "Add";
                        submitBtn.classList.remove("btn-warning");
                        submitBtn.classList.add("btn-primary");

                        const companySelect = document.getElementById("companySelect");
                        companySelect.disabled = false;
                        companySelect.value = "";
                        $('#companySelect').trigger('change');

                        const select = document.getElementById("select2Primary");
                        Array.from(select.options).forEach(opt => opt.selected = false);
                        if ($(select).data('select2')) {
                            $(select).trigger('change');
                        }
                    });
                });

                // Handler Delete
                document.querySelectorAll(".delete-email-btn").forEach(function (btn) {
                    btn.addEventListener("click", async function () {
                        const companyId = this.getAttribute("data-company-id");
                        if (!companyId) return;

                        if (!confirm("Are you sure you want to delete this company?")) return;

                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "DELETE",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ companyId })
                            });

                            if (!response.ok) {
                                throw new Error("Error deleting company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error deleting company: " + err.message);
                        }
                    });
                });
            });
        </script>
</body>

</html>