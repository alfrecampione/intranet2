        <script>
            function formatUSPhone(value) {
                let digits = value.replace(/\D/g, "");
                digits = digits.substring(0, 10);
                if (digits.length > 6) {
                    return `(${digits.substring(0, 3)}) ${digits.substring(3, 6)}-${digits.substring(6)}`;
                } else if (digits.length > 3) {
                    return `(${digits.substring(0, 3)}) ${digits.substring(3)}`;
                } else if (digits.length > 0) {
                    return `(${digits}`;
                }
                return "";
            }

            function isValidUSPhone(phone) {
                return /^\([2-9][0-9]{2}\) [0-9]{3}-[0-9]{4}$/.test(phone);
            }

            let editingCompany = null;

            document.addEventListener("DOMContentLoaded", function () {
                const phoneInput = document.getElementById("companyPhoneInput");
                phoneInput.addEventListener("input", function (e) {
                    const formatted = formatUSPhone(this.value);
                    this.value = formatted;
                });

                // Edit
                document.querySelectorAll(".edit-company-btn").forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        editingCompany = btn.getAttribute("data-company");
                        document.getElementById("companyNameInput").value = btn.getAttribute("data-company");
                        document.getElementById("companyPhoneInput").value = btn.getAttribute("data-phone");

                        const states = JSON.parse(btn.getAttribute("data-states") || "[]");
                        const select = document.getElementById("select2Primary");
                        Array.from(select.options).forEach(opt => {
                            opt.selected = states.includes(opt.value);
                        });

                        if ($(select).data('select2')) {
                            $(select).trigger('change');
                        }
                        const submitBtn = document.getElementById("addCompanyBtn");
                        submitBtn.textContent = "Edit";
                        submitBtn.classList.add("btn-warning");
                        submitBtn.classList.remove("btn-primary");

                        const offcanvas = document.getElementById("add-new-record");
                        if (offcanvas) {
                            const bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvas);
                            bsOffcanvas.show();
                        }
                    });
                });

                // Handler Add/Edit
                document.getElementById("addCompanyBtn").addEventListener("click", async function (e) {
                    e.preventDefault();

                    const companyNameInput = document.getElementById("companyNameInput");
                    const companyName = companyNameInput.value.trim();
                    const companyPhoneInput = document.getElementById("companyPhoneInput");
                    const companyPhone = companyPhoneInput.value.trim();
                    const companyEmailInput = document.getElementById("companyEmailInput");
                    const companyEmail = companyEmailInput.value.trim();
                    const select = document.getElementById("select2Primary");
                    const states = Array.from(select.selectedOptions).map(option => option.value);

                    if (!companyName) {
                        alert("Please enter the company name.");
                        return;
                    }

                    if (!isValidUSPhone(companyPhone)) {
                        alert("Please enter a valid US phone number (e.g. (555) 123-4567).");
                        companyPhoneInput.focus();
                        return;
                    }

                    if (!states.length) {
                        alert("Please select at least one state.");
                        return;
                    }

                    // Edit
                    if (editingCompany) {
                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "PUT",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    originalName: editingCompany,
                                    name: companyName,
                                    phone: companyPhone,
                                    states
                                })
                            });

                            if (!response.ok) {
                                throw new Error("Error updating company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error updating company: " + err.message);
                        }
                        return;
                    }
                    else {
                        // ADD
                        const existingCompanies = Array.from(document.querySelectorAll("table .delete-email-btn"))
                            .map(btn => btn.getAttribute("data-company"));

                        if (existingCompanies.includes(companyName)) {
                            alert("This company already exists in the list.");
                            return;
                        }

                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ name: companyName, phone: companyPhone, states })
                            });

                            if (!response.ok) {
                                throw new Error("Error adding company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error adding company: " + err.message);
                        }
                    }
                });

                // Reset
                document.querySelectorAll('[data-bs-dismiss="offcanvas"]').forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        editingCompany = null;
                        const submitBtn = document.getElementById("addCompanyBtn");
                        submitBtn.textContent = "Add";
                        submitBtn.classList.remove("btn-warning");
                        submitBtn.classList.add("btn-primary");
                        document.getElementById("companyNameInput").value = "";
                        document.getElementById("companyPhoneInput").value = "";
                        document.getElementById("companyEmailInput").value = "";
                        const select = document.getElementById("select2Primary");
                        Array.from(select.options).forEach(opt => opt.selected = false);
                        if ($(select).data('select2')) {
                            $(select).trigger('change');
                        }
                    });
                });

                // Handler Delete
                document.querySelectorAll(".delete-email-btn").forEach(function (btn) {
                    btn.addEventListener("click", async function () {
                        const companyName = this.getAttribute("data-company");
                        if (!companyName) return;

                        if (!confirm("Are you sure you want to delete this company?")) return;

                        try {
                            const response = await fetch(`${url}/users/config_carriers`, {
                                method: "DELETE",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ name: companyName })
                            });

                            if (!response.ok) {
                                throw new Error("Error deleting company");
                            }

                            location.reload();
                        } catch (err) {
                            alert("Error deleting company: " + err.message);
                        }
                    });
                });
            });
        </script>
</body>

</html>