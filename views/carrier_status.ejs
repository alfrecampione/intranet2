    <script>
        function renderTable(carriers) {
            const table = document.querySelector(".datatables-basic");
            const tbody = table.querySelector("tbody");
            tbody.innerHTML = "";

            if (carriers.length === 0) {
                const tr = document.createElement("tr");
                tr.innerHTML = `<td valign="top" colspan="4" class="dataTables_empty">No carriers found.</td>`;
                tbody.appendChild(tr);
                return;
            }

            const grouped = carriers.reduce((acc, carrier) => {
                const key = carrier.state;
                if (!acc[key]) acc[key] = [];
                acc[key].push(carrier);
                return acc;
            }, {});

            let rowIndex = 1;

            Object.entries(grouped).forEach(([stateName, carriersInState]) => {
                carriersInState.forEach((carrier, i) => {
                    const tr = document.createElement("tr");

                    if (i === 0) {
                        const tdIndex = document.createElement("td");
                        tdIndex.textContent = rowIndex++;
                        tdIndex.rowSpan = carriersInState.length;
                        tr.appendChild(tdIndex);

                        const tdState = document.createElement("td");
                        tdState.textContent = stateName;
                        tdState.rowSpan = carriersInState.length;
                        tr.appendChild(tdState);
                    }

                    const tdName = document.createElement("td");
                    tdName.textContent = carrier.company;
                    tr.appendChild(tdName);

                    const tdStatus = document.createElement("td");
                    const statusOptions = ["Request Received from Agent", "Pending Submission", "Submitted to Carrier", "Carrier In Review", "Carrier Sent Contract to Agent", "Ready to Sell", "Rejected by Carrier", "Withdrawn by Agent", "Need Release"];
                    const currentStatus = carrier.status || "Request Received from Agent";

                    const optionsHTML = statusOptions.map(status => {
                        const selected = status === currentStatus ? "selected" : "";
                        return `<option value="${status}" ${selected}>${status}</option>`;
                    }).join("");

                    tdStatus.innerHTML = `
                    <select name="${carrier.company}-${carrier.state}" class="form-select form-select-sm">
                        ${optionsHTML}
                    </select>
                `;

                    tr.appendChild(tdStatus);
                    tbody.appendChild(tr);
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const carriers = JSON.parse(document.getElementById("carriers-data").textContent);
            renderTable(carriers);
        });
    </script>

