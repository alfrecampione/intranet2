    <script>
        function showToast(headerText, bodyText) {
            const toast = document.querySelector('.toast-ex1');
            toast.querySelector('.toast-header small').textContent = headerText;
            toast.querySelector('.toast-body').textContent = bodyText;
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("submitBtn")?.addEventListener("click", async function () {
                document.getElementById("email-overlay").style.display = "flex";

                const table = document.getElementById("DataTables_Table_0");
                const rows = table.querySelectorAll("tbody tr");
                const updates = [];

                rows.forEach(row => {
                    const select = row.querySelector("select");
                    if (select) {
                        const [company, state] = select.name.split("-");
                        const status = select.value;
                        updates.push({ company, state, status });
                    }
                });

                const userId = JSON.parse(document.getElementById("userID-data").textContent);

                try {
                    const response = await fetch("/users/carrrier_status", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ userId, updates })
                    });

                    if (response.ok) {
                        showToast("Success", "Carrier statuses updated successfully.");
                    } else {
                        showToast("Error", "Failed to update carrier statuses.");
                    }
                } catch (err) {
                    showToast("Error", "Network error while updating statuses.");
                } finally {
                    document.getElementById("email-overlay").style.display = "none";
                }
            });
        });
    </script>
