                    </div>
                </nav>

                <!-- / Navbar -->

                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <!-- Content -->

                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="nav-align-top mb-3">
                            <ul class="nav nav-pills flex-column flex-md-row mb-6 gap-2 gap-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link" href="/users/config_emails"><i
                                            class="ti-sm ti ti-mail me-1_5"></i> Notification Emails</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/users/config_carriers"><i
                                            class="ti-sm ti ti-truck me-1_5"></i>
                                        Carriers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link active" href="javascript:void(0);"><i
                                            class="ti-sm ti ti-table me-1_5"></i>
                                        Commisions</a>
                                </li>
                            </ul>
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <div class="table-responsive" style="overflow-x: auto;">
                                    <table class="table table-bordered align-middle text-center"
                                        style="min-width: 1000px; table-layout: fixed;">
                                        <thead>
                                            <tr>
                                                <th style="width: 150px;">State \ Carrier</th>
                                                <% companies.forEach(company=> { %>
                                                    <th style="width: 120px;">
                                                        <%= company.name %>
                                                    </th>
                                                    <% }); %>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% const allStates=Array.from(new Set(companies.flatMap(c=>
                                                c.States))).sort();
                                                const commissionMap = {};
                                                commisions.forEach(c => {
                                                if (!commissionMap[c.company]) commissionMap[c.company] = {};
                                                commissionMap[c.company][c.state] = c.amount;
                                                });
                                                %>
                                                <% allStates.forEach(state=> { %>
                                                    <tr>
                                                        <th style="width: 150px;">
                                                            <%= state %>
                                                        </th>
                                                        <% companies.forEach(company=> {
                                                            const hasState = Array.isArray(company.States) &&
                                                            company.States.includes(state);
                                                            let value = "";
                                                            if (hasState && commissionMap[company.name] &&
                                                            commissionMap[company.name][state] != null) {
                                                            value = commissionMap[company.name][state];
                                                            }
                                                            %>
                                                            <td style="width: 120px;">
                                                                <% if (hasState) { %>
                                                                    <input type="number"
                                                                        class="form-control form-control-sm text-center commission-input"
                                                                        name="commission[<%= company.name %>][<%= state %>]"
                                                                        placeholder="%" min="0" max="100"
                                                                        style="width: 70px; display: inline-block;"
                                                                        value="<%= value %>" />
                                                                    <% } else { %>
                                                                        <span class="text-muted">N/A</span>
                                                                        <% } %>
                                                            </td>
                                                            <% }); %>
                                                    </tr>
                                                    <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="content-backdrop fade"></div>
                        <button id="submitBtn" class="btn btn-primary mt-3">Save Commisions</button>
                    </div>
                </div>
