  <script src="/js/config.js"></script>
</head>

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <%- include('partials/sidebar', { user: user, activePage: activePage }) %>
        <div class="layout-page">
          <%- include('partials/navbar', {user: user}) %>
            <div class="content-wrapper">
              <div class="container-xxl flex-grow-1 container-p-y">
                <%- include('partials/config_nav', { user: user, open: open}) %>
                  <div class="card">
                    <div class="card-body">
                      <div class="table-responsive" style="overflow-x: auto;">
                        <div style="position: relative; max-height: 500px; overflow-y: auto;">
                          <table class="table table-bordered align-middle text-center"
                            style="min-width: 1000px; table-layout: fixed;">
                            <thead style="position: sticky; top: 0; background: white; z-index: 1;">
                              <tr>
                                <th style="width: 150px; position: sticky; left: 0; background: white; z-index: 2;">
                                  State \ Carrier</th>
                                <% companies.forEach(company=> { %>
                                  <th style="width: 150px;">
                                    <%= company.name %>
                                  </th>
                                  <% }); %>
                              </tr>
                            </thead>
                            <tbody>
                              <% const allStates=Array.from(new Set(companies.flatMap(c=>
                                c.States))).sort();
                                const commissionMap = {};
                                commisions.forEach(c => {
                                if (!commissionMap[c.company]) commissionMap[c.company]
                                =
                                {};
                                commissionMap[c.company][c.state] = c.amount;
                                });
                                %>
                                <% allStates.forEach(state=> { %>
                                  <tr>
                                    <th style="width: 150px; position: sticky; left: 0; background: white; z-index: 1;">
                                      <%= state %>
                                    </th>
                                    <% companies.forEach(company=> {
                                      const hasState =
                                      Array.isArray(company.States)
                                      &&
                                      company.States.includes(state);
                                      let value = "";
                                      if (hasState && commissionMap[company.name]
                                      &&
                                      commissionMap[company.name][state] != null)
                                      {
                                      value = commissionMap[company.name][state];
                                      }
                                      %>
                                      <td style="width: 150px;">
                                        <% if (hasState) { %>
                                          <input type="number"
                                            class="form-control form-control-sm text-center commission-input"
                                            name="commission[<%= company.name %>][<%= state %>]" placeholder="%" min="0"
                                            max="100" style="width: 70px; display: inline-block;"
                                            value="<%= value %>" />
                                          <% } else { %>
                                            <span class="text-muted">N/A</span>
                                            <% } %>
                                      </td>
                                      <% }); %>
                                  </tr>
                                  <% }); %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="content-backdrop fade"></div>
                  <button id="submitBtn" class="btn btn-primary mt-3">Save Commisions</button>
              </div>
            </div>
        </div>
    </div>

    <div id="email-overlay"
      style="display:none;position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;background:rgba(255,255,255,0.7);justify-content:center;align-items:center;">
      <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
        <span class="visually-hidden">Sending...</span>
      </div>
    </div>

    <div class="bs-toast toast toast-ex animate__animated my-2 animate__slideInDown toast-ex1" role="alert"
      aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
      <div class="toast-header"> <i class="ti ti-bell ti-xs me-2"></i>
        <div class="me-auto fw-medium text-primary">GTI</div> <small class="text-warning">Commisions</small>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body text-primary"> You should receive an email, please check it. </div>
    </div>

    <script src="/vendor/libs/jquery/jquery.js"></script>
    <link href="/vendor/libs/select2/select2.css" rel="stylesheet">
    <script src="/vendor/libs/select2/select2.js"></script>

    <script src="/vendor/libs/popper/popper.js"></script>
    <script src="/vendor/js/bootstrap.js"></script>
    <script src="/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/vendor/libs/hammer/hammer.js"></script>
    <script src="/vendor/libs/i18n/i18n.js"></script>
    <script src="/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/vendor/js/menu.js"></script>


    <script src="/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>

    <script src="/vendor/libs/moment/moment.js"></script>
    <script src="/vendor/libs/flatpickr/flatpickr.js"></script>

    <script src="/vendor/libs/@form-validation/popular.js"></script>
    <script src="/vendor/libs/@form-validation/bootstrap5.js"></script>
    <script src="/vendor/libs/@form-validation/auto-focus.js"></script>


    <script src="/js/main.js"></script>

    <script>
      function showToast(headerText, bodyText) {
        const toast = document.querySelector('.toast-ex1');
        toast.querySelector('.toast-header small').textContent = headerText;
        toast.querySelector('.toast-body').textContent = bodyText;
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
      }
    </script>

    <script>
      const stateAbbreviationMap = {
        "AL": "Alabama",
        "AK": "Alaska",
        "AZ": "Arizona",
        "AR": "Arkansas",
        "CA": "California",
        "CO": "Colorado",
        "CT": "Connecticut",
        "DE": "Delaware",
        "FL": "Florida",
        "GA": "Georgia",
        "HI": "Hawaii",
        "ID": "Idaho",
        "IL": "Illinois",
        "IN": "Indiana",
        "IA": "Iowa",
        "KS": "Kansas",
        "KY": "Kentucky",
        "LA": "Louisiana",
        "ME": "Maine",
        "MD": "Maryland",
        "MA": "Massachusetts",
        "MI": "Michigan",
        "MN": "Minnesota",
        "MS": "Mississippi",
        "MO": "Missouri",
        "MT": "Montana",
        "NE": "Nebraska",
        "NV": "Nevada",
        "NH": "New Hampshire",
        "NJ": "New Jersey",
        "NM": "New Mexico",
        "NY": "New York",
        "NC": "North Carolina",
        "ND": "North Dakota",
        "OH": "Ohio",
        "OK": "Oklahoma",
        "OR": "Oregon",
        "PA": "Pennsylvania",
        "RI": "Rhode Island",
        "SC": "South Carolina",
        "SD": "South Dakota",
        "TN": "Tennessee",
        "TX": "Texas",
        "UT": "Utah",
        "VT": "Vermont",
        "VA": "Virginia",
        "WA": "Washington",
        "WV": "West Virginia",
        "WI": "Wisconsin",
        "WY": "Wyoming"
      };

      document.addEventListener("DOMContentLoaded", () => {
        const stateHeaders = document.querySelectorAll("table tbody th");
        stateHeaders.forEach(header => {
          const abbr = header.textContent.trim();
          if (stateAbbreviationMap[abbr]) {
            header.textContent = stateAbbreviationMap[abbr];
          }
        });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const getCommissionsData = () => {
          const inputs = document.querySelectorAll(".commission-input");
          const data = [];

          inputs.forEach(input => {
            const nameAttr = input.name; // e.g., commission[Company A][CA]
            const match = nameAttr.match(/^commission\[(.+?)\]\[(.+?)\]$/);
            if (match) {
              const company = match[1];
              const state = match[2];
              const value = input.value.trim();

              if (value !== "") {
                data.push({
                  company: company,
                  state: state,
                  commission: parseFloat(value)
                });
              }
            }
          });

          return data;
        };

        document.getElementById("submitBtn")?.addEventListener("click", async () => {
          const commissions = getCommissionsData();

          const data = {
            commissions: commissions
          };

          const dataJSON = JSON.stringify(data)

          const overlay = document.getElementById("email-overlay");
          overlay.style.display = "flex";

          try {
            const res = await fetch(`${url}/users/config_commisions`, {
              method: "PUT",
              headers: {
                "Content-Type": "application/json"
              },
              body: dataJSON
            });

            if (!res.ok) throw new Error("Request failed");

            const result = await res.json();

            showToast("Success", "Commisions saved successfully")
          } catch (err) {
            console.error("Error:", err);
          }
          finally {
            overlay.style.display = "none";
          }
        });
      });
    </script>
</body>

</html>