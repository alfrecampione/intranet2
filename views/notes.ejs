<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('partials/sidebar', { user: user, activePage: activePage }) %>
                <div class="layout-page">
                    <%- include('partials/navbar', {user: user}) %>
                        <div class="content-wrapper">
                            <!-- Content -->

                            <div class="container-xxl flex-grow-1 container-p-y">
                                <div class="row">
                                    <!-- Agent Sidebar -->
                                    <%- include('partials/agent_sidebar', { profile: profile, personalInfo:
                                        personalInfo, contactInfo: contactInfo, user: user, extra_data : false }) %>
                                        <!--/ Agent Sidebar -->
                                        <!-- Agent Content -->
                                        <div class="col-xl-8 col-lg-7 order-0 order-md-1">
                                            <!-- Agent Pills -->
                                            <%- include('partials/agent_pills', {user: user, profile: profile,
                                                open: 'notes' }) %>
                                                <!--/ Agent Pills -->
                                                <!-- Notes Section -->
                                                <div class="card mb-3">
                                                    <div
                                                        class="card-header d-flex justify-content-between align-items-center">
                                                        <h5 class="mb-0">Agent Notes</h5>
                                                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal"
                                                            data-bs-target="#addNoteModal">
                                                            <i class="ti ti-plus"></i> Add Note
                                                        </button>
                                                    </div>

                                                    <div class="card-body">
                                                        <div id="notesContainer" class="row g-3">
                                                            <!-- Notes will be rendered here -->
                                                        </div>
                                                        <p id="noNotesMsg" class="text-muted d-none mb-0">No notes
                                                            available.
                                                        </p>
                                                    </div>
                                                </div>

                                                <!-- Add Note Modal -->
                                                <div class="modal fade" id="addNoteModal" tabindex="-1"
                                                    aria-labelledby="addNoteModalLabel" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">

                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="addNoteModalLabel">Add Note
                                                                </h5>
                                                                <button type="button" class="btn-close"
                                                                    data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>

                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label">Note</label>
                                                                    <textarea class="form-control" id="newNoteText"
                                                                        rows="4" required></textarea>
                                                                </div>

                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox"
                                                                        id="pinNoteCheck">
                                                                    <label class="form-check-label" for="pinNoteCheck">
                                                                        Pin this note
                                                                    </label>
                                                                </div>
                                                            </div>

                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary"
                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                <button type="button" class="btn btn-primary"
                                                                    id="saveNoteBtn">Save Note</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Edit Note Modal -->
                                                <div class="modal fade" id="editNoteModal" tabindex="-1"
                                                    aria-labelledby="editNoteModalLabel" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="editNoteModalLabel">Edit
                                                                    Note
                                                                </h5>
                                                                <button type="button" class="btn-close"
                                                                    data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label">Note</label>
                                                                    <textarea class="form-control" id="editNoteText"
                                                                        rows="4" required></textarea>
                                                                </div>
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox"
                                                                        id="editPinNoteCheck">
                                                                    <label class="form-check-label"
                                                                        for="editPinNoteCheck">
                                                                        Pin this note
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary"
                                                                    data-bs-dismiss="modal">Cancel</button>
                                                                <button type="button" class="btn btn-primary"
                                                                    id="updateNoteBtn">Save
                                                                    Changes</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!--/ Notes Section -->
                                        </div>
                                        <!--/ Agent Content -->
                                </div>
                            </div>
                            <!-- / Content -->

                            <div class="content-backdrop fade"></div>
                        </div>
                </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>

    <!-- Overlay Spinner -->
    <div id="email-overlay"
        style="display:none;position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;background:rgba(255,255,255,0.7);justify-content:center;align-items:center;">
        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
            <span class="visually-hidden">Sending...</span>
        </div>
    </div>

    <div class="bs-toast toast toast-ex animate__animated my-2 animate__slideInDown toast-ex1" role="alert"
        aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
        <div class="toast-header"> <i class="ti ti-bell ti-xs me-2"></i>
            <div class="me-auto fw-medium text-primary">GoldenHealth</div> <small class="text-warning">Agents</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-primary"> You should receive an email, please check it. </div>
    </div>

    <script src="/vendor/libs/jquery/jquery.js"></script>
    <script src="/vendor/libs/popper/popper.js"></script>
    <script src="/vendor/js/bootstrap.js"></script>
    <script src="/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/vendor/libs/hammer/hammer.js"></script>
    <script src="/vendor/libs/i18n/i18n.js"></script>
    <script src="/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/vendor/js/menu.js"></script>

    <!-- endbuild -->

    <!-- Vendors JS -->
    <script src="/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <!-- Flat Picker -->
    <script src="/vendor/libs/moment/moment.js"></script>
    <script src="/vendor/libs/flatpickr/flatpickr.js"></script>
    <!-- Form Validation -->
    <script src="/vendor/libs/@form-validation/popular.js"></script>
    <script src="/vendor/libs/@form-validation/bootstrap5.js"></script>
    <script src="/vendor/libs/@form-validation/auto-focus.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>


    <script id="notes-data" type="application/json">
      <%- JSON.stringify(notes) %>
    </script>
    <script id="userId" type="application/json">
      <%- JSON.stringify(userId) %>
    </script>
    <script id="currentUser" type="application/json">
      <%- JSON.stringify(user.user_id) %>
    </script>

    <!-- Client-side rendering -->
    <script>
        (function () {
            const userId = JSON.parse(document.getElementById('userId').textContent);
            const currentUser = JSON.parse(document.getElementById('currentUser').textContent);
            let notes = JSON.parse(document.getElementById('notes-data').textContent) || [];

            let currentEditId = null;
            let currentReplyParentId = null;

            const notesContainer = document.getElementById('notesContainer');
            const noNotesMsg = document.getElementById('noNotesMsg');
            const newNoteText = document.getElementById('newNoteText');
            const saveNoteBtn = document.getElementById('saveNoteBtn');
            const editNoteText = document.getElementById('editNoteText');
            const updateNoteBtn = document.getElementById('updateNoteBtn');

            function formatDate(d) {
                return new Date(d).toLocaleString();
            }

            function escapeHtml(str) {
                return String(str).replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function renderReply(reply) {
                const isMine = reply.createdBy === currentUser;
                const rowAlign = isMine ? 'justify-content-start' : 'justify-content-end';
                const bubbleBg = isMine ? 'background:#e9ecef;color:#212529;' : 'background:#0d6efd;color:#fff;';
                const metaColor = isMine ? 'color:#6c757d;' : 'color:rgba(255,255,255,0.7);';
                const actionColor = isMine ? 'text-secondary' : 'text-white-50';
                const trashColor = isMine ? 'text-danger' : 'text-white-50';

                return `
                <div class="d-flex ${rowAlign} mb-2 note-reply" data-id="${reply.id}">
                    <div style="max-width:75%;">
                        <div class="rounded-3 p-2 px-3" style="${bubbleBg}">
                            <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                <span class="fw-semibold" style="font-size:0.78rem;${metaColor}">${escapeHtml(reply.createdByName ?? reply.createdBy ?? '')}</span>
                                <div class="d-flex gap-2 flex-shrink-0">
                                    <a href="javascript:void(0);" class="ti ti-edit ${actionColor}" style="font-size:0.8rem" title="Edit" data-id="${reply.id}" data-action="edit"></a>
                                    <a href="javascript:void(0);" class="ti ti-trash ${trashColor}" style="font-size:0.8rem" title="Delete" data-id="${reply.id}" data-action="delete-reply"></a>
                                </div>
                            </div>
                            <p class="mb-1" style="white-space:pre-wrap;font-size:0.9rem">${escapeHtml(reply.text)}</p>
                            <small class="d-block text-end" style="font-size:0.68rem;${metaColor}">${formatDate(reply.createdAt)}</small>
                        </div>
                    </div>
                </div>`;
            }

            function renderNote(note) {
                const repliesHtml = (note.replies || []).map(renderReply).join('');
                const replyCount = (note.replies || []).length;

                return `
                <div class="col-12 note-thread" data-id="${note.id}">
                    <div class="card shadow-sm${note.isPinned ? ' border-warning' : ''}">
                        <div class="card-body">
                            <!-- Main note row -->
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <p class="mb-1 fs-7 text-muted">${escapeHtml(note.createdByName ?? note.createdBy ?? '')}</p>
                                    <p class="mb-2 fs-6">${escapeHtml(note.text)}</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted">${formatDate(note.createdAt)}</small>
                                        ${note.isPinned ? '<span class="badge bg-warning text-dark"><i class="ti ti-pin"></i> Pinned</span>' : ''}
                                    </div>
                                </div>
                                <div class="ms-3 d-flex flex-column align-items-end gap-1">
                                    <a href="javascript:void(0);" class="ti ti-edit" title="Edit Note" data-id="${note.id}" data-action="edit"></a>
                                    <a href="javascript:void(0);" class="ti ti-trash text-danger" title="Delete Note" data-id="${note.id}" data-action="delete"></a>
                                </div>
                            </div>

                            <!-- Replies section -->
                            <div class="mt-2">
                                <!-- Toggle replies button -->
                                <button class="btn btn-link btn-sm p-0 text-muted toggle-replies-btn" data-parent="${note.id}">
                                    <i class="ti ti-message-circle me-1"></i>
                                    <span class="reply-count-label">${replyCount > 0 ? replyCount + ' repl' + (replyCount === 1 ? 'y' : 'ies') : 'Reply'}</span>
                                </button>

                                <!-- Replies container (hidden by default if no replies) -->
                                <div class="replies-container mt-2 ${replyCount === 0 ? 'd-none' : ''}" id="replies-${note.id}">
                                    <div class="replies-list border-top pt-2">
                                        ${repliesHtml}
                                    </div>
                                    <!-- Reply input -->
                                    <div class="reply-input-area mt-2 border-top pt-2 d-none" id="reply-input-${note.id}">
                                        <textarea class="form-control form-control-sm reply-text mb-1" rows="2" placeholder="Write a reply..."></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-secondary btn-sm cancel-reply-btn" data-parent="${note.id}">Cancel</button>
                                            <button class="btn btn-primary btn-sm save-reply-btn" data-parent="${note.id}">Reply</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
            }

            function render() {
                notesContainer.innerHTML = '';
                if (!notes.length) {
                    noNotesMsg.classList.remove('d-none');
                    return;
                }
                noNotesMsg.classList.add('d-none');

                notes.forEach(note => {
                    notesContainer.insertAdjacentHTML('beforeend', renderNote(note));
                });
            }

            // Add top-level note
            saveNoteBtn.addEventListener('click', async () => {
                const text = newNoteText.value.trim();
                const isPinned = document.getElementById('pinNoteCheck').checked;
                if (!text) return;

                const res = await fetch(`/users/profile/${userId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, isPinned })
                });
                if (res.ok) {
                    const newNote = await res.json();
                    newNote.replies = [];
                    notes.unshift(newNote);
                    render();
                    newNoteText.value = '';
                    document.getElementById('pinNoteCheck').checked = false;
                    bootstrap.Modal.getInstance(document.getElementById('addNoteModal')).hide();
                }
            });

            // Delegated events on notesContainer
            notesContainer.addEventListener('click', async (e) => {
                // Toggle replies visibility
                const toggleBtn = e.target.closest('.toggle-replies-btn');
                if (toggleBtn) {
                    const parentId = toggleBtn.dataset.parent;
                    const container = document.getElementById(`replies-${parentId}`);
                    const inputArea = document.getElementById(`reply-input-${parentId}`);
                    const isHidden = container.classList.contains('d-none');
                    container.classList.toggle('d-none', !isHidden);
                    // When opening, show reply input if it's a fresh open
                    if (isHidden) {
                        inputArea.classList.remove('d-none');
                        inputArea.querySelector('.reply-text').focus();
                    }
                    return;
                }

                // Cancel reply
                const cancelBtn = e.target.closest('.cancel-reply-btn');
                if (cancelBtn) {
                    const parentId = cancelBtn.dataset.parent;
                    const inputArea = document.getElementById(`reply-input-${parentId}`);
                    inputArea.classList.add('d-none');
                    inputArea.querySelector('.reply-text').value = '';
                    return;
                }

                // Save reply
                const saveReplyBtn = e.target.closest('.save-reply-btn');
                if (saveReplyBtn) {
                    const parentId = saveReplyBtn.dataset.parent;
                    const inputArea = document.getElementById(`reply-input-${parentId}`);
                    const text = inputArea.querySelector('.reply-text').value.trim();
                    if (!text) return;

                    const res = await fetch(`/users/profile/${userId}/notes`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text, parentId })
                    });
                    if (res.ok) {
                        const newReply = await res.json();
                        const noteIndex = notes.findIndex(n => n.id === parentId);
                        if (noteIndex > -1) {
                            notes[noteIndex].replies = [newReply, ...(notes[noteIndex].replies || [])];
                        }
                        render();
                    }
                    return;
                }

                const link = e.target.closest('a[data-action]');
                if (!link) return;
                const noteId = link.getAttribute('data-id');
                const action = link.getAttribute('data-action');

                if (action === 'edit') {
                    // Find note or reply
                    let found = notes.find(n => n.id === noteId);
                    let isReply = false;
                    if (!found) {
                        for (const n of notes) {
                            const r = (n.replies || []).find(r => r.id === noteId);
                            if (r) { found = r; isReply = true; break; }
                        }
                    }
                    if (found) {
                        currentEditId = noteId;
                        editNoteText.value = found.text;
                        document.getElementById('editPinNoteCheck').checked = !!found.isPinned;
                        document.getElementById('editPinNoteCheck').closest('.form-check').style.display = isReply ? 'none' : '';
                        new bootstrap.Modal(document.getElementById('editNoteModal')).show();
                    }
                }

                if (action === 'delete') {
                    await deleteNote(noteId);
                }

                if (action === 'delete-reply') {
                    const res = await fetch(`/users/profile/${userId}/notes/${noteId}`, { method: 'DELETE' });
                    if (res.ok) {
                        for (const n of notes) {
                            n.replies = (n.replies || []).filter(r => r.id !== noteId);
                        }
                        render();
                    }
                }
            });

            // Update Note (top-level or reply)
            updateNoteBtn.addEventListener('click', async () => {
                const text = editNoteText.value.trim();
                const isPinned = document.getElementById('editPinNoteCheck').checked;
                if (!text || !currentEditId) return;

                const res = await fetch(`/users/profile/${userId}/notes/${currentEditId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, isPinned })
                });
                if (res.ok) {
                    const updated = await res.json();
                    // Check if it's a top-level note
                    const topIdx = notes.findIndex(n => n.id === currentEditId);
                    if (topIdx > -1) {
                        notes[topIdx] = { ...notes[topIdx], ...updated };
                    } else {
                        for (const n of notes) {
                            const rIdx = (n.replies || []).findIndex(r => r.id === currentEditId);
                            if (rIdx > -1) { n.replies[rIdx] = { ...n.replies[rIdx], ...updated }; break; }
                        }
                    }
                    render();
                    bootstrap.Modal.getInstance(document.getElementById('editNoteModal')).hide();
                }
            });

            async function deleteNote(noteId) {
                const res = await fetch(`/users/profile/${userId}/notes/${noteId}`, { method: 'DELETE' });
                if (res.ok) {
                    notes = notes.filter(n => n.id !== noteId);
                    render();
                }
            }

            render();
        })();
    </script>

</body>

</html>