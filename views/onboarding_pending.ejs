    <!-- Overlay Spinner -->
    <div id="email-overlay"
        style="display:none;position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;background:rgba(255,255,255,0.7);justify-content:center;align-items:center;">
        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
            <span class="visually-hidden">Sending...</span>
        </div>
    </div>

    <div class="modal fade" id="deleteOnboardingModal" tabindex="-1" aria-labelledby="deleteOnboardingLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteOnboardingLabel">Delete pending onboarding?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">This will invalidate the link and remove the email from the pending list.</p>
                    <p class="mb-0 fw-semibold text-danger" id="deleteOnboardingEmail"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteOnboarding">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="bs-toast toast toast-ex animate__animated my-2 animate__slideInDown toast-ex1" role="alert"
        aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
        <div class="toast-header"> <i class="ti ti-bell ti-xs me-2"></i>
            <div class="me-auto fw-medium text-primary">GoldenHealth</div> <small class="text-warning">Agents</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-primary"> You should receive an email, please check it. </div>
    </div>

