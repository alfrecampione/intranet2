    <script src="/vendor/libs/@form-validation/auto-focus.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>

    <script id="users-data" type="application/json">
      <%- JSON.stringify(onboardingPending) %>
    </script>

    <script>
        function showToast(headerText, bodyText) {
            const toast = document.querySelector('.toast-ex1');
            toast.querySelector('.toast-header small').textContent = headerText;
            toast.querySelector('.toast-body').textContent = bodyText;
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }

        $(document).ready(function () {
            const onboardingData = JSON.parse(document.getElementById("users-data").textContent);

            const tableData = onboardingData.map(user => {
                const fullName = [user.firstName, user.lastName].filter(Boolean).join(' ') || '—';
                const sentAt = user.sentAt ? new Date(user.sentAt).toLocaleString() : '';
                const email = user.email || '';

                return {
                    email: email,
                    name: fullName,
                    sentAt: sentAt,
                    sentAtRaw: user.sentAt ? new Date(user.sentAt).getTime() : 0,
                    actions: email
                };
            });

            const onboardingTable = $('#onboarding-table').DataTable({
                data: tableData,
                columns: [
                    {
                        title: "#",
                        data: null,
                        orderable: false,
                        render: (data, type, row, meta) => meta.row + 1
                    },
                    {
                        title: "Email",
                        data: "email",
                        render: data => data ? `<a href="mailto:${data}">${data}</a>` : ''
                    },
                    {
                        title: "Full Name",
                        data: "name"
                    },
                    {
                        title: "Sent at",
                        data: "sentAt",
                        type: "num",
                        render: (data, type, row) => {
                            if (type === 'sort' || type === 'type') {
                                return row.sentAtRaw;
                            }
                            return data;
                        }
                    },
                    {
                        title: "Actions",
                        data: "actions",
                        orderable: false,
                        render: (data, type, row) => {
                            const safeName = (row.name || '').replace(/"/g, '&quot;');
                            return `<a href="javascript:void(0);" class="ti ti-trash text-danger btn-delete-onboarding" title="Delete Onboarding" data-email="${encodeURIComponent(data)}" data-name="${safeName}"></a>`;
                        }
                    }
                ],
                responsive: true,
                paging: false,
                autoWidth: false,
                order: [[3, 'desc']]  // Default sort by "Sent at" descending
            });

            const deleteModalEl = document.getElementById('deleteOnboardingModal');
            const deleteModal = new bootstrap.Modal(deleteModalEl);
            const deleteEmailEl = document.getElementById('deleteOnboardingEmail');
            const overlay = document.getElementById('email-overlay');
            let emailToDeleteEncoded = null; // keep encoded value for safe requests
            let rowToDelete = null;

            $('#onboarding-table').on('click', '.btn-delete-onboarding', function (e) {
                e.preventDefault();
                const btn = $(this);
                emailToDeleteEncoded = btn.data('email');
                rowToDelete = btn.closest('tr');
                const name = btn.data('name');
                const decodedEmail = decodeURIComponent(emailToDeleteEncoded || '');
                const displayValue = name ? `${name} (${decodedEmail})` : decodedEmail;
                deleteEmailEl.textContent = displayValue;
                deleteModal.show();
            });

            $('#confirmDeleteOnboarding').on('click', function () {
                if (!emailToDeleteEncoded) return;
                overlay.style.display = 'flex';
                fetch(`/pending-onboarding/${emailToDeleteEncoded}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            onboardingTable.row(rowToDelete).remove().draw();
                            showToast('Deleted', 'Pending onboarding removed.');
                        } else {
                            showToast('Error', data.message || 'Error deleting onboarding');
                        }
                    })
                    .catch(() => showToast('Error', 'Error deleting onboarding'))
                    .finally(() => {
                        overlay.style.display = 'none';
                        deleteModal.hide();
                        emailToDelete = null;
                        rowToDelete = null;
                    });
            });
        });
    </script>

</body>

</html>
emailToDeleteEncoded = null;