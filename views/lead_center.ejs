<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('partials/sidebar', { user: user, activePage: activePage }) %>
                <div class="layout-page">
                    <%- include('partials/navbar', {user: user}) %>
                        <div class="content-wrapper">
                            <div class="container-xxl flex-grow-1 container-p-y">
                                <div class="card">
                                    <div class="card-header flex-column flex-md-row align-items-center gap-2">
                                        <div class="head-label">
                                            <h5 class="card-title m-0">Lead Center</h5>
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <table class="table table-bordered" id="results-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>Number</th>
                                                    <th>Company</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <!-- Modal to add new record -->
                                <div class="offcanvas offcanvas-end" id="add-new-record">
                                    <div class="offcanvas-header border-bottom">
                                        <h5 class="offcanvas-title" id="exampleModalLabel">
                                            Send Email
                                        </h5>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body flex-grow-1">
                                        <form class="add-new-record pt-2 pb-2 px-1 row g-3" id="form-send-email"
                                            onsubmit="return false">
                                            <div class="col-12 mb-3">
                                                <label class="form-label mb-2">Required Documents</label>
                                                <div class="row g-2">
                                                    <div class="col-6">
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="directDepositForm" name="directDepositForm">
                                                            <label class="form-check-label"
                                                                for="directDepositForm">Direct
                                                                Deposit Form</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="driverLicense" name="driverLicense">
                                                            <label class="form-check-label" for="driverLicense">Driver
                                                                License</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="EINconfirmation" name="EINconfirmation">
                                                            <label class="form-check-label" for="EINconfirmation">EIN
                                                                Confirmation</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox" id="eANDo"
                                                                name="eANDo">
                                                            <label class="form-check-label" for="eANDo">E&O</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="proLicense" name="proLicense">
                                                            <label class="form-check-label"
                                                                for="proLicense">Professional
                                                                License</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="taxIdentificationW9" name="taxIdentificationW9"
                                                                checked disabled>
                                                            <label class="form-check-label" for="taxIdentificationW9">
                                                                Tax Identification W9
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="ffmCertification" name="ffmCertification">
                                                            <label class="form-check-label" for="ffmCertification">FFM
                                                                Certification</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="gaLicense" name="gaLicense">
                                                            <label class="form-check-label" for="gaLicense">GA
                                                                License</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="gaCertification" name="gaCertification">
                                                            <label class="form-check-label" for="gaCertification">GA
                                                                Certification</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox" id="sunbiz"
                                                                name="sunbiz">
                                                            <label class="form-check-label" for="sunbiz">Sunbiz</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input class="form-check-input" type="checkbox"
                                                                id="corporationLicense" name="corporationLicense">
                                                            <label class="form-check-label"
                                                                for="corporationLicense">Corporation
                                                                License</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-start gap-2 mt-3">
                                                <button type="submit" class="btn btn-primary data-submit me-sm-4 me-1">
                                                    Send
                                                </button>
                                                <button type="reset" class="btn btn-outline-secondary"
                                                    data-bs-dismiss="offcanvas">
                                                    Cancel
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="content-backdrop fade"></div>
                        </div>
                </div>
