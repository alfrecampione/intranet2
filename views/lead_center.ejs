        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>

    <!-- Overlay Spinner -->
    <div id="email-overlay"
        style="display:none;position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;background:rgba(255,255,255,0.7);justify-content:center;align-items:center;">
        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
            <span class="visually-hidden">Sending...</span>
        </div>
    </div>

    <div class="bs-toast toast toast-ex animate__animated my-2 animate__slideInDown toast-ex1" role="alert"
        aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
        <div class="toast-header"> <i class="ti ti-bell ti-xs me-2"></i>
            <div class="me-auto fw-medium text-primary">GTI</div> <small class="text-warning">Agents</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-primary"> You should receive an email, please check it. </div>
    </div>

    <script src="/vendor/libs/jquery/jquery.js"></script>
    <script src="/vendor/libs/popper/popper.js"></script>
    <script src="/vendor/js/bootstrap.js"></script>
    <script src="/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/vendor/libs/hammer/hammer.js"></script>
    <script src="/vendor/libs/i18n/i18n.js"></script>
    <script src="/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="/vendor/js/menu.js"></script>

    <!-- endbuild -->

    <!-- Vendors JS -->
    <script src="/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <!-- Flat Picker -->
    <script src="/vendor/libs/moment/moment.js"></script>
    <script src="/vendor/libs/flatpickr/flatpickr.js"></script>
    <!-- Form Validation -->
    <script src="/vendor/libs/@form-validation/popular.js"></script>
    <script src="/vendor/libs/@form-validation/bootstrap5.js"></script>
    <script src="/vendor/libs/@form-validation/auto-focus.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>

    <script id="agents-data" type="application/json">
      <%- JSON.stringify(leadCenter) %>
    </script>

    <script id="user-data" type="application/json">
      <%- JSON.stringify(user) %>
    </script>

    <script>
        function showToast(headerText, bodyText) {
            const toast = document.querySelector('.toast-ex1');
            toast.querySelector('.toast-header small').textContent = headerText;
            toast.querySelector('.toast-body').textContent = bodyText;
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tableBody = document.querySelector("#results-table tbody");
            const user = JSON.parse(document.getElementById("user-data").textContent);
            const leads = JSON.parse(document.getElementById("agents-data").textContent);
            let selectedEmail = null;

            console.log("[LeadCenter] DOMContentLoaded, leads:", leads);

            if (leads.length === 0) {
                tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted">No leads available</td>
                </tr>
            `;
            } else {
                tableBody.innerHTML = leads.map((lead, index) => `
                <tr>
                    <td>${index + 1}</td>
                    <td>${lead.fullName}</td>
                    <td>${lead.email}</td>
                    <td>${lead.phone}</td>
                    <td>${lead.companyNames.join(", ") || "-"}</td>
                    <td>
                        <a href="javascript:void(0)" 
                           class="ti ti-check text-success btn-send-onboarding" 
                           title="Send Onboarding"
                           data-email="${lead.email}">
                        </a>
                        <a href="javascript:void(0)" 
                           class="ti ti-x text-danger" 
                           title="Delete"
                           onclick="if(confirm('Are you sure you want to delete it?')) { fetch('/users/lead-center/${lead.id}', { method: 'DELETE' }).then(() => location.reload()); }">
                        </a>
                        <a href="#" class="ti ti-search text-info"></a>
                    </td>
                </tr>
            `).join("");
            }

            // Open modal on check icon click
            document.querySelectorAll(".btn-send-onboarding").forEach(btn => {
                btn.addEventListener("click", () => {
                    selectedEmail = btn.dataset.email;
                    console.log("[LeadCenter] Selected email for onboarding:", selectedEmail);
                    const offcanvas = new bootstrap.Offcanvas(document.getElementById("add-new-record"));
                    offcanvas.show();
                });
            });

            // Handle send email form submission
            document.getElementById("form-send-email").addEventListener("submit", async (e) => {
                e.preventDefault();
                if (!selectedEmail) {
                    console.warn("[LeadCenter] No selectedEmail when submitting form");
                    return;
                }

                const docFields = [
                    "directDepositForm",
                    "driverLicense",
                    "EINconfirmation",
                    "eANDo",
                    "proLicense",
                    "taxIdentificationW9",
                    "ffmCertification",
                    "gaLicense",
                    "gaCertification",
                    "sunbiz",
                    "corporationLicense"
                ];

                const requiredDocuments = {};
                docFields.forEach(field => {
                    requiredDocuments[field] = document.getElementById(field).checked;
                });

                const subject = "Create your account on GoldenHealth";
                const overlay = document.getElementById("email-overlay");
                overlay.style.display = "flex";

                try {
                    console.log("[LeadCenter] Accepting lead:", selectedEmail);
                    const acepted = await fetch(`/users/lead-center/accept/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                    });
                    const aceptedData = await acepted.json();
                    console.log("[LeadCenter] Accept response:", acepted.status, aceptedData);
                    if (!acepted.ok) {
                        showToast("Error", aceptedData.message || "Error accepting lead.");
                        overlay.style.display = "none";
                        return;
                    }

                    console.log("[LeadCenter] Marking necessary documents for:", selectedEmail, requiredDocuments);
                    const docsResponse = await fetch(`/necessaryDocs`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email: selectedEmail,
                            ...requiredDocuments
                        }),
                    });
                    console.log("[LeadCenter] Docs response:", docsResponse.status);

                    console.log("[LeadCenter] Encrypting email:", selectedEmail);
                    const encryptEmail = await fetch(`/email/encrypt/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                    });
                    const encryptedEmail = await encryptEmail.json();
                    console.log("[LeadCenter] Encrypted email response:", encryptEmail.status, encryptedEmail);

                    if (!docsResponse.ok) showToast("Error", "Error adding necessary documents");
                    if (!encryptEmail.ok) showToast("Error", "Error encrypting email");

                    const body = {
                        name: selectedEmail,
                        intro: "Welcome! Please follow the instructions below.",
                        action: {
                            instructions: "To continue with the creation of your account, please click here:",
                            button: {
                                color: "#27388B",
                                text: "Create your account",
                                link: `${url}/signUp/${encryptedEmail.data.encryptedData}`
                            }
                        },
                        outro: "If you have questions, you can reply to this email."
                    };

                    console.log("[LeadCenter] Sending onboarding email to:", selectedEmail, body);
                    const response = await fetch(`${url}/sendEmail/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email: selectedEmail,
                            subject,
                            body
                        }),
                    });

                    const responseData = await response.json();
                    console.log("[LeadCenter] Email send response:", response.status, responseData);

                    if (response.ok) {
                        showToast("Success", "Email sent successfully!");

                        docFields.forEach(field => {
                            document.getElementById(field).checked = false;
                        });
                        const offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById("add-new-record"));
                        if (offcanvas) offcanvas.hide();
                    } else {
                        showToast("Error", responseData.message || "Error sending email.");
                    }
                } catch (err) {
                    console.error("[LeadCenter] Exception in onboarding flow:", err);
                    showToast("Error", "Error sending email.");
                } finally {
                    overlay.style.display = "none";
                }
            });
        });
    </script>
</body>

</html>