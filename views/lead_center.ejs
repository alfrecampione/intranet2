    <script id="agents-data" type="application/json">
      <%- JSON.stringify(leadCenter) %>
    </script>

    <script id="user-data" type="application/json">
      <%- JSON.stringify(user) %>
    </script>

    <script>
        function showToast(headerText, bodyText) {
            const toast = document.querySelector('.toast-ex1');
            toast.querySelector('.toast-header small').textContent = headerText;
            toast.querySelector('.toast-body').textContent = bodyText;
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const tableBody = document.querySelector("#results-table tbody");
            const user = JSON.parse(document.getElementById("user-data").textContent);
            const leads = JSON.parse(document.getElementById("agents-data").textContent);
            let selectedEmail = null;

            if (leads.length === 0) {
                tableBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-muted">No leads available</td>
                </tr>
            `;
            } else {
                tableBody.innerHTML = leads.map((lead, index) => `
                <tr>
                    <td>${index + 1}</td>
                    <td>${lead.fullName}</td>
                    <td>${lead.email}</td>
                    <td>${lead.phone}</td>
                    <td>${lead.companyNames.join(", ") || "-"}</td>
                    <td>
                        <a href="javascript:void(0)" 
                           class="ti ti-check text-success btn-send-onboarding" 
                           title="Send Onboarding"
                           data-email="${lead.email}">
                        </a>
                        <a href="javascript:void(0)" 
                           class="ti ti-x text-danger" 
                           title="Delete"
                           onclick="if(confirm('Are you sure you want to delete it?')) { fetch('/users/lead-center/${lead.id}', { method: 'DELETE' }).then(() => location.reload()); }">
                        </a>
                        <a href="/lead-center/loadLead/${lead.id}" 
                        class="ti ti-search text-info"
                        title= "View all data"></a>
                    </td>
                </tr>
            `).join("");
            }

            // Open modal on check icon click
            document.querySelectorAll(".btn-send-onboarding").forEach(btn => {
                btn.addEventListener("click", () => {
                    selectedEmail = btn.dataset.email;
                    const offcanvas = new bootstrap.Offcanvas(document.getElementById("add-new-record"));
                    offcanvas.show();
                });
            });

            // Handle send email form submission
            document.getElementById("form-send-email").addEventListener("submit", async (e) => {
                e.preventDefault();
                if (!selectedEmail) {
                    console.warn("[LeadCenter] No selectedEmail when submitting form");
                    return;
                }

                const docFields = [
                    "directDepositForm",
                    "driverLicense",
                    "EINconfirmation",
                    "eANDo",
                    "proLicense",
                    "taxIdentificationW9",
                    "ffmCertification",
                    "gaLicense",
                    "gaCertification",
                    "sunbiz",
                    "corporationLicense"
                ];

                const requiredDocuments = {};
                docFields.forEach(field => {
                    requiredDocuments[field] = document.getElementById(field).checked;
                });

                const subject = "Create your account on GoldenHealth";
                const overlay = document.getElementById("email-overlay");
                overlay.style.display = "flex";

                try {
                    const acepted = await fetch(`/users/lead-center/accept/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                    });
                    const aceptedData = await acepted.json();
                    if (!acepted.ok) {
                        showToast("Error", aceptedData.message || "Error accepting lead.");
                        overlay.style.display = "none";
                        return;
                    }

                    const docsResponse = await fetch(`/necessaryDocs`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email: selectedEmail,
                            ...requiredDocuments
                        }),
                    });

                    const encryptEmail = await fetch(`/email/encrypt/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                    });
                    const encryptedEmail = await encryptEmail.json();

                    if (!docsResponse.ok) showToast("Error", "Error adding necessary documents");
                    if (!encryptEmail.ok) showToast("Error", "Error encrypting email");

                    const signUpLink = `${url}/signUp/${encryptedEmail.data.encryptedData}`;

                    // Create HTML email body similar to Veterans Day template
                    const body = `
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<!--[if gte mso 15]>
<xml>
<o:OfficeDocumentSettings>
<o:AllowPNG/>
<o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
<![endif]-->
<meta charset="UTF-8"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Create your account on GoldenHealth</title>
<style>
img{-ms-interpolation-mode:bicubic;}
table, td{mso-table-lspace:0pt;mso-table-rspace:0pt;}
p, a, li, td, blockquote{mso-line-height-rule:exactly;}
p, a, li, td, body, table, blockquote{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;}
body{height:100%;margin:0;padding:0;width:100%;background:#f0f4f9;}
p{margin:0;padding:0;}
table{border-collapse:collapse;}
td, p, a{word-break:break-word;}
h1, h2, h3, h4, h5, h6{display:block;margin:0;padding:0;}
img, a img{border:0;height:auto;outline:none;text-decoration:none;}
body, #bodyTable{background-color:#f0f4f9;}
.mceText, .mceLabel{font-family:'Public Sans', Verdana, Geneva, sans-serif;color:#000;}
.mceText h1{color:#27388B;font-size:32px;font-weight:bold;line-height:1.25;text-align:center;margin:20px 0;}
.mceText p{color:#000;font-size:16px;line-height:1.5;text-align:center;margin:15px 0;}
.mceButton{background-color:#27388B;border-radius:5px;text-align:center;margin:20px 0;}
.mceButton a{color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;padding:12px 24px;display:inline-block;}
@media only screen and (max-width: 480px) {
body, table, td, p, a, li, blockquote{-webkit-text-size-adjust:none!important;}
body{width:100%!important;min-width:100%!important;}
.mceText h1{font-size:24px!important;}
.mceText p{font-size:14px!important;}
}
</style>
</head>
<body>
<center>
<table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%" id="bodyTable" style="background-color:#f0f4f9;">
<tbody><tr>
<td align="center" valign="top" style="padding-top:40px;padding-bottom:40px;">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:660px;background-color:#ffffff;" role="presentation">
<tbody>
<!-- Logo Section -->
<tr>
<td style="padding:24px;text-align:center;">
<a href="https://goldentrust.com/" target="_blank">
<img src="${url}/img/branding/GoldenHealth-2.png" alt="GoldenHealth" style="max-width:300px;height:auto;display:block;margin:0 auto;"/>
</a>
</td>
</tr>
<!-- Main Content -->
<tr>
<td style="padding:0 24px 24px 24px;" class="mceText">
<h1>Welcome to GoldenHealth!</h1>
<p style="font-size:18px;margin-top:20px;">
Hello,
</p>
<p>
We're excited to have you join our team. To get started and complete your registration, please click the button below to create your account.
</p>
<div class="mceButton" style="text-align:center;margin:30px 0;">
<a href="${signUpLink}" style="background-color:#27388B;color:#ffffff;padding:14px 28px;border-radius:5px;text-decoration:none;font-weight:bold;display:inline-block;">
Create Your Account
</a>
</div>
<p>
If you have any questions or need assistance, feel free to reply to this email. We're here to help!
</p>
<p style="margin-top:30px;color:#666;">
Best regards,<br>
<strong>GoldenHealth Team</strong>
</p>
</td>
</tr>
<!-- Footer Section -->
<tr>
<td style="background-color:#27388B;padding:20px;text-align:center;">
<table border="0" cellpadding="0" cellspacing="0" width="100%" role="presentation">
<tbody>
<tr>
<td style="text-align:center;padding-bottom:10px;">
<a href="https://www.facebook.com/goldentrust" target="_blank" style="margin:0 8px;">
<img src="https://cdn-icons-png.flaticon.com/512/124/124010.png" alt="Facebook" width="24" height="24" style="display:inline-block;"/>
</a>
<a href="https://www.instagram.com/goldentrust" target="_blank" style="margin:0 8px;">
<img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" width="24" height="24" style="display:inline-block;"/>
</a>
<a href="https://www.linkedin.com/company/goldentrust" target="_blank" style="margin:0 8px;">
<img src="https://cdn-icons-png.flaticon.com/512/174/174857.png" alt="LinkedIn" width="24" height="24" style="display:inline-block;"/>
</a>
</td>
</tr>
<tr>
<td style="color:#ffffff;font-size:12px;line-height:1.5;text-align:center;">
<p style="margin:5px 0;color:#ffffff;">
Golden Trust Insurance<br/>
Email: <a href="mailto:goldenhealth@goldentrust.com" style="color:#ffffff;text-decoration:underline;">goldenhealth@goldentrust.com</a><br/>
Phone: <a href="tel:+1234567890" style="color:#ffffff;text-decoration:underline;">+1 (234) 567-890</a>
</p>
<p style="margin:10px 0;color:#ffffff;font-size:11px;">
© 2025 Golden Trust Insurance. All rights reserved.
</p>
</td>
</tr>
</tbody>
</table>
</td>
</tr>
</tbody>
</table>
</td>
</tr>
</tbody>
</table>
</center>
</body>
</html>
`;

                    const response = await fetch(`/sendEmail/${selectedEmail}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email: selectedEmail,
                            subject,
                            body
                        }),
                    });

                    const responseData = await response.json();

                    if (response.ok) {
                        showToast("Success", "Email sent successfully!");

                        docFields.forEach(field => {
                            document.getElementById(field).checked = false;
                        });
                        const offcanvas = bootstrap.Offcanvas.getInstance(document.getElementById("add-new-record"));
                        if (offcanvas) offcanvas.hide();

                        const deleteLead = await fetch(`/users/lead-center/${selectedEmail}`, {
                            method: "DELETE",
                            headers: { "Content-Type": "application/json" },
                        });
                    } else {
                        showToast("Error", responseData.message || "Error sending email.");
                    }
                } catch (err) {
                    console.error("[LeadCenter] Exception in onboarding flow:", err);
                    showToast("Error", "Error sending email.");
                } finally {
                    overlay.style.display = "none";
                }
            });
        });
    </script>
</body>

</html>