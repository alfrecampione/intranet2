  <!-- Group by carriers -->
  <script>
    const companies = JSON.parse(document.getElementById('companies-data').textContent);
    const userCompanyStateData = JSON.parse(document.getElementById('user-company-state-data').textContent);
    const states = JSON.parse(document.getElementById('states-data').textContent);

    let selectedState = 'all';

    const originalLabels = [...companies.map(c => c.name), 'None'];

    function getDataByState(state) {
      const filtered = state === 'all'
        ? userCompanyStateData
        : userCompanyStateData.filter(d => d.state === state);

      const counts = {};
      filtered.forEach(({ company }) => {
        counts[company] = (counts[company] || 0) + 1;
      });

      return companies.map(c => counts[c.name] || 0);
    }

    const statesWithData = states.filter(state => {
      const data = userCompanyStateData.filter(d => d.state === state);
      return data.length > 0;
    });

    const dropdownMenu = document.querySelector('.dropdown-menu');
    dropdownMenu.innerHTML = `
    <a class="dropdown-item active" href="#" data-state="all">All States</a>
    ${statesWithData.map(state => `<a class="dropdown-item" href="#" data-state="${state}">${state}</a>`).join('')}
  `;

    const ctx = document.getElementById('polarChart').getContext('2d');

    function generateColors(n) {
      const colors = [];

      for (let i = 0; i < n; i++) {
        const hue = Math.round((360 / n) * i);

        // Base values for clarity
        let saturation = 70;
        let lightness = 50;

        // Apply very small variation (±5%) to avoid flatness
        saturation += Math.floor(Math.random() * 11) - 5; // 65–75%
        lightness += Math.floor(Math.random() * 11) - 5;  // 45–55%

        colors.push(`hsl(${hue}, ${saturation}%, ${lightness}%)`);
      }

      for (let i = colors.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [colors[i], colors[j]] = [colors[j], colors[i]];
      }

      return colors;
    }


    const chartConfig = {
      type: 'polarArea',
      data: {
        labels: originalLabels,
        datasets: [{
          data: [],
          backgroundColor: generateColors(companies.length + 1),
        }]
      },
      options: {
        animation: {
          animateRotate: true,
          animateScale: true,
        },
        plugins: {
          legend: {
            display: true,
            position: 'right',
          }
        },
        scales: {
          r: {
            angleLines: { display: false },
            ticks: { display: false, beginAtZero: true },
            grid: { display: false, circular: false }
          }
        }
      }
    };

    const polarChart = new Chart(ctx, chartConfig);

    function updateChart(state) {
      const chartTitle = document.getElementById('chartTitle');
      chartTitle.innerText = (state === 'all')
        ? 'All States by carriers'
        : `${stateAbbreviationMap[state] || state} by carriers`;

      // Filter data by state
      const filtered = state === 'all'
        ? userCompanyStateData
        : userCompanyStateData.filter(d => d.state === state);

      // --- DISTINCT COUNT PER COMPANY ---
      const counts = {};
      companies.forEach(c => counts[c.name] = new Set());

      filtered.forEach(({ company, userId }) => {
        if (company && counts[company]) {
          counts[company].add(userId);
        }
      });

      const rawData = companies.map(c => counts[c.name].size);

      // --- DISTINCT TOTAL USERS ---
      const uniqueUsers = new Set(filtered.map(d => d.userId));
      const currentSum = uniqueUsers.size;

      const totalUsersDiv = document.getElementById('totalUsers');

      if (currentSum === 0) {
        polarChart.data.labels = ['No Agents'];
        polarChart.data.datasets[0].data = [1];
        polarChart.data.datasets[0].backgroundColor = ['#CCCCCC'];
        polarChart.update();
        totalUsersDiv.className = 'mt-4 fw-bold text-danger';
        totalUsersDiv.innerText = `No agents in ${state === 'all' ? 'all states' : state}`;
        return;
      }

      // Prepare chart data
      const fullData = [...rawData, 0]; // last one for "None"
      const colors = generateColors(fullData.length);

      const zipped = fullData.map((value, i) => ({
        label: originalLabels[i],
        value,
        color: colors[i]
      }));

      const filteredZipped = zipped.filter(d => d.value > 0);
      filteredZipped.sort((a, b) => b.value - a.value);

      // Update chart
      polarChart.data.labels = filteredZipped.map(d => d.label);
      polarChart.data.datasets[0].data = filteredZipped.map(d => d.value);
      polarChart.data.datasets[0].backgroundColor = filteredZipped.map(d => d.color);
      polarChart.options.rotation = -Math.PI / 2;
      polarChart.update();

      // Update total users
      totalUsersDiv.className = 'mt-4 fw-bold text-secondary';
      totalUsersDiv.innerText = `${currentSum} agents`;
    } function updateChart(state) {
      const chartTitle = document.getElementById('chartTitle');
      chartTitle.innerText = (state === 'all')
        ? 'All States by carriers'
        : `${stateAbbreviationMap[state] || state} by carriers`;

      // Filter data by state
      const filtered = state === 'all'
        ? userCompanyStateData
        : userCompanyStateData.filter(d => d.state === state);

      // --- DISTINCT COUNT PER COMPANY ---
      const counts = {};
      companies.forEach(c => counts[c.name] = new Set());

      filtered.forEach(({ company, userId }) => {
        if (company && counts[company]) {
          counts[company].add(userId);
        }
      });

      const rawData = companies.map(c => counts[c.name].size);

      // --- DISTINCT TOTAL USERS ---
      const uniqueUsers = new Set(filtered.map(d => d.userId));
      const currentSum = uniqueUsers.size;

      const totalUsersDiv = document.getElementById('totalUsers');

      if (currentSum === 0) {
        polarChart.data.labels = ['No Agents'];
        polarChart.data.datasets[0].data = [1];
        polarChart.data.datasets[0].backgroundColor = ['#CCCCCC'];
        polarChart.update();
        totalUsersDiv.className = 'mt-4 fw-bold text-danger';
        totalUsersDiv.innerText = `No agents in ${state === 'all' ? 'all states' : state}`;
        return;
      }

      // Prepare chart data
      const fullData = [...rawData, 0]; // last one for "None"
      const colors = generateColors(fullData.length);

      const zipped = fullData.map((value, i) => ({
        label: originalLabels[i],
        value,
        color: colors[i]
      }));

      const filteredZipped = zipped.filter(d => d.value > 0);
      filteredZipped.sort((a, b) => b.value - a.value);

      // Update chart
      polarChart.data.labels = filteredZipped.map(d => d.label);
      polarChart.data.datasets[0].data = filteredZipped.map(d => d.value);
      polarChart.data.datasets[0].backgroundColor = filteredZipped.map(d => d.color);
      polarChart.options.rotation = -Math.PI / 2;
      polarChart.update();

      // Update total users
      totalUsersDiv.className = 'mt-4 fw-bold text-secondary';
      totalUsersDiv.innerText = `${currentSum} agents`;
    }

    updateChart(selectedState);

    document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        selectedState = e.target.getAttribute('data-state');
        document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(i => i.classList.remove('active'));
        e.target.classList.add('active');
        updateChart(selectedState);
      });
    });
  </script>
