        return `
      <li class="mb-4 d-flex">
        <div class="d-flex w-50 align-items-center me-4">
          <img src="${stateLogos[state] || '/img/icons/states/default.png'}" 
               alt="${state}-logo" class="me-4" width="35" />
          <div>
            <h6 class="mb-0">${state}</h6>
            <small class="text-body">${count} agents</small>
          </div>
        </div>
        <div class="d-flex flex-grow-1 align-items-center">
          <div class="progress w-100 me-4" style="height: 8px">
            <div class="progress-bar bg-primary" role="progressbar" 
                 style="width: ${percentage}%" 
                 aria-valuenow="${percentage}" aria-valuemin="0" aria-valuemax="100">
            </div>
          </div>
          <span class="text-muted">${percentage}%</span>
        </div>
      </li>
    `;
      }).join('');
    </script>
    <!--/ Group by states -->
    <% } %>

      <!-- Carrier Status Bars -->
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const user = JSON.parse(document.getElementById('user-data').textContent);
          const container = document.getElementById('carrierStatusContainer');

          // Only render if user is an agent and not active or not a business
          if (!container || !user.statesAndCarriers) return;

          if (!user.statesAndCarriers || user.statesAndCarriers.length === 0) {
            container.innerHTML = '<div class="p-4 text-center text-muted">No carrier information available.</div>';
            return;
          }

          // Group carriers by state
          const carriersByState = {};
          user.statesAndCarriers.forEach(c => {
            if (!carriersByState[c.state]) {
              carriersByState[c.state] = [];
            }
            carriersByState[c.state].push(c);
          });

          // Sort states with FL first
          const sortedStates = Object.keys(carriersByState).sort((a, b) => {
            if (a === 'FL') return -1;
            if (b === 'FL') return 1;
            return a.localeCompare(b);
          });

          // Build accordion HTML
          let accordionHTML = '<div class="accordion" id="carrierAccordion">';

          sortedStates.forEach((state, idx) => {
            const isExpanded = idx === 0;
            accordionHTML += `
              <div class="accordion-item">
                <h2 class="accordion-header" id="heading${idx}">
                  <button class="accordion-button ${!isExpanded ? 'collapsed' : ''}" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapse${idx}"
                    aria-expanded="${isExpanded}" aria-controls="collapse${idx}">
                    <strong>${state}</strong>
                  </button>
                </h2>
                <div id="collapse${idx}" class="accordion-collapse collapse ${isExpanded ? 'show' : ''}"
                  aria-labelledby="heading${idx}" data-bs-parent="#carrierAccordion">
                  <div class="accordion-body p-0">
                    <ul class="list-group list-group-flush">
            `;

            carriersByState[state].forEach(carrier => {
              const iconPath = companyIconMap[carrier.company];
              accordionHTML += `
                <li class="list-group-item">
                  <div class="d-flex align-items-center">
                    ${iconPath ? `<img src="${iconPath}" alt="icon" class="me-2" style="width:28px; height:28px; object-fit:contain;">` : ''}
                    <div class="me-3 fw-semibold">${carrier.company}</div>
                    <div class="flex-grow-1">
                      <div class="progress carrier-progress" style="height: 14px; cursor: pointer;"
                        data-status="${carrier.status}">
                        <div class="progress-bar bg-success carrier-bar"
                          role="progressbar"
                          style="width: 0%" aria-valuemin="0" aria-valuemax="100">
                          <span class="small ms-2 text-white carrier-bar-text"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              `;
            });

            accordionHTML += `
                    </ul>
                  </div>
                </div>
              </div>
            `;
          });

          accordionHTML += '</div>';
          container.innerHTML = accordionHTML;

          // Now apply progress bar logic
          const normalStatusOptions = [
            "Empty",
            "Request Received from Agent",
            "Pending Submission",
            "Submitted to Carrier",
            "Carrier In Review",
            "Carrier Sent Contract to Agent",
            "Ready to Sell"
          ];

          const specialStatusOptions = [
            "Rejected by Carrier",
            "Withdrawn by Agent",
            "Need Release",
            "Release",
            "Refering"
          ];

          const maxIndex = normalStatusOptions.length - 1;
          const percentageStep = 100 / maxIndex;

          // Function to animate progress bars
          function animateProgressBars(accordionElement) {
            const progressContainers = accordionElement.querySelectorAll(".carrier-progress");
            progressContainers.forEach(container => {
              const bar = container.querySelector(".carrier-bar");
              let status = container.dataset.status?.trim();
              let pct = 0;
              let colorClass = "bg-secondary";

              if (normalStatusOptions.includes(status)) {
                const index = normalStatusOptions.indexOf(status);
                pct = Math.round(index * percentageStep);
                colorClass = "bg-success";
              } else if (specialStatusOptions.includes(status)) {
                pct = 100;
                // Refering is green, all other special statuses are red
                colorClass = status === "Refering" ? "bg-success" : "bg-danger";
              }

              bar.className = `progress-bar carrier-bar ${colorClass}`;
              bar.style.transition = "width 0.3s ease-in-out";

              // Animate from 0 to target percentage
              setTimeout(() => {
                bar.style.width = pct + "%";
              }, 50);

              // Don't show percentage text
              const textSpan = bar.querySelector(".carrier-bar-text");
              if (textSpan) textSpan.textContent = "";

              // Add tooltip to the progress container (entire bar area)
              container.setAttribute("data-bs-toggle", "tooltip");
              container.setAttribute("data-bs-placement", "top");
              container.setAttribute("title", status);
            });

            // Initialize tooltips for this accordion
            setTimeout(() => {
              const tooltips = accordionElement.querySelectorAll('[data-bs-toggle="tooltip"]');
              tooltips.forEach(el => {
                const tooltip = new bootstrap.Tooltip(el, {
                  trigger: 'hover',
                  delay: { show: 200, hide: 0 }
                });

                // Auto-hide tooltip after 5 seconds
                let hideTimeout;
                el.addEventListener('mouseenter', () => {
                  clearTimeout(hideTimeout);
                  hideTimeout = setTimeout(() => {
                    tooltip.hide();
                  }, 5000);
                });

                el.addEventListener('mouseleave', () => {
                  clearTimeout(hideTimeout);
                  tooltip.hide();
                });
              });
            }, 100);
          }

          // Animate bars in the initially expanded accordion
          const firstAccordion = document.querySelector('#collapse0');
          if (firstAccordion) {
            animateProgressBars(firstAccordion);
          }

          // Add event listeners to animate bars when accordion is shown
          document.querySelectorAll('.accordion-collapse').forEach(collapse => {
            collapse.addEventListener('shown.bs.collapse', function () {
              animateProgressBars(this);
            });
          });
        });
      </script>
      <!--/ Carrier Status Bars -->

      <!-- News -->
      <script>
        async function searchNews(query = "") {
          const res = await fetch(`/search-news?q=${encodeURIComponent(query)}`);
          const data = await res.json();

          const listEl = document.getElementById("news-list");
          listEl.innerHTML = "";

          document.querySelectorAll('[id^="newsModal-dyn-"]').forEach(el => el.remove());

          if (!data.results || data.results.length === 0) {
            listEl.innerHTML =
              '<div class="p-4 text-center text-muted">No news found.</div>';
            return;
          }

          data.results.forEach((news, index) => {
            const li = document.createElement("li");
            li.classList.add("list-group-item");
            li.innerHTML = `
        <a href="#" class="fw-bold text-decoration-none" data-bs-toggle="modal"
          data-bs-target="#newsModal-dyn-${index}">
          ${news.title}
        </a>
      `;
            const modal = document.createElement("div");
            modal.classList.add("modal", "fade");
            modal.id = `newsModal-dyn-${index}`;
            modal.tabIndex = -1;
            modal.setAttribute("aria-hidden", "true");
            modal.innerHTML = `
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">${news.title}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p>${news.content}</p>
            </div>
            <div class="modal-footer d-flex justify-content-between">
              <small class="text-secondary">By ${news.sender}</small>
              <small class="text-secondary">${new Date(news.sendedAt).toLocaleDateString()}</small>
            </div>
          </div>
        </div>
      `;
            listEl.appendChild(li);
            document.body.appendChild(modal);
          });
        }

        document.addEventListener("DOMContentLoaded", () => {
          searchNews();
        });
      </script>
      <!--/ News -->

      <script id="welcome" type="application/json">
        <%- JSON.stringify(showWelcome) %>
      </script>

      <script>
        const user = JSON.parse(document.getElementById('user-data').textContent);
        const showWelcome = JSON.parse(document.getElementById('welcome').textContent);

        document.addEventListener("DOMContentLoaded", () => {
          if (showWelcome) {
            showToast('Welcome!', `${user.display_name}, you have successfully logged in.`);
          }
        });
      </script>
</body>

</html>