      "WI": "Wisconsin",
      "WY": "Wyoming"
    };

    function replaceStateAbbreviationsInGraph() {
      document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(el => {
        const text = el.textContent.trim();
        if (stateAbbreviationMap[text]) {
          el.textContent = stateAbbreviationMap[text];
        }
      });

      document.querySelectorAll('#groupByStatesList li .card-title, #groupByStatesList li h6, #groupByStatesList li small').forEach(el => {
        const words = el.textContent.split(' ');
        const replacedWords = words.map(word => stateAbbreviationMap[word] || word);
        el.textContent = replacedWords.join(' ');
      });

      document.querySelectorAll('td, span, div').forEach(el => {
        const text = el.textContent.trim();
        if (stateAbbreviationMap[text]) {
          el.textContent = stateAbbreviationMap[text];
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        replaceStateAbbreviationsInGraph();
      }, 500);
    });
  </script>
