    <script id="users-data" type="application/json">
      <%- JSON.stringify(releasedUsers) %>
    </script>

    <script>
        function renderTable(users, page, pageSize, searchTerm = "") {
            const table = document.querySelector(".datatables-basic");
            const tbody = table.querySelector("tbody");
            tbody.innerHTML = "";

            const filtered = users.filter(u =>
                (u.display_name || "").toLowerCase().includes(searchTerm.toLowerCase()) ||
                (u.email || "").toLowerCase().includes(searchTerm.toLowerCase())
            );

            const start = (page - 1) * pageSize;
            const end = start + pageSize;
            const pageUsers = filtered.slice(start, end);

            if (pageUsers.length === 0) {
                const tr = document.createElement("tr");
                tr.innerHTML = `<td valign="top" colspan="7" class="dataTables_empty">No users found.</td>`;
                tbody.appendChild(tr);
            } else {
                pageUsers.forEach((user, idx) => {
                    const tr = document.createElement("tr");

                    const tdIndex = document.createElement("td");
                    tdIndex.textContent = start + idx + 1;
                    tr.appendChild(tdIndex);

                    const tdAvatar = document.createElement("td");
                    tdAvatar.className = "dtr-hidden";
                    tdAvatar.innerHTML = user.photoPath
                        ? `<img src="${url}/${user.photoPath}" alt="avatar" style="width:32px;height:32px;border-radius:50%;">`
                        : `<span class="avatar-initial rounded-circle bg-label-primary">${user.display_name?.[0] || user.email[0]}</span>`;
                    tr.appendChild(tdAvatar);


                    const tdName = document.createElement("td");
                    tdName.textContent = user.display_name || "";
                    tr.appendChild(tdName);

                    const tdEmail = document.createElement("td");
                    tdEmail.innerHTML = user.email ? `<a href="mailto:${user.email}">${user.email}</a>` : "";
                    tr.appendChild(tdEmail);

                    const tdAgency = document.createElement("td");
                    tdAgency.textContent = user.agency;
                    tr.appendChild(tdAgency);

                    const tdCreated = document.createElement("td");
                    tdCreated.textContent = user.createdAt
                        ? new Date(user.createdAt).toLocaleDateString()
                        : "";
                    tr.appendChild(tdCreated);

                    const tdAction = document.createElement("td");
                    tdAction.innerHTML = `
    <a href="/users/profile/${user.user_id}" class="ti ti-search me-2" title="View Profile"></a>
    <a href="javascript:void(0);" class="ti ti-check me-2" title="Recover Agent"
        onclick="if(confirm('Are you sure you want to recover this agent?')) { fetch('/users/agents/recover/${user.user_id}', { method: 'POST' }).then(() => location.reload()); }">
    <a href="javascript:void(0);" class="ti ti-trash text-danger" title="Delete User"
       onclick="if(confirm('Are you sure you want to delete this agent?')) { fetch('/users/agents/${user.user_id}', { method: 'DELETE' }).then(() => location.reload()); }">
`;
                    tr.appendChild(tdAction);

                    tbody.appendChild(tr);
                });
            }
            const info = document.getElementById("DataTables_Table_0_info");
            const showingStart = filtered.length === 0 ? 0 : start + 1;
            const showingEnd = Math.min(end, filtered.length);
            info.textContent = `Showing ${showingStart} to ${showingEnd} of ${filtered.length} entries`;

            renderPagination(filtered.length, page, pageSize);
        }

        function renderPagination(total, page, pageSize) {
            const ul = document.querySelector("#DataTables_Table_0_paginate ul.pagination");
            ul.innerHTML = "";

            const totalPages = Math.ceil(total / pageSize);

            // Prev
            const prevLi = document.createElement("li");
            prevLi.className = `paginate_button page-item previous${page === 1 ? " disabled" : ""}`;
            prevLi.innerHTML = `<a class="page-link" href="#" tabindex="-1"><i class="ti ti-chevron-left ti-sm"></i></a>`;
            prevLi.onclick = (e) => {
                e.preventDefault();
                if (page > 1) setPage(page - 1);
            };
            ul.appendChild(prevLi);

            // Números de página (máximo 5)
            let startPage = Math.max(1, page - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

            for (let i = startPage; i <= endPage; i++) {
                const li = document.createElement("li");
                li.className = `paginate_button page-item${i === page ? " active" : ""}`;
                li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                li.onclick = (e) => {
                    e.preventDefault();
                    setPage(i);
                };
                ul.appendChild(li);
            }

            // Next
            const nextLi = document.createElement("li");
            nextLi.className = `paginate_button page-item next${page === totalPages || totalPages === 0 ? " disabled" : ""}`;
            nextLi.innerHTML = `<a class="page-link" href="#"><i class="ti ti-chevron-right ti-sm"></i></a>`;
            nextLi.onclick = (e) => {
                e.preventDefault();
                if (page < totalPages) setPage(page + 1);
            };
            ul.appendChild(nextLi);
        }

        // Estado global de paginado y búsqueda
        let users = [];
        let currentPage = 1;
        let pageSize = 7;
        let searchTerm = "";

        function setPage(page) {
            currentPage = page;
            renderTable(users, currentPage, pageSize, searchTerm);
        }

        function setPageSize(size) {
            pageSize = size;
            currentPage = 1;
            renderTable(users, currentPage, pageSize, searchTerm);
        }

        function setSearch(term) {
            searchTerm = term;
            currentPage = 1;
            renderTable(users, currentPage, pageSize, searchTerm);
        }

        document.addEventListener("DOMContentLoaded", () => {
            users = JSON.parse(document.getElementById("users-data").textContent);

            // Inicializar tabla
            renderTable(users, currentPage, pageSize);

            // Selector de cantidad
            document.querySelector('select[name="DataTables_Table_0_length"]').addEventListener("change", function () {
                setPageSize(Number(this.value));
            });

            // Barra de búsqueda
            document.querySelector('#DataTables_Table_0_filter input[type="search"]').addEventListener("input", function () {
                setSearch(this.value);
            });
        });
    </script>

    <script>
        function showToast(headerText, bodyText) {
            const toast = document.querySelector('.toast-ex1');
            toast.querySelector('.toast-header small').textContent = headerText;
            toast.querySelector('.toast-body').textContent = bodyText;
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }
    </script>
