    <script id="filters-data" type="application/json">
      <%- JSON.stringify(filters) %>
    </script>

    <script>
        $(document).ready(function () {
            const data = JSON.parse(document.getElementById("agents-data").textContent);
            const filtersData = JSON.parse(document.getElementById("filters-data").textContent);

            const filterTypeSelect = document.getElementById('filter-type');
            const filterValueSelect = document.getElementById('filter-value');
            const resultsCount = document.getElementById('results-count');
            const resultsTable = document.getElementById('results-table');

            let dataTable;

            function populateFilterValues(type) {
                filterValueSelect.innerHTML = '<option value="">Select Value</option>';
                if (!type || !filtersData[type + 's']) return;

                filtersData[type + 's'].forEach(value => {
                    const opt = document.createElement('option');
                    opt.value = value;
                    opt.textContent = value;
                    filterValueSelect.appendChild(opt);
                });

                filterValueSelect.disabled = false;
            }

            function capitalize(str) {
                return str.charAt(0).toUpperCase() + str.slice(1);
            }

            function uniqueByProperty(arr, prop) {
                const seen = new Set();
                return arr.filter(item => {
                    if (seen.has(item[prop])) return false;
                    seen.add(item[prop]);
                    return true;
                });
            }

            function applyFilterAndRender() {
                const filterType = filterTypeSelect.value;

                const filterValue = filterValueSelect.value === "" ? null : filterValueSelect.value;

                const isFilterApplied = filterType && filterValue;

                let filtered = data;

                if (isFilterApplied) {
                    filtered = data.filter(item => item[filterType] === filterValue);
                    filtered = uniqueByProperty(filtered, 'user_id');
                } else {
                    filtered = uniqueByProperty(data, 'user_id');
                }

                resultsCount.textContent = `Results found: ${filtered.length}`;

                const columns = [
                    {
                        title: "#",
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    { title: "Name", data: "name" }
                ];

                if (isFilterApplied) {
                    columns.push({
                        title: capitalize(filterType),
                        data: filterType
                    });
                }

                if ($.fn.DataTable.isDataTable('#results-table')) {
                    dataTable.destroy();
                    $('#results-table').empty().html('<thead><tr></tr></thead><tbody></tbody>');
                }

                dataTable = $('#results-table').DataTable({
                    data: filtered,
                    columns: columns,
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [7, 10, 25, 50, 75, 100],
                    autoWidth: false
                });
            }

            filterTypeSelect.addEventListener('change', () => {
                const type = filterTypeSelect.value;
                if (type) {
                    populateFilterValues(type);
                } else {
                    filterValueSelect.innerHTML = '<option value="">Select Value</option>';
                    filterValueSelect.disabled = true;
                }
                applyFilterAndRender();
            });

            filterValueSelect.addEventListener('change', applyFilterAndRender);

            // Initial render
            applyFilterAndRender();
        });
    </script>
