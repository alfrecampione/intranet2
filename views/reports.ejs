    <script id="filters-data" type="application/json">
      <%- JSON.stringify(filters) %>
    </script>

    <script>
        let currentFilterCtx = {};

        $(document).ready(function () {
            const filtersData = JSON.parse(document.getElementById("filters-data").textContent);

            const filterTypeSelect = document.getElementById('filter-type');
            const filterValueSelect = document.getElementById('filter-value');
            const filterSubValue = document.getElementById('filter-sub-value');
            const applyFilterBtn = document.getElementById('apply-filter-btn');
            const resultsCount = document.getElementById('results-count');
            const resultsTable = document.getElementById('results-table');

            let dataTable;
            const pageLength = 25;

            function buildFilterContext(total, summary) {
                const filterType = filterTypeSelect.value;
                const filterTypeLabel = filterTypeSelect.options[filterTypeSelect.selectedIndex]?.text || '';

                let filterValueLabel = '';
                let filterSubValueLabel = '';
                let selectedLocationLabels = [];

                const isMultiSelect = filterType === 'location' || filterType === 'agency';

                if (isMultiSelect) {
                    const rawSelection = $(filterValueSelect).val() || [];
                    const selectedIds = Array.isArray(rawSelection) ? rawSelection.filter(Boolean) : rawSelection ? [rawSelection] : [];
                    selectedLocationLabels = selectedIds.map(id => {
                        const opt = Array.from(filterValueSelect.options).find(o => o.value === String(id));
                        return opt ? opt.text : id;
                    });
                } else {
                    const fvOpt = filterValueSelect.options[filterValueSelect.selectedIndex];
                    filterValueLabel = (fvOpt && fvOpt.value) ? fvOpt.text : '';
                    const fsvOpt = filterSubValue.options[filterSubValue.selectedIndex];
                    filterSubValueLabel = (fsvOpt && fsvOpt.value) ? fsvOpt.text : '';
                }

                let locationSummaryTotals = null;
                if (filterType === 'location' && selectedLocationLabels.length === 0 && summary) {
                    locationSummaryTotals = {
                        locations: summary.length,
                        agencies: summary.reduce((s, r) => s + (parseInt(r.agencies) || 0), 0),
                        agents: summary.reduce((s, r) => s + (parseInt(r.agents) || 0), 0)
                    };
                }

                return { filterType, filterTypeLabel, filterValueLabel, filterSubValueLabel, selectedLocationLabels, total, locationSummaryTotals };
            }

            function renderSummary(ctx) {
                const filterParts = [];
                if (ctx.filterTypeLabel) filterParts.push(`<span class="badge bg-label-primary">${ctx.filterTypeLabel}</span>`);
                if (ctx.filterValueLabel) filterParts.push(`<span class="badge bg-label-info">${ctx.filterValueLabel}</span>`);
                if (ctx.filterSubValueLabel) filterParts.push(`<span class="badge bg-label-info">${ctx.filterSubValueLabel}</span>`);
                ctx.selectedLocationLabels.forEach(l => filterParts.push(`<span class="badge bg-label-info">${l}</span>`));

                const filtersSection = filterParts.length > 0
                    ? `<div class="mb-1 d-flex gap-1 flex-wrap align-items-center">
                           <small class="text-muted fw-semibold me-1">Filters applied:</small>
                           ${filterParts.join('')}
                       </div>`
                    : '';

                let totalSection;
                if (ctx.locationSummaryTotals) {
                    const { locations, agencies, agents } = ctx.locationSummaryTotals;
                    totalSection = `<div class="d-flex gap-3 flex-wrap mt-1">
                        <span class="fw-bold"><i class="ti ti-map-pin me-1 text-secondary"></i>Locations: <span class="text-primary">${locations}</span></span>
                        <span class="fw-bold"><i class="ti ti-building me-1 text-secondary"></i>Agencies: <span class="text-primary">${agencies}</span></span>
                        <span class="fw-bold"><i class="ti ti-users me-1 text-secondary"></i>Agents: <span class="text-primary">${agents}</span></span>
                    </div>`;
                } else {
                    totalSection = `<div class="mt-1"><span class="fw-bold fs-6"><i class="ti ti-users me-1 text-secondary"></i>Total agents: <span class="text-primary">${ctx.total}</span></span></div>`;
                }

                return `<div class="border rounded p-2 bg-light">${filtersSection}${totalSection}</div>`;
            }

            function formatPhone(val) {
                const digits = (val || '').replace(/\D/g, '').slice(0, 10);
                if (digits.length === 10) {
                    return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
                }
                return digits || val || '';
            }

            // Populate filterValue dropdown
            function populateFilterValues(type, dataKey) {
                filterValueSelect.innerHTML = '<option value="">Select Value</option>';
                if (!dataKey || !filtersData[dataKey]) return;

                filtersData[dataKey].forEach(value => {
                    const isObj = value && typeof value === 'object';
                    const opt = document.createElement('option');
                    opt.value = isObj ? (value.id ?? '') : value;
                    opt.textContent = isObj ? (value.name ?? value.id ?? '') : value;
                    filterValueSelect.appendChild(opt);
                });

                filterValueSelect.disabled = false;
            }

            // Populate filterSubValue (agency) based on selected franchise
            function populateAgenciesUnderFranchise(selectedFranchiseId) {
                filterSubValue.innerHTML = '<option value="">Select Agency</option>';

                if (!selectedFranchiseId || !filtersData?.franchiseAgencyCombination) {
                    filterSubValue.style.display = 'none';
                    return;
                }

                // Convert both sides to strings to ensure consistent comparison
                const franchiseData = filtersData.franchiseAgencyCombination.find(item => {
                    const fid = String(item.franchise?.id || '').trim();
                    const selected = String(selectedFranchiseId).trim();
                    return fid === selected;
                });

                if (franchiseData?.agencies?.length) {
                    franchiseData.agencies.forEach(({ agency }) => {
                        if (!agency?.id || !agency?.name) return; // skip incomplete entries
                        const opt = document.createElement('option');
                        opt.value = String(agency.id);
                        opt.textContent = agency.name;
                        filterSubValue.appendChild(opt);
                    });
                    filterSubValue.style.display = 'block';
                } else {
                    filterSubValue.style.display = 'none';
                }
            }

            // Fetch filtered data from server
            async function fetchFilteredData() {
                const filterType = filterTypeSelect.value;
                const params = new URLSearchParams();

                if (filterType) params.append("filterType", filterType);

                if (filterType === 'location' || filterType === 'agency') {
                    // Use select2 value to avoid mismatch with DOM selectedOptions
                    const rawSelection = $(filterValueSelect).val();
                    const selectedLocations = Array.isArray(rawSelection)
                        ? rawSelection.filter(Boolean)
                        : rawSelection ? [rawSelection] : [];
                    selectedLocations.forEach(loc => params.append("filterValue", loc));
                } else {
                    const filterValue = filterValueSelect.value;
                    const filterSubValueVal = filterSubValue.value;
                    if (filterValue) params.append("filterValue", filterValue);
                    if (filterSubValueVal) params.append("filterSubValue", filterSubValueVal);
                }

                const response = await fetch(`/users/reports/filter?${params.toString()}`);
                const result = await response.json();
                return result;
            }

            async function applyFilterAndRender() {
                const { data, total, summary } = await fetchFilteredData();

                const filterType = filterTypeSelect.value;
                const rawSelection = $(filterValueSelect).val();
                const selectedLocations = Array.isArray(rawSelection)
                    ? rawSelection.filter(Boolean)
                    : rawSelection ? [rawSelection] : [];
                const filterSubValueVal = filterSubValue.value;

                const isLocationSummaryView = (filterType === 'location' && selectedLocations.length === 0);
                const isLocationListView = (filterType === 'location' && selectedLocations.length > 0);
                const isAgencyListView = (filterType === 'agency');

                currentFilterCtx = buildFilterContext(total, summary);
                resultsCount.innerHTML = renderSummary(currentFilterCtx);

                let columns;
                let tableData;

                if (isLocationSummaryView && summary) {
                    // --- Location Summary View ---
                    tableData = summary;
                    columns = [{
                        title: "Location (NAME)",
                        data: "location"
                    }, {
                        title: "Agencies (COUNT)",
                        data: "agencies"
                    }, {
                        title: "Agents (COUNT)",
                        data: "agents"
                    }];

                } else {
                    // --- Default Agent List View ---
                    tableData = data;
                    columns = [{
                        title: "#",
                        data: null,
                        render: (data, type, row, meta) => meta.row + 1
                    }, {
                        title: "Name",
                        data: "name",
                        render: (data, type, row) => {
                            const photoPath = row.photoPath || '';
                            let avatar = '';
                            if (photoPath) {
                                // Check if photoPath is an external URL (starts with http:// or https://)
                                const isExternalUrl = photoPath.startsWith('http');
                                const imgSrc = isExternalUrl ? photoPath : `/${photoPath}`;
                                avatar = `<img src="${imgSrc}" alt="" class="rounded-circle me-2" style="width: 2.5rem; height: 2.5rem; object-fit: cover;">`;
                            } else {
                                const name = row.name || row.email || '';
                                const names = name.trim().split(/\s+/);
                                const initials = names.length > 1 ? names[0][0] + names[names.length - 1][0] : (names[0][0] || '');
                                avatar = `<span class="avatar-initial rounded-circle bg-label-primary d-inline-flex align-items-center justify-content-center me-2" style="width: 2.5rem; height: 2.5rem;">${initials.toUpperCase()}</span>`;
                            }
                            return `<div class="d-flex align-items-center">${avatar}<a href="/users/profile/${row.user_id}" target="_blank">${data}</a></div>`;
                        }
                    }, {
                        title: "Email",
                        data: "email",
                        render: data => data ? `<a href="mailto:${data}">${data}</a>` : ''
                    }];

                    if (isLocationListView) {
                        columns.splice(2, 0, {
                            title: "Location",
                            data: "agencyName",
                            render: data => data || ''
                        });
                    }

                    if (isAgencyListView) {
                        columns.splice(2, 0, {
                            title: "Agency",
                            data: "agencyName",
                            render: data => data || ''
                        });
                    }

                    // Dynamic sub-filter columns: add when a filter type is selected but no specific value is chosen
                    const filterValue = filterValueSelect.value;
                    if (filterType === 'carrier' && !filterValue) {
                        columns.push({
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const carriers = [...new Set(data.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        });
                    }
                    if (filterType === 'state' && !filterValue) {
                        columns.push({
                            title: "State",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const states = [...new Set(data.map(sc => sc.state).filter(Boolean))];
                                return states.join(', ');
                            }
                        });
                    }
                    if (filterType === 'status' && !filterValue) {
                        columns.push({
                            title: "Status",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const statuses = [...new Set(data.map(sc => sc.status).filter(Boolean))];
                                return statuses.join(', ');
                            }
                        });
                    }
                    if (filterType === 'carrier & state' && !filterValue) {
                        columns.push({
                            title: "State",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const states = [...new Set(data.map(sc => sc.state).filter(Boolean))];
                                return states.join(', ');
                            }
                        }, {
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const carriers = [...new Set(data.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        });
                    }
                    if (filterType === 'carrier & state' && filterValue && !filterSubValueVal) {
                        const stateSelected = filterValue;
                        columns.push({
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const relevant = data.filter(sc => sc.state === stateSelected);
                                const carriers = [...new Set(relevant.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        });
                    }

                    if (filterType === 'status & carrier' && !filterValue) {
                        columns.push({
                            title: "Status",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const statuses = [...new Set(data.map(sc => sc.status).filter(Boolean))];
                                return statuses.join(', ');
                            }
                        }, {
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const carriers = [...new Set(data.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        });
                    }
                    if (filterType === 'status & carrier' && filterValue && !filterSubValueVal) {
                        const statusSelected = filterValue;
                        columns.push({
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const relevant = data.filter(sc => sc.status === statusSelected);
                                const carriers = [...new Set(relevant.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        }, {
                            title: "State",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const relevant = data.filter(sc => sc.status === statusSelected);
                                const states = [...new Set(relevant.map(sc => sc.state).filter(Boolean))];
                                return states.join(', ');
                            }
                        });
                    }
                    if (filterType === 'status & carrier' && filterValue && filterSubValueVal) {
                        const statusSelected = filterValue;
                        const carrierSelected = filterSubValueVal;
                        columns.push({
                            title: "Carrier",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const relevant = data.filter(sc => sc.status === statusSelected && (sc.company === carrierSelected || sc.carrier?.id === carrierSelected));
                                const carriers = [...new Set(relevant.map(sc => sc.carrier?.name || sc.company).filter(Boolean))];
                                return carriers.join(', ');
                            }
                        }, {
                            title: "State",
                            data: "statesAndCarriers",
                            render: (data) => {
                                if (!Array.isArray(data) || data.length === 0) return '';
                                const relevant = data.filter(sc => sc.status === statusSelected && (sc.company === carrierSelected || sc.carrier?.id === carrierSelected));
                                const states = [...new Set(relevant.map(sc => sc.state).filter(Boolean))];
                                return states.join(', ');
                            }
                        });
                    }

                    columns.push({
                        title: "Number",
                        data: "number",
                        render: data => {
                            const digits = (data || '').replace(/\D/g, '');
                            const formatted = formatPhone(digits);
                            return digits ? `<a href="tel:${digits}">${formatted}</a>` : '';
                        }
                    });
                }

                // Destroy the old table (if it exists) because columns are changing
                if ($.fn.DataTable.isDataTable('#results-table')) {
                    dataTable.clear().destroy();
                    $('#results-table').html('<thead></thead><tbody></tbody>');
                }

                // Initialize the new table. DataTables will build the header from the 'columns' array.
                dataTable = $('#results-table').DataTable({
                    data: tableData,
                    columns,
                    responsive: true,
                    pageLength: pageLength,
                    lengthMenu: [25, 50, 75, 100],
                    autoWidth: false
                });
            }

            function destroySelect2IfExists() {
                if ($(filterValueSelect).hasClass('select2-hidden-accessible')) {
                    $(filterValueSelect).select2('destroy');
                }
            }

            function initLocationSelect2() {
                destroySelect2IfExists();
                $(filterValueSelect).select2({
                    placeholder: 'Select Location',
                    width: 'style',
                    closeOnSelect: false
                });
            }

            function initAgencySelect2() {
                destroySelect2IfExists();
                $(filterValueSelect).select2({
                    placeholder: 'Select Agency',
                    width: 'style',
                    closeOnSelect: false
                });
            }

            function toggleApplyFilterBtn(type) {
                const needsApplyBtn = ['location', 'agency'].includes((type || '').toLowerCase());
                applyFilterBtn.classList.toggle('d-none', !needsApplyBtn);
                applyFilterBtn.toggleAttribute('hidden', !needsApplyBtn);
            }

            // Filter type change
            filterTypeSelect.addEventListener('change', () => {
                const type = filterTypeSelect.value;
                toggleApplyFilterBtn(type);

                // Reset multiselect when switching types
                filterValueSelect.multiple = false;
                filterValueSelect.size = 1;
                destroySelect2IfExists();

                if (type === 'carrier & state') {
                    filterValueSelect.innerHTML = '<option value="">Select State</option>';
                    filtersData['state'].forEach(state => {
                        const opt = document.createElement('option');
                        opt.value = state;
                        opt.textContent = state;
                        filterValueSelect.appendChild(opt);
                    });
                    filterValueSelect.disabled = false;

                    filterSubValue.innerHTML = '<option value="">Select Carrier</option>';
                    filtersData['carrier'].forEach(carrier => {
                        const isObj = carrier && typeof carrier === 'object';
                        const opt = document.createElement('option');
                        opt.value = isObj ? (carrier.id ?? '') : carrier;
                        opt.textContent = isObj ? (carrier.name ?? carrier.id ?? '') : carrier;
                        filterSubValue.appendChild(opt);
                    });
                    filterSubValue.style.display = 'block';

                } else if (type === 'status & carrier') {
                    filterValueSelect.innerHTML = '<option value="">Select Status</option>';
                    filtersData['status'].forEach(status => {
                        const opt = document.createElement('option');
                        opt.value = status;
                        opt.textContent = status;
                        filterValueSelect.appendChild(opt);
                    });
                    filterValueSelect.disabled = false;

                    filterSubValue.innerHTML = '<option value="">Select Carrier</option>';
                    filtersData['carrier'].forEach(carrier => {
                        const isObj = carrier && typeof carrier === 'object';
                        const opt = document.createElement('option');
                        opt.value = isObj ? (carrier.id ?? '') : carrier;
                        opt.textContent = isObj ? (carrier.name ?? carrier.id ?? '') : carrier;
                        filterSubValue.appendChild(opt);
                    });
                    filterSubValue.style.display = 'block';

                } else if (type === 'location') {
                    // Populate locations (franchises) as a multiselect
                    filterValueSelect.innerHTML = '';
                    filterValueSelect.multiple = true;
                    filterValueSelect.size = 6;
                    if (filtersData['franchise']) {
                        filtersData['franchise'].forEach(franchise => {
                            const opt = document.createElement('option');
                            opt.value = franchise.id;
                            opt.textContent = franchise.name;
                            filterValueSelect.appendChild(opt);
                        });
                    }
                    filterValueSelect.disabled = false;
                    filterValueSelect.selectedIndex = -1;
                    initLocationSelect2();

                    filterSubValue.style.display = 'none';

                } else if (type === 'agency') {
                    // Populate actual agencies as a multiselect
                    filterValueSelect.innerHTML = '';
                    filterValueSelect.multiple = true;
                    filterValueSelect.size = 6;
                    if (filtersData['agency']) {
                        filtersData['agency'].forEach(agency => {
                            const opt = document.createElement('option');
                            opt.value = agency.id;
                            opt.textContent = agency.name;
                            filterValueSelect.appendChild(opt);
                        });
                    }
                    filterValueSelect.disabled = false;
                    filterValueSelect.selectedIndex = -1;
                    initAgencySelect2();

                    filterSubValue.style.display = 'none';

                } else if (type) {
                    populateFilterValues(type, type);
                    filterSubValue.style.display = 'none';
                    destroySelect2IfExists();
                } else {
                    filterValueSelect.innerHTML = '<option value="">Select Value</option>';
                    filterValueSelect.disabled = true;
                    filterSubValue.style.display = 'none';
                    destroySelect2IfExists();
                }

                // Always apply when filter type changes (even for agency, which will show summary unless locations are picked)
                applyFilterAndRender();
            });

            function isSelect2Active() {
                return $(filterValueSelect).hasClass('select2-hidden-accessible');
            }

            filterValueSelect.addEventListener('change', () => {
                const isMultiSelectMode = filterTypeSelect.value === 'location' || filterTypeSelect.value === 'agency';
                if (isMultiSelectMode && isSelect2Active()) return;
                applyFilterAndRender();
            });

            filterSubValue.addEventListener('change', () => {
                const isMultiSelectMode = filterTypeSelect.value === 'location' || filterTypeSelect.value === 'agency';
                if (isMultiSelectMode && isSelect2Active()) return;
                applyFilterAndRender();
            });

            applyFilterBtn.addEventListener('click', applyFilterAndRender);

            // Initial render
            toggleApplyFilterBtn(filterTypeSelect.value);
            applyFilterAndRender();
        });
    </script>

    <script>
        document.getElementById('export-button').addEventListener('click', () => {
            const table = document.getElementById('results-table');

            // Get headers
            const headers = Array.from(table.querySelectorAll('thead th')).map(th =>
                th.textContent.trim()
            );

            // Get data rows - extract only text content, excluding images
            const rows = Array.from(table.querySelectorAll('tbody tr')).map(tr => {
                return Array.from(tr.querySelectorAll('td')).map(td => {
                    // If the cell contains a link, extract just the text
                    const link = td.querySelector('a');
                    if (link) {
                        return link.textContent.trim();
                    }
                    // Otherwise return the text content
                    return td.textContent.trim();
                });
            });

            // Build summary metadata rows for export
            const summaryRows = [];
            const ctx = currentFilterCtx || {};
            if (ctx.filterTypeLabel) {
                summaryRows.push(['Report Summary', '']);
                summaryRows.push(['Filter Type', ctx.filterTypeLabel]);
                if (ctx.filterValueLabel) summaryRows.push(['Filter Value', ctx.filterValueLabel]);
                if (ctx.filterSubValueLabel) summaryRows.push(['Sub-filter Value', ctx.filterSubValueLabel]);
                if (ctx.selectedLocationLabels?.length > 0) {
                    summaryRows.push(['Selected', ctx.selectedLocationLabels.join('; ')]);
                }
                if (ctx.locationSummaryTotals) {
                    summaryRows.push(['Total Locations', ctx.locationSummaryTotals.locations]);
                    summaryRows.push(['Total Agencies', ctx.locationSummaryTotals.agencies]);
                    summaryRows.push(['Total Agents', ctx.locationSummaryTotals.agents]);
                } else {
                    summaryRows.push(['Total Agents', ctx.total]);
                }
                summaryRows.push(['', '']);
            }

            // Send both headers and rows
            fetch('/users/reports/export', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ headers, rows, summaryRows })
            })
                .then(res => res.blob())
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'report.csv';
                    a.click();
                    URL.revokeObjectURL(url);
                })
                .catch(err => console.error('Export failed:', err));
        });
    </script>
</body>

</html>