    <script>
        function showToast(message, type = "success") {
            const toast = document.getElementById("toast");
            toast.textContent = message;
            toast.style.backgroundColor = type === "success" ? "#28a745" : "#dc3545"; // verde o rojo
            toast.style.color = "#fff";
            toast.style.display = "block";
            toast.style.opacity = "1";
            setTimeout(() => {
                toast.style.transition = "opacity 0.5s";
                toast.style.opacity = "0";
                setTimeout(() => {
                    toast.style.display = "none";
                    toast.style.transition = "";
                }, 500);
            }, 3000); // 3 segundos visible
        }

        document.addEventListener("DOMContentLoaded", () => {
            const users = JSON.parse(
                document.getElementById("users-data").textContent,
            );

            console.log(users);

            const table = document.querySelector(".datatables-basic");
            const tbody = table.querySelector("tbody");
            tbody.innerHTML = "";

            users.forEach((user) => {
                const tr = document.createElement("tr");

                const tdAvatar = document.createElement("td");
                tdAvatar.innerHTML = user.PhotoPath
                    ? `<img src="${url}/${user.PhotoPath}" alt="avatar" style="width:32px;height:32px;border-radius:50%;">`
                    : `<span class="avatar-initial rounded-circle bg-label-primary">${user.LegalName?.[0] || user.email[0]}</span>`;
                tr.appendChild(tdAvatar);

                const tdName = document.createElement("td");
                tdName.textContent = user.LegalName || "";
                tr.appendChild(tdName);

                const tdEmail = document.createElement("td");
                tdEmail.textContent = user.email;
                tr.appendChild(tdEmail);

                const tdCreated = document.createElement("td");
                tdCreated.textContent = user.createdAt
                    ? new Date(user.createdAt).toLocaleDateString()
                    : "";
                tr.appendChild(tdCreated);

                const tdAction = document.createElement("td");
                tdAction.innerHTML = `<a href="/users/registration/${user.user_id}" class="btn btn-sm btn-primary">View</a>`;
                tr.appendChild(tdAction);

                tbody.appendChild(tr);
            });

            // Email form submit
            document
                .getElementById("form-send-email")
                .addEventListener("submit", async function (e) {
                    e.preventDefault();
                    const emailInput = document.getElementById("email");
                    const email = emailInput.value.trim();

                    if (!email) {
                        showToast("Please enter an email address.", "error");
                        return;
                    }

                    const subject = "Create your account on GoldenTrust Insurance";

                    const body = {
                        name: email,
                        intro: "Welcome! Please follow the instructions below.",
                        action: {
                            instructions: "To create your account, please click here:",
                            button: {
                                color: "#27388B",
                                text: "Create your account",
                                link: `${url}/signUp`
                            }
                        },
                        outro: "If you have questions, you can reply to this email."
                    };

                    const data = {
                        email,
                        subject,
                        body
                    }

                    const overlay = document.getElementById("email-overlay");
                    overlay.style.display = "flex";

                    try {
                        const response = await fetch(`${url}/sendEmail`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(data),
                        });

                        const responseData = await response.json();

                        console.log(responseData);

                        if (response.ok) {
                            showToast("Email sent successfully!", "success");
                            emailInput.value = "";
                            const offcanvas = document.getElementById("add-new-record");
                            const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvas);
                            if (bsOffcanvas) bsOffcanvas.hide();
                        } else {
                            showToast(responseData.message || "Error sending email.", "error");
                        }
                    } catch (err) {
                        showToast("Error sending email.", "error");
                    } finally {
                        overlay.style.display = "none";
                    }
                });
        });
    </script>
</body>

</html>