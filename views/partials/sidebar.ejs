<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo">
        <a href="/users/dashboard" class="app-brand-link">
            <span class="app-brand-text">
                <img src="/img/branding/gti_logo1.png" alt="" id="menuLogo" />
            </span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="ti menu-toggle-icon d-none d-xl-block ti-sm align-middle"></i>
            <i class="ti ti-x d-block d-xl-none ti-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        <% if (user && (user.registrationCompleted || user.active) ) { %>
            <!-- Dashboard -->
            <li class="menu-item <%= activePage === 'dashboard' ? 'active' : '' %>">
                <a href="/users/dashboard" class="menu-link">
                    <i class="menu-icon tf-icons ti ti-home"></i>
                    <div data-i18n="Dashboard">Dashboard</div>
                </a>
            </li>

            <% if (user && !user.isAgent) { %>
                <!-- Agents -->
                <li class="menu-item <%= activePage === 'agents' ? 'active' : '' %>">
                    <a href="/users/agents" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-id-badge"></i>
                        <div data-i18n="Agents">Agents</div>
                    </a>
                </li>

                <li class="menu-item <%= activePage === 'releasedAgents' ? 'active' : '' %>">
                    <a href="/users/released-agents" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-id-badge"></i>
                        <div data-i18n="Released Agents">Released Agents</div>
                    </a>
                </li>

                <!-- Lead Center -->
                <li class="menu-item <%= activePage === 'lead-center' ? 'active' : '' %>">
                    <a href="/users/lead-center" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-users-group"></i>
                        <div data-i18n="Lead Center">Lead Center</div>
                    </a>
                </li>
                <!-- Reports -->
                <li class="menu-item <%= activePage === 'reports' ? 'active' : '' %>">
                    <a href="/users/reports" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-chart-bar"></i>
                        <div data-i18n="Reports">Reports</div>
                    </a>
                </li>

                <!-- Admin header -->
                <li class="menu-header small text-uppercase">
                    <span class="menu-header-text" data-i18n="ADMIN">ADMIN</span>
                </li>

                <!-- Config -->
                <li class="menu-item <%= activePage === 'config' ? 'active' : '' %>">
                    <a href="/users/config" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-settings"></i>
                        <div data-i18n="Config">Config</div>
                    </a>
                </li>
                <% } else if(user && user.personalInfo && user.personalInfo.contactType.toLowerCase()==='business' ) {
                    %>
                    <!-- MyAgents -->
                    <li class="menu-item <%= activePage === 'agents' ? 'active' : '' %>">
                        <a href="/users/my-agents" class="menu-link">
                            <i class="menu-icon tf-icons ti ti-id-badge"></i>
                            <div data-i18n="My Agents">My Agents</div>
                        </a>
                    </li>
                    <!-- Reports -->
                    <li class="menu-item <%= activePage === 'reports' ? 'active' : '' %>">
                        <a href="/users/reports" class="menu-link">
                            <i class="menu-icon tf-icons ti ti-chart-bar"></i>
                            <div data-i18n="Reports">Reports</div>
                        </a>
                    </li>
                    <% } %>
                        <% } %>
    </ul>
</aside>