                </a>
                <ul class="dropdown-menu dropdown-menu-end dropdown-styles">
                    <li>
                        <a class="dropdown-item" href="javascript:void(0);" data-theme="light">
                            <span class="align-middle"><i class="ti ti-sun me-2"></i>Light</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="javascript:void(0);" data-theme="dark">
                            <span class="align-middle"><i class="ti ti-moon me-2"></i>Dark</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="javascript:void(0);" data-theme="system">
                            <span class="align-middle"><i class="ti ti-device-desktop me-2"></i>System</span>
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Notification -->
            <li class="nav-item dropdown me-3 me-xl-1">
                <a class="nav-link position-relative" href="#" id="navbarDropdown" role="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-bell ti-md"></i>
                    <!-- Overlapping bubble badge -->
                    <span id="notification-badge"
                        class="position-absolute top-100 start-50 translate-middle badge rounded-circle bg-danger d-none"
                        style="font-size: 0.65rem; min-width: 16px; height: 16px; padding: 0; line-height: 16px; margin-top: -6px; margin-left: 8px;">
                        0
                    </span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end p-0 shadow" aria-labelledby="navbarDropdown"
                    style="width: 320px;">
                    <li class="border-bottom">
                        <div class="d-flex align-items-center justify-content-between py-2 px-3">
                            <h6 class="mb-0">Notifications</h6>
                            <a href="#" id="mark-all-read" class="text-body" data-bs-toggle="tooltip"
                                data-bs-placement="top" title="Mark all as read">
                                <i class="ti ti-mail-opened fs-5"></i>
                            </a>
                        </div>
                    </li>
                    <li id="notification-list" class="list-group list-group-flush"
                        style="max-height: 300px; overflow-y: auto;">
                        <!-- Notifications will appear here -->
                    </li>
                    <li class="border-top">
                        <a href="/users/all-notifications" class="dropdown-item text-center text-primary py-2">
                            View all notifications
                        </a>
                    </li>
                </ul>
            </li>

            <script>
                document.addEventListener("DOMContentLoaded", async () => {
                    const notificationBadge = document.getElementById("notification-badge");
                    const notificationList = document.getElementById("notification-list");
                    const markAllReadBtn = document.getElementById("mark-all-read");

                    async function fetchNotifications() {
                        try {
                            const res = await fetch("/users/notifications");
                            const data = await res.json();

                            notificationList.innerHTML = "";

                            if (!data.notifications.length) {
                                const li = document.createElement("li");
                                li.className = "list-group-item text-center text-muted small mb-0";
                                li.textContent = "No notifications";
                                notificationList.appendChild(li);
                            } else {
                                data.notifications.forEach(notification => {
                                    const li = document.createElement("li");
                                    li.className = `list-group-item d-flex align-items-start notification-item ${notification.isRead ? 'bg-light' : ''}`;
                                    li.style.cursor = "pointer";
                                    li.dataset.id = notification.id; // store notification id

                                    li.innerHTML = `
                                        <div class="flex-shrink-0 me-2">
                                          <i class="ti ti-bell text-${notification.isRead ? 'secondary' : 'primary'} fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                          <div class="d-flex justify-content-between">
                                            <p class="mb-1 small ${notification.isRead ? 'text-muted' : ''}">${notification.message}</p>
                                            <small class="text-muted">${new Date(notification.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</small>
                                          </div>
                                        </div>
                                    `;

                                    // Add click listener to mark as read
                                    li.addEventListener("click", async () => {
                                        try {
                                            await fetch(`/users/notifications/${notification.id}`, { method: "POST" });
                                            li.classList.add("bg-light");
                                            li.querySelector("p").classList.add("text-muted");
                                            li.querySelector("i").classList.replace("text-primary", "text-secondary");
                                            fetchNotifications();
                                        } catch (err) {
                                            console.error("Failed to mark notification as read:", err);
                                        }
                                    });

                                    notificationList.appendChild(li);
                                });
                            }

                            // update badge
                            if (data.unreadCount && data.unreadCount > 0) {
                                notificationBadge.textContent = data.unreadCount > 9 ? "9+" : data.unreadCount;
                                notificationBadge.classList.remove("d-none");
                            } else {
                                notificationBadge.classList.add("d-none");
                            }
                        } catch (err) {
                            console.error("Failed to fetch notifications:", err);
                        }
                    }

                    markAllReadBtn.addEventListener("click", async () => {
                        try {
                            await fetch("/users/notifications/mark-read", { method: "POST" });
                            notificationBadge.classList.add("d-none");
                            fetchNotifications();
                        } catch (err) {
                            console.error("Failed to mark notifications as read:", err);
                        }
                    });

                    fetchNotifications();
                    setInterval(fetchNotifications, 30000);
                });
            </script>
            <!--/ Notification -->

            <!-- User Dropdown -->
            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                    <div class="avatar avatar-online">
                        <% if (user && user.personalInfo && user.personalInfo.photoPath) { %>
                            <img src="/<%= user.personalInfo.photoPath %>" alt="User Avatar" class="rounded-circle" />
                            <% } else { %>
                                <span class="avatar-initial rounded-circle bg-label-primary">
                                    <%= user && user.display_name ? user.display_name[0] : (user && user.email ?
                                        user.email[0] : "" ) %>
                                </span>
                                <% } %>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item"
                            href="<%= user && user.createdAt ? '/users/profile/' + user.user_id : 'javascript:void(0)' %>">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar avatar-online">
                                        <% if (user && user.personalInfo && user.personalInfo.photoPath) { %>
                                            <img src="/<%= user.personalInfo.photoPath %>" alt="User Avatar"
                                                class="rounded-circle" />
                                            <% } else { %>
                                                <span class="avatar-initial rounded-circle bg-label-primary">
                                                    <%= user && user.display_name ? user.display_name[0] : (user &&
                                                        user.email ? user.email[0] : "" ) %>
                                                </span>
                                                <% } %>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="fw-medium d-block">
                                        <%= user ? user.display_name : "" %>
                                    </span>
                                    <% if (user && user.job_title) { %>
                                        <small class="text-muted">
                                            <%= user.job_title %>
                                        </small>
                                        <% } %>
                                </div>
                            </div>
                        </a>
                    </li>
                    <li>
                        <div class="dropdown-divider"></div>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/users/logout">
                            <i class="ti ti-logout me-2 ti-sm"></i>
                            <span class="align-middle">Log Out</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </div>

